---
// Runs before anything is painted: sends someone who chose Danish to the Danish home
// page when they come back to aarhus.dev/, sets the theme, marks the root `.js` (for
// what only works with scripts: the topics fold behind a switch on phones), sets up the
// clock, and holds the CSS that filters event items into the board's sections.
//
// The clock is the real time, unless the URL says `?now=2026-11-19T17:30` (Aarhus
// time, for checking the "now" and "today" states): that sticks for the rest of the
// tab's visit, and `?now=` alone goes back to the real time.
//
// Sections: `<section data-bucket="today">` shows only the items tagged "today" (see
// src/lib/when.ts), hides any `[data-group]` inside it with no such item, and hides
// itself when empty. `[data-empty="upcoming"]` shows only while its `[data-scope]` (the
// board, not the featured posters beside it) has no item tagged "upcoming".
const TAGS = ['past', 'upcoming', 'now', 'today', 'soon', 'tomorrow', 'week', 'nextweek', 'later']
const bucketCss = TAGS.map(
  (t) => `
[data-bucket="${t}"] [data-start]:not([data-when~="${t}"]),
[data-bucket="${t}"] [data-group]:not(:has([data-when~="${t}"])),
[data-bucket="${t}"]:not(:has([data-when~="${t}"])),
[data-scope]:has([data-when~="${t}"]) [data-empty="${t}"] { display: none !important; }`,
).join('')
---

<script is:inline>
  ;(function () {
    var read = function (store, k) {
      try {
        return window[store].getItem(k)
      } catch (e) {
        return null
      }
    }
    var write = function (store, k, v) {
      try {
        if (v === null) window[store].removeItem(k)
        else window[store].setItem(k, v)
      } catch (e) {}
    }
    var root = document.documentElement
    root.classList.add('js')

    // the language switch remembers the choice (RuntimeBody); only the bare home page
    // follows it, so a link to an English page still opens in English
    if (location.pathname === '/' && read('localStorage', 'lang') === 'da') {
      location.replace('/da/' + location.search + location.hash)
    }

    var theme = read('localStorage', 'theme')
    if (theme === 'dark' || theme === 'light') root.dataset.theme = theme

    // ?now=2026-11-19T17:30 pretends it's that moment, in Aarhus time whatever the
    // viewer's timezone, for the rest of this tab's visit; ?now= resets.
    var params = new URLSearchParams(location.search)
    if (params.has('now')) write('sessionStorage', 'aarhus-now', params.get('now') || null)
    var aarhusTime = function (s) {
      var asUtc = Date.parse(s + 'Z')
      if (isNaN(asUtc)) return NaN
      var name = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Copenhagen', timeZoneName: 'longOffset' })
        .formatToParts(new Date(asUtc))
        .find(function (p) {
          return p.type === 'timeZoneName'
        }).value
      var m = /([+-])(\d\d):(\d\d)/.exec(name)
      var offsetMinutes = m ? (m[1] === '-' ? -1 : 1) * (Number(m[2]) * 60 + Number(m[3])) : 0
      return asUtc - offsetMinutes * 60000
    }
    var fixed = aarhusTime(read('sessionStorage', 'aarhus-now') || '')
    window.aarhusNow = function () {
      return isNaN(fixed) ? Date.now() : fixed
    }
  })()
</script>
<style is:inline set:html={bucketCss}></style>
