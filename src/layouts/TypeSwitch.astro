---
// EXPERIMENT — remove once the amount of mono is chosen.
// Seven levels of mono, from all of it to the logo only. The reading face is IBM Plex
// Sans (7: the condensed display face). Keys 1–7, the switch in the corner, or ?type=N.
//
//   1  All mono (as it is)
//   2  Descriptions in sans: event descriptions and text pages
//   3  Reading in sans: also row titles, organizers, venues; dates, times, statuses,
//      labels, the topic row, the footer and the logo stay mono
//   4  Data in mono: dates, times, statuses, counts, column labels, the logo
//   5  Times and logo: only the rows' dates and times and the logo
//   6  Logo only
//   7  Condensed body: as 4, with the body in the condensed display face
const names = {
  1: 'All mono',
  2: 'Descriptions in sans',
  3: 'Reading in sans',
  4: 'Data in mono',
  5: 'Times + logo',
  6: 'Logo only',
  7: 'Condensed body',
}
const sans = "'IBM Plex Sans', system-ui, sans-serif"
const mono = 'font-family: var(--font-mono);'
// what stays mono, by group
const logo = '.mark'
const times = '.row .when'
const data = '.when, .status, .count, .cols, .row .topic'
const chrome = '.lines, .tagline, .foot, .cal-links, .ev-fix, .archive-back, .tt-end, .tools'
const reading = '.prose, .text-page-description'
const css = `
:root[data-type='2'] .site :is(${reading}) { font-family: ${sans}; }
:root:is([data-type='3'], [data-type='4'], [data-type='5'], [data-type='6']) .site { --font-body: ${sans}; }
:root[data-type='7'] .site { --font-body: var(--font-display); }
:root[data-type='3'] .site :is(${logo}, ${data}, ${chrome}) { ${mono} }
:root:is([data-type='4'], [data-type='7']) .site :is(${logo}, ${data}) { ${mono} }
:root[data-type='5'] .site :is(${logo}, ${times}) { ${mono} }
:root[data-type='6'] .site :is(${logo}) { ${mono} }
`
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,700;1,400&display=swap" />
<style is:inline set:html={css}></style>
<style is:inline>
  .type-switch {
    position: fixed;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.6rem;
    background: #17140f;
    color: #fbfbf8;
    font: 12px/1.3 ui-monospace, Menlo, monospace;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
  }
  .type-switch button {
    padding: 0.1rem 0.4rem;
    border: 1px solid currentColor;
    cursor: pointer;
    opacity: 0.55;
  }
  .type-switch button[aria-pressed='true'] {
    opacity: 1;
    background: #fbfbf8;
    color: #17140f;
  }
  .type-switch-name {
    min-width: 10rem;
    padding-left: 0.4rem;
  }
  @media (max-width: 40rem) {
    .type-switch-name {
      display: none;
    }
  }
</style>
<script is:inline define:vars={{ names }}>
  ;(function () {
    var read = function () {
      try {
        return localStorage.getItem('aarhus-type')
      } catch (e) {
        return null
      }
    }
    var write = function (v) {
      try {
        localStorage.setItem('aarhus-type', v)
      } catch (e) {}
    }
    var root = document.documentElement
    var fromUrl = new URLSearchParams(location.search).get('type')
    if (names[fromUrl]) write(fromUrl)
    var pick = names[read()] ? read() : '1'
    root.dataset.type = pick
    var bar = null
    var render = function () {
      if (!bar) return
      bar.querySelectorAll('button').forEach(function (b) {
        b.setAttribute('aria-pressed', b.dataset.n === pick ? 'true' : 'false')
      })
      bar.querySelector('.type-switch-name').textContent = names[pick]
    }
    var set = function (n) {
      pick = String(n)
      root.dataset.type = pick
      write(pick)
      render()
    }
    document.addEventListener('DOMContentLoaded', function () {
      bar = document.createElement('div')
      bar.className = 'type-switch'
      bar.setAttribute('role', 'group')
      bar.setAttribute('aria-label', 'How much mono')
      bar.innerHTML =
        '<span>Mono</span>' +
        Object.keys(names)
          .map(function (n) {
            return '<button type="button" data-n="' + n + '" title="' + names[n] + '">' + n + '</button>'
          })
          .join('') +
        '<span class="type-switch-name"></span>'
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('button')
        if (b) set(b.dataset.n)
      })
      document.body.appendChild(bar)
      render()
    })
    document.addEventListener('keydown', function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return
      if (e.target.closest && e.target.closest('input, textarea, select, [contenteditable]')) return
      var m = /^Digit([1-7])$/.exec(e.code)
      if (m) set(m[1])
    })
  })()
</script>
