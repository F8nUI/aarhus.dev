---
// EXPERIMENT — remove once a favicon is chosen (with public/favicons/).
// Shows the candidates at 32 px and at tab size (16 px) on a light and a dark tab, and
// swaps the real tab icon: keys 1–7, a click, or ?icon=N. The last choice is remembered.
const names = {
  1: 'a. on black',
  2: 'a▌ on black',
  3: 'aa on black',
  4: 'cursor, black circle',
  5: 'cursor, amber circle',
  6: 'a. on amber',
  7: 'a▌, no tile',
}
---

<style is:inline>
  .icon-switch {
    position: fixed;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 50;
    display: grid;
    grid-template-columns: repeat(7, auto);
    gap: 0.35rem;
    padding: 0.5rem;
    background: #17140f;
    color: #fbfbf8;
    font: 11px/1.3 ui-monospace, Menlo, monospace;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
  }
  .icon-switch button {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.3rem 0.25rem;
    border: 1px solid transparent;
    cursor: pointer;
    color: inherit;
  }
  .icon-switch button[aria-pressed='true'] {
    border-color: #f5a524;
  }
  .icon-switch .big {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    background: #fbfbf8;
  }
  .icon-switch .tabs {
    display: flex;
    gap: 3px;
  }
  .icon-switch .tab {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
  }
  .icon-switch .tab.light {
    background: #e9e7e2;
  }
  .icon-switch .tab.dark {
    background: #2b2a28;
  }
  .icon-switch-name {
    grid-column: 1 / -1;
    padding-top: 0.2rem;
    text-align: center;
  }
</style>
<script is:inline define:vars={{ names }}>
  ;(function () {
    var read = function () {
      try {
        return localStorage.getItem('aarhus-icon')
      } catch (e) {
        return null
      }
    }
    var write = function (v) {
      try {
        localStorage.setItem('aarhus-icon', v)
      } catch (e) {}
    }
    var fromUrl = new URLSearchParams(location.search).get('icon')
    if (names[fromUrl]) write(fromUrl)
    var pick = names[read()] ? read() : '1'
    var src = function (n) {
      return '/favicons/' + n + '.svg'
    }
    var apply = function () {
      var link = document.querySelector('link[rel="icon"]')
      if (link) link.href = src(pick)
    }
    apply()
    var bar = null
    var render = function () {
      apply()
      if (!bar) return
      bar.querySelectorAll('button').forEach(function (b) {
        b.setAttribute('aria-pressed', b.dataset.n === pick ? 'true' : 'false')
      })
      bar.querySelector('.icon-switch-name').textContent = pick + ' · ' + names[pick]
    }
    var set = function (n) {
      pick = String(n)
      write(pick)
      render()
    }
    document.addEventListener('DOMContentLoaded', function () {
      bar = document.createElement('div')
      bar.className = 'icon-switch'
      bar.setAttribute('role', 'group')
      bar.setAttribute('aria-label', 'Favicon candidates')
      bar.innerHTML =
        Object.keys(names)
          .map(function (n) {
            return (
              '<button type="button" data-n="' + n + '" title="' + names[n] + '">' +
              '<span class="big"><img src="' + src(n) + '" width="32" height="32" alt=""></span>' +
              '<span class="tabs"><span class="tab light"><img src="' + src(n) + '" width="16" height="16" alt=""></span>' +
              '<span class="tab dark"><img src="' + src(n) + '" width="16" height="16" alt=""></span></span>' +
              n + '</button>'
            )
          })
          .join('') + '<span class="icon-switch-name"></span>'
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('button')
        if (b) set(b.dataset.n)
      })
      document.body.appendChild(bar)
      render()
    })
    document.addEventListener('keydown', function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return
      if (e.target.closest && e.target.closest('input, textarea, select, [contenteditable]')) return
      var m = /^Digit([1-7])$/.exec(e.code)
      if (m) set(m[1])
    })
  })()
</script>
