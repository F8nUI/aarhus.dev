---
// A page whose text lives in src/content/<id>.md (About, Add Event).
import Layout from '@layouts/Layout.astro'
import { getEntry, render } from 'astro:content'

interface Props {
  id: string
}

const page = await getEntry('pages', Astro.props.id)
if (!page) throw new Error(`Missing src/content/${Astro.props.id}.md`)

const { Content } = await render(page)
const { title, description } = page.data
---

<Layout metadata={{ title, description }}>
  <div class="mb-6">
    <h1 class="font-semibold text-2xl md:text-3xl">{title}</h1>
    {
      description && (
        <p class="text-sm mt-2" style="color: var(--color-text-muted);">
          {description}
        </p>
      )
    }
  </div>
  <div class="h-px w-full" style="background-color: var(--color-border);"></div>
  <article class="prose mt-6">
    <Content />
  </article>
</Layout>
