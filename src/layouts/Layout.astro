---
// Every page: the document, the header (the logo, the page's title, the language switch,
// subscribe and add-event icons, the topics, which fold behind a "Topics" switch on
// phones), the page, and the footer (what the site is, its links in two groups, the
// theme switch). In the page's language, from its address (src/lib/i18n.ts). Styles:
// src/styles/global.css (tokens), site.css (this frame, text pages, prose) and
// board.css (the event lists).
import '../styles/global.css'
import '../styles/site.css'
import '../styles/board.css'
import Analytics from '@vercel/analytics/astro'
import { calendarFeed } from '@lib/calendar'
import { getEvents, getTopics } from '@lib/event'
import { basePath, LANG_NAMES, langOf, localPath, SITE, t, type Lang } from '@lib/i18n'
import { topicColor, topicName } from '@lib/topics'
import RuntimeBody from './RuntimeBody.astro'
import RuntimeHead from './RuntimeHead.astro'

interface Props {
  metadata?: { title?: string; description?: string }
  /** The topic the page belongs to: it's marked as the current one in the topic links. */
  topic?: string
  /** The list pages' title, shown beside the logo as the page's h1: "Rust events in Aarhus", "Dev conferences in Aarhus". */
  heading?: string
}

const { metadata, topic, heading } = Astro.props
const lang = langOf(Astro.url)
const w = t(lang)
// the same page in the other language, for the switch and for search engines
const base = basePath(Astro.url)
const other: Lang = lang === 'en' ? 'da' : 'en'
const here = (l: Lang) => localPath(l, base)

const siteName = 'aarhus.dev'
const pageTitle = metadata?.title ? `${metadata.title} – ${siteName}` : w.siteTitle
const pageDescription = metadata?.description || w.siteDescription

const topics = (await getTopics()).sort((a, b) => topicName(a, lang).localeCompare(topicName(b, lang), lang))
// Each topic link carries the end times of its events still to come at build time;
// RuntimeBody counts those still to come on the visit and fills in "(3)".
const buildTime = Date.now()
const upcoming = (await getEvents()).filter((e) => e.end.valueOf() >= buildTime)
const ends = (id?: string) => upcoming.filter((e) => !id || e.topic === id).map((e) => e.end.toISOString())
// "All topics" is the current one only on the all-topic lists (home and /past), not on text pages.
const onAllList = !topic && /^\/(past\/?)?$/.test(base)
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={w.rssName} href="/rss.xml" />
    <link rel="alternate" hreflang="en" href={new URL(here('en'), SITE).href} />
    <link rel="alternate" hreflang="da" href={new URL(here('da'), SITE).href} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@400;700&family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    <RuntimeHead />
    <Analytics />
  </head>
  <body>
    <div class="site">
      <header class="head">
        <div class="bar">
          <a class="mark" href={localPath(lang, '/')}>aarhus.dev<span class="cursor" aria-hidden="true"></span></a>
          {heading ? <h1 class="tagline">{heading}</h1> : <span class="tagline">{w.tagline}</span>}
          <span class="tools">
            <a
              class="icon-link lang-link"
              href={here(other)}
              hreflang={other}
              lang={other}
              title={LANG_NAMES[other]}
              aria-label={LANG_NAMES[other]}
              data-lang={other}>{other.toUpperCase()}</a
            >
            <a class="icon-link" href={calendarFeed.webcal} title={w.subscribe} aria-label={w.subscribe}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M3 4.5h18v17H3zM3 9.5h18M8 2v5M16 2v5"></path>
                <path d="M7.5 13.5a5 5 0 0 1 5 5M7.5 16.5a2 2 0 0 1 2 2"></path>
              </svg>
            </a>
            <a class="icon-link" href={localPath(lang, '/add-event')} title={w.addAnEvent} aria-label={w.addAnEvent}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" aria-hidden="true">
                <path d="M12 4v16M4 12h16"></path>
              </svg>
            </a>
          </span>
        </div>
        <nav class="lines" aria-label={w.topics}>
          <div class="lines-list" id="topic-list">
            <a href={localPath(lang, '/')} aria-current={onAllList ? 'true' : undefined} data-ends={ends().join(' ')}>
              <span class="topic-label">{w.allTopics}</span> <span class="count" data-upcoming>({ends().length})</span>
            </a>
            {
              topics.map((id) => (
                <a href={localPath(lang, `/${id}`)} aria-current={id === topic ? 'true' : undefined} data-ends={ends(id).join(' ')}>
                  <span class="dot" style={`--dot: ${topicColor(id)}`} aria-hidden="true" />
                  <span class="topic-label">{topicName(id, lang)}</span> <span class="count" data-upcoming>({ends(id).length})</span>
                </a>
              ))
            }
          </div>
          <button class="lines-toggle" type="button" aria-expanded="false" aria-controls="topic-list">
            {w.topics}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path d="M4 8l8 8 8-8"></path>
            </svg>
          </button>
        </nav>
      </header>

      <main class="page">
        <slot />
      </main>

      <footer class="foot">
        <p class="foot-about">
          <a class="mark" href={localPath(lang, '/')}>aarhus.dev</a>{' '}
          {w.footAbout}
        </p>
        <nav class="foot-links" aria-label={w.footSite}>
          <div class="foot-group">
            <span class="foot-label">{w.footSite}</span>
            <a href={localPath(lang, '/about')}>{w.about}</a>
            <a href={localPath(lang, '/add-event')}>{w.addEvent}</a>
            <a href="https://github.com/f8nui/aarhus.dev">GitHub</a>
          </div>
          <div class="foot-group">
            <span class="foot-label">{w.footFollow}</span>
            <a href={calendarFeed.webcal}>{w.subscribeLink}</a>
            <a href={calendarFeed.https} title={w.calendarUrlHint}>{w.calendarUrl}</a>
            <a href="/rss.xml" title={w.rssHint}>{w.rssFeed}</a>
          </div>
        </nav>
        <button class="theme-toggle toggle" type="button" aria-label={w.themeSwitch}>
          <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path>
          </svg>
          <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </footer>
    </div>
    <RuntimeBody />
  </body>
</html>
