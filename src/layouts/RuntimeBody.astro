---
// Runs once the page is parsed: re-tags every event item for the current
// (or overridden) time, keeps relative labels and counts current, and wires
// every `.theme-toggle` button.
import { relativeLabel, whenTags } from '@lib/when'

const script = `(function (whenTags, relativeLabel) {
  var now = window.aarhusNow()
  document.querySelectorAll('[data-start][data-end]').forEach(function (el) {
    var start = Date.parse(el.dataset.start)
    var end = Date.parse(el.dataset.end)
    el.dataset.when = whenTags(start, end, now)
    el.querySelectorAll('[data-rel]').forEach(function (label) {
      label.textContent = relativeLabel(start, end, now)
    })
  })
  // <span data-count="past"> → how many distinct events on the page are tagged "past"
  document.querySelectorAll('[data-count]').forEach(function (counter) {
    var seen = {}
    document.querySelectorAll('[data-id][data-when~="' + counter.dataset.count + '"]').forEach(function (el) {
      seen[el.dataset.id] = true
    })
    counter.textContent = Object.keys(seen).length
  })

  document.addEventListener('click', function (e) {
    var button = e.target.closest && e.target.closest('.theme-toggle')
    if (!button) return
    var root = document.documentElement
    var current = root.dataset.theme
    var isDark = current === 'dark' || (!current && matchMedia('(prefers-color-scheme: dark)').matches)
    var next = isDark ? 'light' : 'dark'
    var apply = function () { root.dataset.theme = next }
    if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.startViewTransition(apply)
    } else apply()
    try { localStorage.setItem('theme', next) } catch (err) {}
  })
})(${whenTags.toString()}, ${relativeLabel.toString()})`
---

<script is:inline set:html={script} />
