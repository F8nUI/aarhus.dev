---
// Runs once the page is parsed: re-tags every event item for the current
// (or overridden) time, keeps relative labels and counts current, keeps --head-h
// at the header's height, and wires the topics' switch and every `.theme-toggle` button.
import { relativeLabel, whenTags } from '@lib/when'

const script = `(function (whenTags, relativeLabel) {
  var now = window.aarhusNow()
  document.querySelectorAll('[data-start][data-end]').forEach(function (el) {
    var start = Date.parse(el.dataset.start)
    var end = Date.parse(el.dataset.end)
    el.dataset.when = whenTags(start, end, now)
    el.querySelectorAll('[data-rel]').forEach(function (label) {
      label.textContent = relativeLabel(start, end, now)
    })
  })
  // <span data-count="past"> → how many distinct events in its board are tagged "past"
  // (the featured posters beside it show other topics' events too, so they don't count)
  document.querySelectorAll('[data-count]').forEach(function (counter) {
    var scope = counter.closest('[data-scope]') || document
    var seen = {}
    scope.querySelectorAll('[data-id][data-when~="' + counter.dataset.count + '"]').forEach(function (el) {
      seen[el.dataset.id] = true
    })
    counter.textContent = Object.keys(seen).length
  })

  // the topic links: how many of each topic's events are still to come, "(3)"; none dims it
  document.querySelectorAll('[data-ends]').forEach(function (link) {
    var n = (link.dataset.ends || '').split(' ').filter(function (t) {
      return t && Date.parse(t) >= now
    }).length
    var count = link.querySelector('[data-upcoming]')
    if (count) count.textContent = '(' + n + ')'
    link.classList.toggle('is-empty', n === 0)
  })

  // --head-h: the header's height, for what sticks below it on desktop (the header can
  // grow a line when the topics wrap)
  var head = document.querySelector('.head')
  if (head) {
    var setHeadHeight = function () {
      document.documentElement.style.setProperty('--head-h', head.offsetHeight + 'px')
    }
    setHeadHeight()
    if (window.ResizeObserver) new ResizeObserver(setHeadHeight).observe(head)
  }

  // phones: the "Topics" switch opens and closes the folded topic list (site.css)
  document.querySelectorAll('.lines-toggle').forEach(function (button) {
    button.addEventListener('click', function () {
      var open = button.getAttribute('aria-expanded') === 'true'
      button.setAttribute('aria-expanded', open ? 'false' : 'true')
    })
  })

  document.addEventListener('click', function (e) {
    var button = e.target.closest && e.target.closest('.theme-toggle')
    if (!button) return
    var root = document.documentElement
    var current = root.dataset.theme
    var isDark = current === 'dark' || (!current && matchMedia('(prefers-color-scheme: dark)').matches)
    var next = isDark ? 'light' : 'dark'
    var apply = function () { root.dataset.theme = next }
    if (document.startViewTransition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.startViewTransition(apply)
    } else apply()
    try { localStorage.setItem('theme', next) } catch (err) {}
  })
})(${whenTags.toString()}, ${relativeLabel.toString()})`
---

<script is:inline set:html={script} />
