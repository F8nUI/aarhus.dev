---
// EXPERIMENT — remove once the fonts are chosen.
// Two rows of candidates, to find the pair that works best:
//   display (--font-display: titles, section headings, the posters, the ticket, the date)
//   mono    (--font-mono: everything else)
// Number keys 1–7 pick the display face, Shift + 1–7 the mono; or the switch in the
// corner, or ?font=N&mono=N. The last choice is remembered. Loads every candidate from
// Google Fonts while it's here.
const display = [
  { name: 'Big Shoulders', stack: "'Big Shoulders', 'Arial Narrow', sans-serif" },
  { name: 'Barlow Condensed', stack: "'Barlow Condensed', 'Arial Narrow', sans-serif" },
  { name: 'Sofia Sans Condensed', stack: "'Sofia Sans Condensed', 'Arial Narrow', sans-serif" },
  { name: 'Archivo Narrow', stack: "'Archivo Narrow', 'Arial Narrow', sans-serif" },
  { name: 'IBM Plex Sans Condensed', stack: "'IBM Plex Sans Condensed', 'Arial Narrow', sans-serif" },
  { name: 'Space Grotesk', stack: "'Space Grotesk', system-ui, sans-serif" },
  { name: 'Inter Tight', stack: "'Inter Tight', system-ui, sans-serif" },
]
const mono = [
  { name: 'JetBrains Mono', stack: "'JetBrains Mono', ui-monospace, monospace" },
  { name: 'IBM Plex Mono', stack: "'IBM Plex Mono', ui-monospace, monospace" },
  { name: 'Space Mono', stack: "'Space Mono', ui-monospace, monospace" },
  { name: 'Geist Mono', stack: "'Geist Mono', ui-monospace, monospace" },
  { name: 'Red Hat Mono', stack: "'Red Hat Mono', ui-monospace, monospace" },
  { name: 'Martian Mono', stack: "'Martian Mono', ui-monospace, monospace" },
  { name: 'Fira Code', stack: "'Fira Code', ui-monospace, monospace" },
]
const css =
  display.map((f, i) => `:root[data-font='${i + 1}'] { --font-display: ${f.stack}; }`).join('\n') +
  '\n' +
  mono.map((f, i) => `:root[data-mono='${i + 1}'] { --font-mono: ${f.stack}; }`).join('\n')
const names = {
  font: Object.fromEntries(display.map((f, i) => [i + 1, f.name])),
  mono: Object.fromEntries(mono.map((f, i) => [i + 1, f.name])),
}
---

<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Sofia+Sans+Condensed:wght@400..800&family=Archivo+Narrow:wght@400..700&family=IBM+Plex+Sans+Condensed:wght@400;600;700&family=Space+Grotesk:wght@400..700&family=Inter+Tight:wght@400..800&display=swap"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;700&family=Space+Mono:wght@400;700&family=Geist+Mono:wght@400..800&family=Red+Hat+Mono:wght@400..700&family=Martian+Mono:wght@400..800&family=Fira+Code:wght@400..700&display=swap"
/>
<style is:inline set:html={css}></style>
<style is:inline>
  .font-switch {
    position: fixed;
    right: 0.75rem;
    bottom: 0.75rem;
    z-index: 50;
    display: grid;
    grid-template-columns: auto repeat(7, auto) auto;
    align-items: center;
    gap: 0.35rem 0.3rem;
    padding: 0.45rem 0.6rem;
    background: #17140f;
    color: #fbfbf8;
    font: 12px/1.3 ui-monospace, Menlo, monospace;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.25);
  }
  .font-switch-label {
    padding-right: 0.3rem;
    opacity: 0.7;
  }
  .font-switch button {
    padding: 0.1rem 0.4rem;
    border: 1px solid currentColor;
    cursor: pointer;
    opacity: 0.55;
  }
  .font-switch button[aria-pressed='true'] {
    opacity: 1;
    background: #fbfbf8;
    color: #17140f;
  }
  .font-switch-name {
    min-width: 12rem;
    padding-left: 0.4rem;
  }
  @media (max-width: 40rem) {
    .font-switch {
      grid-template-columns: auto repeat(7, auto);
    }
    .font-switch-name {
      display: none;
    }
  }
</style>
<script is:inline define:vars={{ names }}>
  ;(function () {
    var read = function (k) {
      try {
        return localStorage.getItem(k)
      } catch (e) {
        return null
      }
    }
    var write = function (k, v) {
      try {
        localStorage.setItem(k, v)
      } catch (e) {}
    }
    var root = document.documentElement
    var params = new URLSearchParams(location.search)
    var pick = {}
    ;['font', 'mono'].forEach(function (kind) {
      var fromUrl = params.get(kind)
      if (names[kind][fromUrl]) write('aarhus-' + kind, fromUrl)
      var v = read('aarhus-' + kind)
      pick[kind] = names[kind][v] ? v : '1'
      root.dataset[kind] = pick[kind]
    })

    var bar = null
    var render = function () {
      if (!bar) return
      bar.querySelectorAll('button').forEach(function (b) {
        b.setAttribute('aria-pressed', pick[b.dataset.kind] === b.dataset.n ? 'true' : 'false')
      })
      ;['font', 'mono'].forEach(function (kind) {
        bar.querySelector('[data-name="' + kind + '"]').textContent = names[kind][pick[kind]]
      })
    }
    var set = function (kind, n) {
      pick[kind] = String(n)
      root.dataset[kind] = pick[kind]
      write('aarhus-' + kind, pick[kind])
      render()
    }
    var row = function (kind, label) {
      return (
        '<span class="font-switch-label">' + label + '</span>' +
        Object.keys(names[kind])
          .map(function (n) {
            return '<button type="button" data-kind="' + kind + '" data-n="' + n + '" title="' + names[kind][n] + '">' + n + '</button>'
          })
          .join('') +
        '<span class="font-switch-name" data-name="' + kind + '"></span>'
      )
    }
    document.addEventListener('DOMContentLoaded', function () {
      bar = document.createElement('div')
      bar.className = 'font-switch'
      bar.setAttribute('role', 'group')
      bar.setAttribute('aria-label', 'Font options')
      bar.innerHTML = row('font', 'Display') + row('mono', 'Mono')
      bar.addEventListener('click', function (e) {
        var b = e.target.closest('button')
        if (b) set(b.dataset.kind, b.dataset.n)
      })
      document.body.appendChild(bar)
      render()
    })
    document.addEventListener('keydown', function (e) {
      if (e.metaKey || e.ctrlKey || e.altKey) return
      if (e.target.closest && e.target.closest('input, textarea, select, [contenteditable]')) return
      var m = /^Digit([1-7])$/.exec(e.code)
      if (m) set(e.shiftKey ? 'mono' : 'font', m[1])
    })
  })()
</script>
