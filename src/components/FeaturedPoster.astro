---
// One featured event as a portrait poster in its topic's color, in both themes: the
// title stacked in the board's display face (it links to the event page), the date as
// one big day number with weekday, month and time beside it, then the organizer and a
// "Learn more" link to the event's page. On that page (`page`) it also shows where, and
// its link goes out to the organizer's, named by what it's for ("Sign up", "Get
// tickets", "Read more", or "Event page"), with the `actions` slot adding the calendar
// links under it. Its top row says when ("in 6 days", "now · until 16:30");
// Featured.astro stacks them beside the board and, with `nav`, puts the controls at
// that row's right end.
// Laid out wide (above the board on narrow screens, and on the event's page), the date,
// place and organizer share one band between two rules, with the link under it on
// the left; on phones it's compact.
import type { ADEvent } from '@lib/event'
import {
  dayNumber,
  eventAttrs,
  linkHost,
  machineDate,
  mapUrl,
  monthShort,
  relativeAtBuild,
  timeRange,
  titleFit,
  topicStyle,
  weekdayShort,
  yearOf,
} from '@lib/format'
import { langOf, localPath, t } from '@lib/i18n'
import { topicName } from '@lib/topics'
import LinkArrow from './LinkArrow.astro'

interface Props {
  event: ADEvent
  /** Previous / count / next / pause in the top row, for a stack of several. */
  nav?: boolean
  /** On the event's own page: the title is the page's heading, not a link to it. */
  page?: boolean
}

const { event, nav = false, page = false } = Astro.props
const { title, subtitle, venue, learnMoreURL, linkFor, endTime } = event.data
const lang = langOf(Astro.url)
const w = t(lang)
const time = timeRange(event, lang)
const year = yearOf(event.start) === yearOf(new Date()) ? '' : ` ${yearOf(event.start)}`
---

<article
  class:list={['sp', `fit-${titleFit(title)}`, { 'is-page': page }]}
  style={topicStyle(event.topic)}
  role={page ? undefined : 'group'}
  aria-roledescription={page ? undefined : 'slide'}
  aria-label={page ? undefined : title}
  {...eventAttrs(event)}
>
  <div class="sp-strip">
    <span class="sp-label">
      <span class="sp-up" data-rel>{relativeAtBuild(event, lang)}</span>
      <span class="sp-now"><span class="sp-lamp" aria-hidden="true"></span>{w.now}{endTime && ` · ${w.untilTime(endTime)}`}</span>
    </span>
    {
      nav && (
        <span class="sp-nav" hidden data-fx-nav>
          <button class="sp-navbtn" type="button" aria-label={w.previousFeatured} data-fx-prev>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path d="M15 4l-8 8 8 8" />
            </svg>
          </button>
          <span class="sp-count" data-fx-count />
          <button class="sp-navbtn" type="button" aria-label={w.nextFeatured} data-fx-next>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path d="M9 4l8 8-8 8" />
            </svg>
          </button>
          <button
            class="sp-navbtn sp-toggle"
            type="button"
            aria-label={w.pause}
            data-fx-toggle
            data-label-pause={w.pause}
            data-label-play={w.play}
          >
            <svg class="i-pause" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <rect x="4" y="3" width="6" height="18" />
              <rect x="14" y="3" width="6" height="18" />
            </svg>
            <svg class="i-play" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M5 3l16 9-16 9z" />
            </svg>
          </button>
        </span>
      )
    }
    {nav && <span class="sp-progress" aria-hidden="true" />}
  </div>

  <div class="sp-body">
    <hgroup class="sp-head">
      <p class="sp-topic"><a href={localPath(lang, `/${event.topic}`)}>{topicName(event.topic, lang)}</a></p>
      {page ? <h1 class="sp-title">{title}</h1> : <h2 class="sp-title"><a href={localPath(lang, event.url)}>{title}</a></h2>}
      {subtitle && <p class="sp-sub">{subtitle}</p>}
    </hgroup>

    <time class="sp-when" datetime={machineDate(event)}>
      <span class="sp-day">{dayNumber(event.start)}</span>
      <span class="sp-lines">
        <span>{weekdayShort(event.start, lang)} {monthShort(event.start, lang)}{year}</span>
        <span class:list={{ tba: !time }}>{time || w.timeTba}</span>
      </span>
    </time>

    <dl class="sp-facts">
      {
        page && (
          <div>
            <dt>{w.where}</dt>
            <dd>
              {venue ? (
                <>
                  <span class="sp-name">{venue.title}</span>
                  <a class="sp-address" href={mapUrl(event)}>
                    {venue.address}
                  </a>
                </>
              ) : (
                <span class="sp-name">{w.venueTba}</span>
              )}
            </dd>
          </div>
        )
      }
      <div>
        <dt>{w.organizer}</dt>
        <dd><a class="sp-name" href={localPath(lang, `/organizer/${event.organizer.id}`)}>{event.organizer.data.name}</a></dd>
      </div>
    </dl>

    <div class="sp-actions">
      {
        page ? (
          <a class="sp-signup" href={learnMoreURL}>
            <span class="sp-go">
              <span class="sp-live">{linkFor ? w.linkFor[linkFor] : w.eventPage}</span>
              <span class="sp-past">{w.eventPage}</span>
            </span>{' '}
            <span class="sp-host">{w.onHost(linkHost(learnMoreURL))}</span>
            <LinkArrow />
          </a>
        ) : (
          <a class="sp-signup" href={localPath(lang, event.url)}>
            <span class="sp-go">{w.learnMore}</span>
            <LinkArrow />
          </a>
        )
      }
      <slot name="actions" />
    </div>
  </div>
</article>

<style is:global>
  .site {
    /* ---------- the poster ---------- */
    .sp {
      /* the weight of the rules: under the top row, around the date */
      --rule: 3px;
      /* the date's line size; the day number is two lines tall */
      --date: 1.75rem;
      /* side padding = how far the poster hangs past the page's text edge, so its text lines up on that edge */
      --pad-x: var(--box-pad);
      /* the body's space above (under the top strip's rule) and below, the same at both ends */
      --pad-y: 1rem;
      /* one face, three sizes: labels (small capitals), text, and the big title and date */
      --sp-label: 0.8125rem;
      --sp-text: 1.125rem;
      /* and two weights: bold for labels, names and the button; regular for the address and caption */
      /* its colors, from the topic's (format.ts topicStyle): the background and the ink on it */
      --p: var(--topic);
      --p-on: #fff;
      container-type: inline-size;
      display: flex;
      flex-direction: column;
      background: var(--p);
      color: var(--p-on);
      font-family: var(--font-display);
      font-variant-numeric: lining-nums tabular-nums;
    }
    .sp a {
      color: inherit;
    }
    .sp a:hover {
      color: inherit;
      text-decoration-thickness: 2px;
    }
    .sp :focus-visible {
      outline-color: var(--p-on);
    }

    /* ---------- top row: when, then the controls ---------- */
    .sp-strip {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 0.5rem;
      margin-inline: var(--pad-x);
      padding-block: 0.5rem 0.35rem;
      border-bottom: var(--rule) solid currentColor;
      font-size: var(--sp-label);
      font-weight: 800;
      letter-spacing: 0.08em;
      line-height: 1.5rem;
      text-transform: uppercase;
      white-space: nowrap;
    }
    .sp-label {
      grid-column: 1;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sp-now {
      display: none;
      align-items: center;
      gap: 0.6ch;
    }
    [data-when~='now'] .sp-now {
      display: inline-flex;
    }
    [data-when~='now'] .sp-up {
      display: none;
    }
    .sp-lamp {
      width: 0.55em;
      height: 0.55em;
      background: currentColor;
    }
    @media (prefers-reduced-motion: no-preference) {
      .sp-lamp {
        animation: blink 2.4s steps(1, end) infinite;
      }
    }

    /* the controls: quiet until pointed at */
    .sp-nav {
      grid-column: 2;
      display: flex;
      align-items: center;
      margin-right: -0.375rem;
    }
    .sp-nav[hidden] {
      display: none;
    }
    .sp-navbtn {
      display: grid;
      place-items: center;
      width: 1.5rem;
      height: 1.5rem;
      color: inherit;
      opacity: 0.7;
      cursor: pointer;
    }
    .sp-navbtn:hover,
    .sp-navbtn:focus-visible {
      opacity: 1;
      background: color-mix(in srgb, currentColor 16%, transparent);
    }
    .sp-count {
      min-width: 4.5ch;
      text-align: center;
      letter-spacing: 0.04em;
      opacity: 0.7;
    }
    .sp-toggle {
      margin-left: 0.25rem;
    }
    .sp-toggle .i-play {
      display: none;
    }
    /* the timer: the top row's rule fills while the poster is shown (Featured.astro runs it) */
    /* grows by width, not by a GPU transform: pausing it (on hover) then holds exactly
       what's on screen instead of snapping back to the page's slightly older time */
    .sp-progress {
      position: absolute;
      left: 0;
      bottom: calc(-1 * var(--rule));
      width: 0;
      height: var(--rule);
      background: currentColor;
    }

    /* ---------- body: posters in a stack share the tallest one's height; the button keeps to the foot ---------- */
    .sp-body {
      flex: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      /* the title's row takes any spare height (the posters in a stack share the tallest
         one's), so date, place, organizer and button sit at the same spot on each */
      grid-template-rows: 1fr auto auto auto;
      gap: 1.1rem;
      padding: var(--pad-y) var(--pad-x);
    }

    .sp-topic {
      margin-bottom: 0.4rem;
      font-size: var(--sp-label);
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    /* the topic and the title link without an underline: pointing at them fades them a little */
    .sp-topic a,
    .sp-title a {
      text-decoration: none;
      transition: opacity 0.15s ease;
    }
    .sp .sp-topic a:hover,
    .sp .sp-title a:hover {
      text-decoration: none;
      opacity: 0.72;
    }
    .sp-title {
      font-weight: 800;
      line-height: 0.88;
      letter-spacing: 0.005em;
      text-transform: uppercase;
      text-wrap: balance;
      overflow-wrap: break-word;
    }
    /* the title fills about the same block, short or long */
    .fit-xs .sp-title {
      font-size: clamp(3rem, 20cqi, 6.5rem);
    }
    .fit-s .sp-title {
      font-size: clamp(2.6rem, 16cqi, 5.5rem);
    }
    .fit-m .sp-title {
      font-size: clamp(2.4rem, 13cqi, 4.75rem);
    }
    .fit-l .sp-title {
      font-size: clamp(2.1rem, 10.5cqi, 4.25rem);
    }
    .sp-sub {
      margin-top: 0.6rem;
      font-size: var(--sp-text);
      font-weight: 700;
    }

    /*
     * The date, in the title's face: the day number, and beside it weekday + month over
     * the time, both at one size. Each line is trimmed to its capitals, so the first
     * line's top meets the number's top and the last line sits on the number's baseline.
     */
    .sp-when {
      display: flex;
      align-items: stretch;
      gap: 0.6rem;
      padding-block: 0.8rem;
      border-block: var(--rule) solid currentColor;
      font-family: var(--font-display);
      font-weight: 800;
      line-height: 1;
      text-transform: uppercase;
      font-variant-numeric: lining-nums tabular-nums;
    }
    .sp-day {
      font-size: calc(var(--date) * 2.5);
      letter-spacing: -0.01em;
      text-box: trim-both cap alphabetic;
    }
    .sp-lines {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
      font-size: var(--date);
    }
    .sp-lines > span {
      text-box: trim-both cap alphabetic;
    }
    .sp-lines .tba {
      opacity: 0.8;
    }

    /* labels in a column of their own */
    .sp-facts {
      display: grid;
      gap: 0.6rem;
      font-size: var(--sp-text);
      font-weight: 400;
      line-height: 1.2;
    }
    .sp-facts > div {
      display: grid;
      grid-template-columns: 5.25rem minmax(0, 1fr);
      align-items: baseline;
    }
    /* the labels: the values' size, sentence case, regular and faded */
    .sp-facts dt {
      font-weight: 400;
      opacity: 0.75;
    }
    .sp-facts dd {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    /* names bold, the address regular */
    .sp-name {
      font-weight: 800;
    }

    .sp-actions {
      align-self: end;
    }
    /*
     * The sign-up: a large text link on the poster's own color, on the text edge.
     * "Sign up" underlined, an arrow, and where it goes on a second line, smaller,
     * regular and faded.
     */
    .sp .sp-signup {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 0.3em;
      font-size: calc(var(--sp-text) * 1.4);
      font-weight: 800;
      line-height: 1.2;
      text-decoration: none;
      overflow-wrap: anywhere;
    }
    .sp-go {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.16em;
    }
    .sp .sp-signup:hover .sp-go {
      text-decoration-thickness: 3px;
    }
    /*
     * The arrow, drawn rather than the font's thin "→": a stroke as heavy as the bold
     * letters, sitting on the baseline (an SVG's baseline is its bottom edge) and
     * centred on the lowercase letters.
     */
    .sp-arrow {
      order: 1;
      flex: none;
      width: 0.8em;
      height: 0.6em;
      fill: none;
      stroke: currentColor;
      stroke-width: 3;
      stroke-linejoin: miter;
    }
    @media (prefers-reduced-motion: no-preference) {
      .sp-arrow {
        transition: translate 0.15s;
      }
      .sp .sp-signup:hover .sp-arrow {
        translate: 0.15em 0;
      }
    }
    .sp-host {
      order: 2;
      flex-basis: 100%;
      margin-top: 0.3rem;
      font-size: var(--sp-label);
      font-weight: 400;
      line-height: 1.3;
      opacity: 0.75;
    }
    /* an event that has ended (on its own page): the button points to the organizer's page */
    .sp-past,
    .sp[data-when~='past'] .sp-live {
      display: none;
    }
    .sp[data-when~='past'] .sp-past {
      display: inline;
    }
    .sp .sp-signup:hover {
      color: inherit;
    }

    /* ---------- above the board, laid out wide ---------- */
    @container (min-width: 36rem) {
      /* set on the body, not .sp: a container query can't style the container itself */
      .sp-body {
        --date: 2.25rem;
        --pad-y: 1.5rem;
      }
      /*
       * The title across; under it one band between two rules (the date, then where and
       * who, side by side, or under each other when there's no room); the link under
       * the band, on the left.
       */
      .sp-body {
        grid-template-columns: auto minmax(0, 1fr);
        grid-template-rows: 1fr auto auto;
        grid-template-areas:
          'head head'
          'when facts'
          'actions actions';
        column-gap: 0;
      }

      .sp-head {
        grid-area: head;
      }
      /* as tall as the band (its rules run along it), the date centred in it: one grid row
         as tall as the day number, which the two lines beside it spread to */
      .sp-when {
        grid-area: when;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-content: center;
      }
      .sp-facts {
        grid-area: facts;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        align-content: center;
        gap: 0.85rem 2rem;
        /* the date's band continues under and over it: the same rules and padding */
        padding: 0.8rem 0 0.8rem 2.5rem;
        border-block: var(--rule) solid currentColor;
      }
      .sp-actions {
        grid-area: actions;
      }
      .fit-xs .sp-title {
        font-size: clamp(3rem, 11cqi, 6.5rem);
      }
      .fit-s .sp-title {
        font-size: clamp(2.75rem, 9cqi, 5.5rem);
      }
      .fit-m .sp-title {
        font-size: clamp(2.5rem, 7.5cqi, 4.75rem);
      }
      .fit-l .sp-title {
        font-size: clamp(2.25rem, 6.5cqi, 4.25rem);
      }
      .sp-facts > div {
        display: block;
      }
      .sp-facts dt {
        margin-bottom: 0.15rem;
      }
    }

    /*
     * Phones: compact. A smaller title and date, venue and organizer side by side, the
     * address left to the event page.
     */
    @media (max-width: 40rem) {
      .sp {
        --rule: 2px;
        --date: 1.25rem;
        /* edge to edge: the page's gutter */
        --pad-x: 1rem;
        --sp-label: 0.75rem;
        --sp-text: 1rem;
      }
      .sp-strip {
        padding-block: 0.35rem 0.25rem;
      }
      .sp-body {
        row-gap: 0.9rem;
      }
      .sp-topic {
        margin-bottom: 0.3rem;
      }
      .fit-xs .sp-title {
        font-size: 2.75rem;
      }
      .fit-s .sp-title {
        font-size: 2.5rem;
      }
      .fit-m .sp-title {
        font-size: 2.125rem;
      }
      .fit-l .sp-title {
        font-size: 1.875rem;
      }
      .sp-sub {
        margin-top: 0.35rem;
      }
      .sp-when {
        padding-block: 0.55rem;
      }
      .sp-facts {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 1rem;
      }
      .sp-facts > div {
        display: block;
      }
      .sp-facts dt {
        margin-bottom: 0.15rem;
      }
      .sp-address {
        display: none;
      }
      /* on the event's own page the address stays */
      .sp.is-page .sp-address {
        display: block;
      }
    }
  }

  /*
   * Dark: a dark panel tinted with the topic, its text, rules and buttons lit in a light
   * tint of it, instead of the bright color glaring off the page. Browsers without
   * relative colors keep the light theme's poster.
   */
  @supports (color: oklch(from red l c h)) {
    :root[data-theme='dark'] .site .sp {
      --p: oklch(from var(--topic) 0.27 calc(c * 0.55) h);
      --p-on: oklch(from var(--topic) 0.86 calc(c * 0.7) h);
    }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) .site .sp {
        --p: oklch(from var(--topic) 0.27 calc(c * 0.55) h);
        --p-on: oklch(from var(--topic) 0.86 calc(c * 0.7) h);
      }
    }
  }
</style>
