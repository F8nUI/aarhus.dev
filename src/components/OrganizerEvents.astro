---
// An organizer's events, on their page: what's coming up, soonest first, then what's
// been, newest first. The board's rows and sections (src/styles/board.css); the
// browser sorts each event into the right one on every visit.
import type { ADEvent } from '@lib/event'
import { langOf, localPath, t } from '@lib/i18n'
import Row from './Row.astro'

interface Props {
  /** The organizer's events, oldest first. */
  events: ADEvent[]
}

const { events } = Astro.props
const lang = langOf(Astro.url)
const w = t(lang)
---

<div class="tt-board" data-scope>
  <section class="sect" data-bucket="upcoming">
    <h2 class="sect-head">{w.comingUp}</h2>
    <ol class="rows">
      {
        events.map((event) => (
          <Row event={event} />
        ))
      }
    </ol>
  </section>

  <div class="empty" data-empty="upcoming">
    <p>{w.nothingComingUp}</p>
    <p class="empty-sub">
      {w.knowOfOne} <a href={localPath(lang, '/add-event')}>{w.addAnEvent}</a>
    </p>
  </div>

  <section class="sect" data-bucket="past">
    <h2 class="sect-head">{w.pastEvents}</h2>
    <ol class="rows">
      {
        [...events].reverse().map((event) => (
          <Row event={event} />
        ))
      }
    </ol>
  </section>
</div>
