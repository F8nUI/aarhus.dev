---
import { topicColor } from '@lib/topics'

interface Props {
  topic: string
  class?: string
}

const { topic, class: className } = Astro.props
---

<span
  class:list={['inline-block w-2 h-2 rounded-full shrink-0', className]}
  style={`background-color: ${topicColor(topic)};`}
  title={topic}></span>
