---
// The timetable: today's board (now + later today), then tomorrow, this week, next
// week, and a section per month after that. The archive (/past) is the same rows,
// newest first, a section per month.
// Every event is rendered into each bucket it could fall in; the runtime tags each
// row with data-when on every visit and the bucket CSS shows it in the right place.
//
// Highlighted events still to come, from every topic, sit beside the board as featured
// posters (above it on narrow screens), on every list page alike: home, topics, past.
// On phones, only the home page shows them.
// Styles: src/styles/board.css.
import { getEvents, type ADEvent } from '@lib/event'
import { eventAttrs, featuredEvents, groupBy, monthTitle } from '@lib/format'
import { langOf, localPath, t } from '@lib/i18n'
import { topicEvents } from '@lib/topics'
import Featured from './Featured.astro'
import Row from './Row.astro'

interface Props {
  events: ADEvent[]
  topic?: string
  past: boolean
}

const { events, topic, past } = Astro.props
const lang = langOf(Astro.url)
const w = t(lang)

// What had ended at build time can never be upcoming again: leave it out of the
// upcoming buckets, but keep a bare entry so the past count still sees it.
const buildTime = Date.now()
const live = events.filter((e) => e.end.valueOf() >= buildTime)
const ended = events.filter((e) => e.end.valueOf() < buildTime)

const featured = featuredEvents(await getEvents())
const onHome = !topic && !past

// "Swift events", "dev conferences", or just "events" on the all-topic lists
const what = topic ? topicEvents(topic, lang) : w.events
const pastHref = localPath(lang, topic ? `/past/${topic}` : '/past')
const upcomingHref = localPath(lang, topic ? `/${topic}` : '/')
const addEventHref = localPath(lang, '/add-event')

const laterMonths = groupBy(live, (e) => monthTitle(e.start, lang))
const archiveMonths = groupBy([...events].reverse(), (e) => monthTitle(e.start, lang))
---

<div class="tt">
  <div class:list={['tt-layout', { beside: featured.length > 0 }]}>
    {
      featured.length > 0 && (
        <div class:list={['heads', { 'not-home': !onHome }]}>
          <Featured events={featured} />
        </div>
      )
    }
  {
    past ? (
      <div class="tt-board" data-scope>
        <div class="archive-head">
          <h2 class="archive-title">{w.pastOf(what)}</h2>
          <a class="archive-back" href={upcomingHref}>
            {w.upcomingOf(what)}&nbsp;→
          </a>
        </div>
        <div class="cols" aria-hidden="true">
          <span class="when"><span>{w.cols.day}</span><span>{w.cols.time}</span></span>
          <span class="col-topic">{w.cols.topic}</span>
          <span class="col-event">{w.cols.event}</span>
          <span class="col-venue">{w.cols.venue}</span>
          <span class="col-status">{w.cols.status}</span>
        </div>
        {archiveMonths.map((month) => (
          <section class="sect" data-bucket="past">
            <h2 class="sect-head">{month.key}</h2>
            <ol class="rows">
              {month.items.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>
        ))}
        <div class="empty" data-empty="past">
          <p>{w.archiveEmpty}</p>
          <p class="empty-sub">
            {w.archiveEmptyHint} <a href={upcomingHref}>{w.seeUpcoming}</a>
          </p>
        </div>
      </div>
    ) : (
        <div class="tt-board" data-scope>
          <div class="cols" aria-hidden="true">
            <span class="when"><span>{w.cols.day}</span><span>{w.cols.time}</span></span>
            <span class="col-topic">{w.cols.topic}</span>
            <span class="col-event">{w.cols.event}</span>
            <span class="col-venue">{w.cols.venue}</span>
            <span class="col-status">{w.cols.status}</span>
          </div>

          <section class="board" aria-label={w.today}>
            <h2 class="board-head">{w.today}</h2>
            <ol class="rows" data-bucket="now">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
            <ol class="rows" data-bucket="today">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>

          <section class="sect" data-bucket="tomorrow">
            <h2 class="sect-head">{w.tomorrow}</h2>
            <ol class="rows">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>

          <section class="sect" data-bucket="week">
            <h2 class="sect-head">{w.thisWeek}</h2>
            <ol class="rows">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>

          <section class="sect" data-bucket="nextweek">
            <h2 class="sect-head">{w.nextWeek}</h2>
            <ol class="rows">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>

          {laterMonths.map((month) => (
            <section class="sect" data-bucket="later">
              <h2 class="sect-head">{month.key}</h2>
              <ol class="rows">
                {month.items.map((event) => (
                  <Row event={event} />
                ))}
              </ol>
            </section>
          ))}

          <div class="empty" data-empty="upcoming">
            <p>{w.boardEmpty(what)}</p>
            <p class="empty-sub">
              {w.boardEmptyHint} <a href={addEventHref}>{w.addAnEvent}</a>
            </p>
          </div>

          <p class="tt-end">
            <a class="tt-past" href={pastHref}>
              {w.pastOf(what)} (<span data-count="past">{ended.length}</span>)
            </a>
          </p>

          <div hidden>
            {ended.map((event) => (
              <i {...eventAttrs(event)} />
            ))}
          </div>
        </div>
    )
  }
  </div>
</div>
