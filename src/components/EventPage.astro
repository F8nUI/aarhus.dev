---
// An event's page: the event's poster laid out wide across the page in its topic's
// color (title, date, where, who, sign-up, and the add-to-calendar buttons under it), a
// note once it has ended, the description, and where to fix it. The header's topic row
// marks its topic.
import type { ADEvent } from '@lib/event'
import { eventAttrs } from '@lib/format'
import CalendarLinks from './event/CalendarLinks.astro'
import EventEdit from './event/EventEdit.astro'
import { eventFacts } from './event/facts'
import FeaturedPoster from './FeaturedPoster.astro'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const f = eventFacts(event)
---

<article class="ev" {...eventAttrs(event)}>
  <div class="ev-band">
    <FeaturedPoster event={event} page>
      <CalendarLinks facts={f} slot="actions" />
    </FeaturedPoster>
  </div>
  <p class="ev-ended">This event has ended.</p>
  <div class="prose ev-body">
    <slot />
  </div>
  <EventEdit facts={f} />
</article>

<style is:global>
  .site {
    .ev-band {
      margin-inline: calc(-1 * var(--hang));
    }
    /* below desktop width it starts right at the header's rule, like the featured posters */
    @media (width < 64rem) {
      .ev-band {
        margin-top: calc(-1 * var(--page-top));
      }
    }
    .ev-ended {
      display: none;
      margin: 1rem calc(-1 * var(--hang)) 0;
      padding: 0.6rem calc(var(--hang) - 1px);
      border: 1px solid var(--color-border);
      background: var(--color-bg-subtle);
      font-family: var(--font-display);
      font-size: 1.0625rem;
      font-weight: 700;
    }
    .ev[data-when~='past'] .ev-ended {
      display: block;
    }
    .ev-body {
      margin-top: 2.5rem;
    }
  }
</style>
