---
// The About page's numbers: events coming up (counted again on every visit, like the
// topic counts: RuntimeBody), communities and topics.
import { getCollection } from 'astro:content'
import { getEvents, getTopics } from '@lib/event'
import { langOf, t } from '@lib/i18n'

const w = t(langOf(Astro.url))
const buildTime = Date.now()
const ends = (await getEvents()).filter((e) => e.end.valueOf() >= buildTime).map((e) => e.end.toISOString())
const communities = (await getCollection('organizers')).length
const topics = (await getTopics()).length
---

<div class="ab-numbers">
  <p data-ends={ends.join(' ')}>
    <span class="ab-n" data-upcoming data-bare>{ends.length}</span>
    <span class="ab-label">{w.aboutUpcoming}</span>
  </p>
  <p>
    <span class="ab-n">{communities}</span>
    <span class="ab-label">{w.aboutCommunities}</span>
  </p>
  <p>
    <span class="ab-n">{topics}</span>
    <span class="ab-label">{w.aboutTopics}</span>
  </p>
</div>

<style is:global>
  .site {
    .ab-numbers {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem 3.5rem;
      margin-bottom: 2.5rem;
    }
    .ab-n {
      display: block;
      font-family: var(--font-display);
      font-size: 3.5rem;
      font-weight: 800;
      line-height: 1;
      font-variant-numeric: lining-nums tabular-nums;
      color: var(--title);
    }
    .ab-label {
      display: block;
      margin-top: 0.35rem;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
    }
  }
</style>
