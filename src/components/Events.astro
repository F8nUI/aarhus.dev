---
import { getEvents } from '@lib/event'
import EventList from './EventList'

interface Props {
  topic?: string
  pastOnly?: boolean
}

const { topic, pastOnly } = Astro.props
const events = (await getEvents()).filter((e) => {
  if (!topic) {
    return e
  }

  return e.topic == topic
})
---

<EventList client:only="preact" events={events} filteringByTopic={topic != undefined} pastOnly={pastOnly} topic={topic} />
