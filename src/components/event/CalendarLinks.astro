---
// Add to calendar: the event as an .ics file (Apple Calendar, Outlook and the rest), and
// Google Calendar. Text links in a row under the poster's sign-up link (the event page
// puts them in FeaturedPoster's `actions` slot); gone once the event is over.
import { langOf, t } from '@lib/i18n'
import type { EventFacts } from './facts'

interface Props {
  facts: EventFacts
}

const { facts } = Astro.props
const w = t(langOf(Astro.url))
---

<p class="cal-links">
  <a href={facts.ics.href} download={facts.ics.file}>{w.addToCalendar}</a>
  <a href={facts.google}>{w.googleCalendar}</a>
</p>

<style is:global>
  .site {
    /* small text links in a row under the sign-up link, in the poster's ink */
    .cal-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.5rem;
      margin-top: 0.9rem;
    }
    .sp .cal-links a {
      font-size: var(--sp-label);
      font-weight: 800;
      line-height: 1.25;
      text-underline-offset: 0.2em;
    }
    .sp .cal-links a:hover {
      text-decoration-thickness: 2px;
    }
    .sp[data-when~='past'] .cal-links {
      display: none;
    }
  }
</style>
