---
// Add to calendar: the event as an .ics file, and Google Calendar.
import type { EventFacts } from './facts'

interface Props {
  facts: EventFacts
}

const { facts } = Astro.props
---

<p class="cal-links">
  <a href={facts.ics.href} download={facts.ics.file}>Add to calendar (.ics)</a>
  <a href={facts.google}>Google Calendar</a>
</p>

<style is:global>
  .site .cal-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    font-size: 0.875rem;
  }
</style>
