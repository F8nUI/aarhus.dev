---
// The foot of an event page: where to fix it.
import { langOf, t } from '@lib/i18n'
import type { EventFacts } from './facts'

interface Props {
  facts: EventFacts
}

const { facts } = Astro.props
const w = t(langOf(Astro.url))
---

<p class="ev-fix">
  {w.fixPrompt} <a href={facts.edit}>{w.fixLink}</a>
</p>

<style is:global>
  .site .ev-fix {
    max-width: calc(68ch + 2 * var(--hang));
    margin: 2.5rem calc(-1 * var(--hang)) 0;
    padding: 0.9rem var(--hang) 0;
    border-top: 1px solid var(--color-border);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
</style>
