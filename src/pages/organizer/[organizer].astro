---
import Layout from '@layouts/Layout.astro'
import OrganizerEvents from '@components/OrganizerEvents.astro'
import TextPage from '@components/TextPage.astro'
import { render, type CollectionEntry } from 'astro:content'
import { getEvents } from '@lib/event'
import { langOf, t } from '@lib/i18n'
import { organizerPaths } from '@lib/paths'

export const getStaticPaths = organizerPaths

const { organizer } = Astro.props as { organizer: CollectionEntry<'organizers'> }
const { Content } = await render(organizer)
const { name, website } = organizer.data
const events = (await getEvents()).filter((event) => event.organizer.id === organizer.id)
const metadata = { title: name, description: t(langOf(Astro.url)).organizerDescription(name) }
---

<Layout {metadata}>
  <TextPage title={name} {website}>
    <Content />
  </TextPage>
  <OrganizerEvents {events} />
</Layout>
