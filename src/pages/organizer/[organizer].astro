---
import Layout from '@layouts/Layout.astro'
import type { GetStaticPaths } from 'astro'
import { render } from 'astro:content'
import { getCollection } from 'astro:content'

export const getStaticPaths = (async () => {
  const organizers = await getCollection('organizers')
  return organizers.map((organizer) => ({
    params: { organizer: organizer.id },
    props: {
      organizer,
    },
  }))
}) satisfies GetStaticPaths

const { organizer } = Astro.props
const { Content } = await render(organizer)
const metadata = {
  title: organizer.data.name,
  description: `Information about ${organizer.data.name}, a tech community organizer in Aarhus, Denmark`,
}
---

<Layout {metadata}>
  <div class="mb-6">
    <h1 class="font-semibold text-2xl md:text-3xl">{organizer.data.name}</h1>
  </div>
  <div class="prose">
    <Content />
  </div>
</Layout>
