---
import VariantPage from '@variants/VariantPage.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  return (await getCollection('organizers')).map((organizer) => ({
    params: { organizer: organizer.id },
    props: { organizer },
  }))
}

const { organizer } = Astro.props
const { Content } = await render(organizer)
const { name, website } = organizer.data
const metadata = {
  title: name,
  description: `Information about ${name}, a tech community organizer in Aarhus, Denmark`,
}
---

<VariantPage {metadata} page={{ title: name, website }} {Content} />
