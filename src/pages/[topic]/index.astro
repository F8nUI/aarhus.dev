---
import VariantPage from '@variants/VariantPage.astro'
import { getEvents, getTopics } from '@lib/event'
import { topicName } from '@lib/topics'

export async function getStaticPaths() {
  return (await getTopics()).map((topic) => ({ params: { topic } }))
}

const { topic } = Astro.params
const metadata = {
  title: `${topicName(topic)} Events in Aarhus`,
  description: `${topicName(topic)} tech events and meetups in Aarhus, Denmark`,
}
---

<VariantPage {metadata} {topic} list={{ events: await getEvents(topic), past: false }} />
