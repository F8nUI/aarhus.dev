---
import Layout from '@layouts/Layout.astro'
import Board from '@components/Board.astro'
import { getEvents, getTopics } from '@lib/event'
import { topicEventsTitle } from '@lib/topics'

export async function getStaticPaths() {
  return (await getTopics()).map((topic) => ({ params: { topic } }))
}

const { topic } = Astro.params
const metadata = {
  title: `${topicEventsTitle(topic)} in Aarhus`,
  description: `${topicEventsTitle(topic)} in Aarhus, Denmark: what's coming up, with dates, venues and where to sign up`,
}
---

<Layout {metadata} {topic} heading={`${topicEventsTitle(topic)} in Aarhus`}>
  <Board events={await getEvents(topic)} {topic} past={false} />
</Layout>
