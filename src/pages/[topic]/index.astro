---
import Layout from '@layouts/Layout.astro'
import Board from '@components/Board.astro'
import { getEvents } from '@lib/event'
import { langOf, t } from '@lib/i18n'
import { topicPaths } from '@lib/paths'
import { topicEventsTitle } from '@lib/topics'

export const getStaticPaths = topicPaths
// no props: the topic comes from the address (src/pages/da/ renders this page as it is)
interface Props {}

const { topic } = Astro.params
const lang = langOf(Astro.url)
const w = t(lang)
const what = topicEventsTitle(topic, lang)
const metadata = { title: w.inAarhus(what), description: w.topicDescription(what) }
---

<Layout {metadata} {topic} heading={w.inAarhus(what)}>
  <Board events={await getEvents(topic)} {topic} past={false} />
</Layout>
