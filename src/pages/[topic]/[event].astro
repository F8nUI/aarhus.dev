---
import VariantPage from '@variants/VariantPage.astro'
import { getCollection, render } from 'astro:content'
import { formatLong, parseEvent } from '@lib/event'

export async function getStaticPaths() {
  const events = await getCollection('events')
  return Promise.all(
    events.map(async (entry) => {
      const event = await parseEvent(entry)
      return { params: { topic: event.topic, event: entry.id.split('/')[1] }, props: { event } }
    }),
  )
}

const { event } = Astro.props
const { title, subtitle, venue } = event.data
const { Content } = await render(event)
const metadata = {
  title,
  description: subtitle || `${title} – ${venue?.title ?? 'Aarhus'}, ${formatLong(event).date}`,
}
---

<VariantPage {metadata} topic={event.topic} {event} {Content} />
