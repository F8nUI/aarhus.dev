---
import Layout from '@layouts/Layout.astro'
import EventPage from '@components/EventPage.astro'
import { render } from 'astro:content'
import { formatLong, type ADEvent } from '@lib/event'
import { langOf } from '@lib/i18n'
import { eventPaths } from '@lib/paths'

export const getStaticPaths = eventPaths

const { event } = Astro.props as { event: ADEvent }
const { title, subtitle, venue } = event.data
const { Content } = await render(event)
const metadata = {
  title,
  description: subtitle || `${title} – ${venue?.title ?? 'Aarhus'}, ${formatLong(event, langOf(Astro.url)).date}`,
}
---

<Layout {metadata} topic={event.topic}>
  <EventPage {event}>
    <Content />
  </EventPage>
</Layout>
