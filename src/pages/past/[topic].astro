---
import Layout from '@layouts/Layout.astro'
import Board from '@components/Board.astro'
import { getEvents, getTopics } from '@lib/event'
import { topicEvents } from '@lib/topics'

export async function getStaticPaths() {
  return (await getTopics()).map((topic) => ({ params: { topic } }))
}

const { topic } = Astro.params
const metadata = {
  title: `Past ${topicEvents(topic)} in Aarhus`,
  description: `Past ${topicEvents(topic)} in Aarhus, Denmark`,
}
---

<Layout {metadata} {topic} heading={`past ${topicEvents(topic)} in Aarhus`}>
  <Board events={await getEvents(topic)} {topic} past={true} />
</Layout>
