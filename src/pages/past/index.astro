---
import Layout from '@layouts/Layout.astro'
import Board from '@components/Board.astro'
import { getEvents } from '@lib/event'
import { langOf, t } from '@lib/i18n'

const w = t(langOf(Astro.url))
const metadata = { title: w.pastTitle, description: w.pastDescription }
---

<Layout {metadata} heading={w.pastHeading}>
  <Board events={await getEvents()} past={true} />
</Layout>
