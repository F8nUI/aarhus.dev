---
import Layout from '@layouts/Layout.astro'
import Board from '@components/Board.astro'
import { getEvents } from '@lib/event'

const metadata = {
  title: 'Past Events',
  description: 'Past tech events and meetups in Aarhus, Denmark',
}
---

<Layout {metadata} heading="past events in Aarhus">
  <Board events={await getEvents()} past={true} />
</Layout>
