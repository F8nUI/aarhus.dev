---
import Layout from '@layouts/Layout.astro'
import EventList from '@components/EventList.astro'
import { getEvents } from '@lib/event'

const metadata = {
  title: 'Past Events',
  description: 'Past tech events and meetups in Aarhus, Denmark',
}
---

<Layout {metadata}>
  <EventList events={await getEvents()} past />
</Layout>
