---
// Any address with no page behind it: Vercel serves this (dist/404.html) with status
// 404, for /da/… addresses too, so it says so in English and then in Danish, with the
// way into each version. Kept out of search results and link previews (Layout's notFound).
import Layout from '@layouts/Layout.astro'
import TextPage from '@components/TextPage.astro'
import { localPath, t, type Lang } from '@lib/i18n'

const en = t('en')
const da = t('da')
const links = (lang: Lang) => {
  const w = t(lang)
  return [
    { href: localPath(lang, '/'), label: w.seeUpcoming },
    { href: localPath(lang, '/past'), label: w.pastEvents },
    { href: localPath(lang, '/add-event'), label: w.addAnEvent },
  ]
}
---

<Layout metadata={{ title: en.notFoundTitle, description: en.notFoundText }} notFound>
  <TextPage title={en.notFoundTitle} description={en.notFoundText}>
    <ul class="nf-links">
      {links('en').map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <section lang="da">
      <h2>{da.notFoundTitle}</h2>
      <p>{da.notFoundText}</p>
      <ul class="nf-links">
        {links('da').map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </section>
  </TextPage>
</Layout>
