---
// About: what the site is (src/content/about.md, Danish in da/), the numbers, how to
// follow along and add an event, and every community with its next event.
import Layout from '@layouts/Layout.astro'
import TextPage from '@components/TextPage.astro'
import Communities from '@components/about/Communities.astro'
import Numbers from '@components/about/Numbers.astro'
import { getEntry, render } from 'astro:content'
import { langOf } from '@lib/i18n'

// the Danish text lives in src/content/da/
const id = langOf(Astro.url) === 'da' ? 'da/about' : 'about'
const entry = (await getEntry('pages', id))!
const { Content } = await render(entry)
const { title, description } = entry.data
---

<Layout metadata={{ title, description }}>
  <TextPage {title} {description}>
    <Numbers slot="lead" />
    <Content />
    <Communities slot="after" />
  </TextPage>
</Layout>
