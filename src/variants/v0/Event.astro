---
import { formatLong, type ADEvent } from '@lib/event'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, venue, learnMoreURL } = event.data
const when = formatLong(event)
---

<h1 class="text-2xl md:text-3xl font-semibold leading-tight">{title}</h1>
{subtitle && <p class="mt-1" style="color: var(--color-text-muted);">{subtitle}</p>}
<div class="mt-3 text-sm flex flex-col gap-1" style="color: var(--color-text-muted);">
  <span>
    Organized by <a href={`/organizer/${event.organizer.id}`}>{event.organizer.data.name}</a>
  </span>
  <p>{when.date}, {when.time}</p>
  <p>{venue?.address ?? 'Venue TBA'}</p>
</div>
<a class="cta mt-4 text-sm" href={learnMoreURL}>Attend / Learn more &rarr;</a>
<div class="h-px my-6 w-full" style="background-color: var(--color-border);"></div>
<div class="prose">
  <slot />
</div>
