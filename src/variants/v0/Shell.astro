---
// The current design: header with topic links, sticky footer.
import Header from '@components/Header.astro'

interface Props {
  topic?: string
  topics: string[]
}

const { topic, topics } = Astro.props
---

<div class="font-mono text-xl max-w-5xl mx-auto px-4 min-h-screen flex flex-col overflow-x-clip">
  <header class="py-4">
    <Header {topic} {topics} />
  </header>
  <main class="flex-1 pb-8">
    <slot />
  </main>
  <footer
    class="py-6 border-t mt-auto sticky bottom-0 bg-[var(--color-bg)] -mx-3 px-3"
    style="border-color: var(--color-border);"
  >
    <div class="flex items-center justify-between text-sm" style="color: var(--color-text-muted);">
      <span>aarhus.dev</span>
      <nav class="flex space-x-4">
        <a class="no-underline hover:underline" href="https://github.com/f8nui/aarhus.dev">GitHub</a>
        <a class="no-underline hover:underline" href="/about">About</a>
      </nav>
    </div>
  </footer>
</div>

<style is:global>
  [data-variant-block='v0'] .v-page-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  [data-variant-block='v0'] .v-page-header h1 {
    font-weight: 600;
    font-size: 1.875rem;
  }
  [data-variant-block='v0'] .v-page-description,
  [data-variant-block='v0'] .v-page-website {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
