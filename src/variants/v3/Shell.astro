---
// Calendar Wall: the page frame. Wordmark, topic row with the colors the wall
// uses, footer. Tokens, text pages (.v-page) and Markdown (.prose) are styled here.
import { calendarFeed, topicColor, topicName } from '../shared'

interface Props {
  topic?: string
  topics: string[]
}

const { topic, topics } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
const sorted = [...topics].sort()

// aria-current: "page" on the link to this very page, "true" when the page sits under that topic.
const current = (href: string, active: boolean) => (path === href ? 'page' : active ? 'true' : undefined)
const allActive = !topic && (path === '/' || path === '/past')
---

<div class="v3">
  <header class="v3-head">
    <div class="v3-bar">
      <a class="v3-brand" href="/">aarhus.dev</a>
      <nav class="v3-tools" aria-label="Site">
        <a href="/add-event">Add event</a>
        <a href={calendarFeed.webcal}>Subscribe</a>
        <button class="theme-toggle v3-theme" type="button" aria-label="Switch light or dark theme">
          <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
          <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4.5"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
        </button>
      </nav>
    </div>
    <nav class="v3-topics" aria-label="Topics">
      <a href="/" aria-current={current('/', allActive)}>All topics</a>
      {
        sorted.map((t) => (
          <a href={`/${t}`} aria-current={current(`/${t}`, t === topic)} style={`--c: ${topicColor(t)}`}>
            <span class="v3-tdot" aria-hidden="true" />
            {topicName(t)}
          </a>
        ))
      }
    </nav>
  </header>

  <main class="v3-main">
    <slot />
  </main>

  <footer class="v3-foot">
    <p>aarhus.dev is a community timetable of tech events in and around Aarhus. Anyone can add one.</p>
    <nav aria-label="Footer">
      <a href="/about">About</a>
      <a href="/add-event">Add event</a>
      <a href="https://github.com/f8nui/aarhus.dev">GitHub</a>
      <a href={calendarFeed.webcal}>Subscribe</a>
      <a href={calendarFeed.https}>Calendar feed (.ics)</a>
    </nav>
  </footer>
</div>

<style is:global>
  /* ---------- Tokens: light is ruled paper, dark is a lit board of tiles ---------- */
  :root[data-variant='v3'] {
    color-scheme: light;
    --color-bg: #fbfbfc;
    --color-bg-subtle: #eef1f5;
    --color-text: #172036;
    --color-text-muted: #556079;
    --color-border: #d4d9e2;
    --v3-red: #c8102e;
    --v3-cell: #ffffff;
    --v3-cell-out: transparent;
    --v3-cell-past: #f5f6f9;
    --v3-slash: #c9cfda;
    --v3-line: 1px;
    --v3-gap: 0px;
    --v3-radius: 0px;
    --v3-today: #172036;
    --v3-today-ink: #ffffff;
    --v3-dot-ring: rgb(23 32 54 / 0.22);
    --v3-dot-mix: black;
    --v3-dot-amount: 0%;
    --v3-focus: #1f4fd6;
    --v3-button: #172036;
    --v3-button-ink: #ffffff;
  }
  :root[data-variant='v3'][data-theme='dark'] {
    color-scheme: dark;
    --color-bg: #0d1322;
    --color-bg-subtle: #172036;
    --color-text: #e8ecf4;
    --color-text-muted: #9aa5bc;
    --color-border: #27324c;
    --v3-red: #ff7385;
    --v3-cell: #151d31;
    --v3-cell-out: transparent;
    --v3-cell-past: transparent;
    --v3-slash: transparent;
    --v3-line: 0px;
    --v3-gap: 4px;
    --v3-radius: 8px;
    --v3-today: #ffd76a;
    --v3-today-ink: #0d1322;
    --v3-dot-ring: transparent;
    --v3-dot-mix: white;
    --v3-dot-amount: 30%;
    --v3-focus: #8db4ff;
    --v3-button: #ffd76a;
    --v3-button-ink: #0d1322;
  }
  @media (prefers-color-scheme: dark) {
    :root[data-variant='v3']:not([data-theme='light']) {
      color-scheme: dark;
      --color-bg: #0d1322;
      --color-bg-subtle: #172036;
      --color-text: #e8ecf4;
      --color-text-muted: #9aa5bc;
      --color-border: #27324c;
      --v3-red: #ff7385;
      --v3-cell: #151d31;
      --v3-cell-out: transparent;
      --v3-cell-past: transparent;
      --v3-slash: transparent;
      --v3-line: 0px;
      --v3-gap: 4px;
      --v3-radius: 8px;
      --v3-today: #ffd76a;
      --v3-today-ink: #0d1322;
      --v3-dot-ring: transparent;
      --v3-dot-mix: white;
      --v3-dot-amount: 30%;
      --v3-focus: #8db4ff;
      --v3-button: #ffd76a;
      --v3-button-ink: #0d1322;
    }
  }

  /* ---------- Frame ---------- */
  [data-variant-block='v3'] {
    .v3 {
      font-family: 'Outfit', ui-sans-serif, system-ui, sans-serif;
      font-size: 1rem;
      line-height: 1.5;
      max-width: 82rem;
      margin: 0 auto;
      padding: 0 clamp(1rem, 3.5vw, 2.5rem);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: clip;
    }
    a {
      color: inherit;
      text-underline-offset: 0.18em;
      text-decoration-thickness: 1px;
    }
    a:hover {
      color: inherit;
      text-decoration-thickness: 2px;
    }
    :focus-visible {
      outline: 2px solid var(--v3-focus);
      outline-offset: 2px;
      border-radius: 3px;
    }

    /* A topic's color, nudged lighter on the dark board so .NET purple and Python blue still read. */
    [style*='--c'] {
      --cc: color-mix(in oklab, var(--c, var(--color-text-muted)), var(--v3-dot-mix) var(--v3-dot-amount));
    }
    .v3-tdot {
      display: inline-block;
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      background: var(--cc);
      box-shadow: 0 0 0 1px var(--v3-dot-ring);
      flex: none;
    }

    .v3-head {
      padding: 1.25rem 0 1.5rem;
    }
    .v3-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }
    .v3-brand {
      font-size: 1.375rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-decoration: none;
    }
    .v3-tools {
      display: flex;
      align-items: center;
      gap: 0.25rem 1.25rem;
      font-size: 0.9375rem;
    }
    .v3-tools a {
      text-decoration: none;
      color: var(--color-text-muted);
      padding: 0.25rem 0;
    }
    .v3-tools a:hover {
      color: var(--color-text);
      text-decoration: underline;
    }
    .v3-theme {
      display: inline-grid;
      place-items: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 50%;
      border: 1px solid var(--color-border);
      color: var(--color-text);
      cursor: pointer;
    }
    .v3-theme:hover {
      background: var(--color-bg-subtle);
    }

    .v3-topics {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      margin-top: 1rem;
      font-size: 0.875rem;
    }
    .v3-topics a {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      text-decoration: none;
      color: var(--color-text);
      white-space: nowrap;
    }
    .v3-topics a:hover {
      background: var(--color-bg-subtle);
    }
    .v3-topics a[aria-current] {
      background: var(--color-text);
      border-color: var(--color-text);
      color: var(--color-bg);
      font-weight: 600;
    }

    .v3-main {
      flex: 1;
      min-width: 0;
      padding-bottom: 4rem;
    }

    .v3-foot {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: baseline;
      gap: 0.75rem 2rem;
      padding: 1.5rem 0 2.5rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }
    .v3-foot p {
      max-width: 34rem;
    }
    .v3-foot nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.25rem;
    }

    /* ---------- Text pages: About, Add event, organizers ---------- */
    .v-page {
      max-width: 44rem;
    }
    .v-page-header {
      margin-bottom: 2rem;
    }
    .v-page-header h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.025em;
      text-wrap: balance;
    }
    .v-page-description {
      margin-top: 0.75rem;
      font-size: 1.1875rem;
      color: var(--color-text-muted);
      text-wrap: pretty;
    }
    .v-page-website {
      display: inline-block;
      margin-top: 0.75rem;
      font-weight: 500;
    }

    .prose {
      font-size: 1.0625rem;
      line-height: 1.65;
      max-width: 40rem;
      overflow-wrap: break-word;
    }
    .prose > :first-child {
      margin-top: 0;
    }
    .prose h1,
    .prose h2,
    .prose h3 {
      font-weight: 600;
      letter-spacing: -0.015em;
      line-height: 1.2;
    }
    .prose h1 {
      font-size: 1.75rem;
      margin: 2.25rem 0 0.75rem;
    }
    .prose h2 {
      font-size: 1.4rem;
      margin: 2.25rem 0 0.6rem;
    }
    .prose h3 {
      font-size: 1.15rem;
      margin: 1.75rem 0 0.5rem;
    }
    .prose p {
      margin: 0 0 0.9rem;
    }
    .prose ul,
    .prose ol {
      margin: 0 0 1rem;
      padding-left: 1.4rem;
    }
    .prose ul {
      list-style: disc;
    }
    .prose ol {
      list-style: decimal;
    }
    .prose li {
      margin-bottom: 0.35rem;
      padding-left: 0.2rem;
    }
    .prose li::marker {
      color: var(--color-text-muted);
    }
    .prose strong {
      font-weight: 600;
    }
    .prose code {
      font-family: 'JetBrains Mono', ui-monospace, Menlo, monospace;
      font-size: 0.84em;
      padding: 0.1em 0.35em;
      border-radius: 4px;
      background: var(--color-bg-subtle);
    }
    .prose pre {
      max-width: 100%;
      overflow-x: auto;
      margin: 0 0 1.25rem;
      padding: 1rem 1.15rem;
      border-radius: 10px;
      background: var(--color-bg-subtle);
      font-size: 0.9375rem;
      line-height: 1.55;
    }
    .prose pre code {
      padding: 0;
      background: none;
      font-size: 0.84em;
    }
    .prose blockquote {
      margin: 0 0 1rem;
      padding-left: 1rem;
      border-left: 3px solid var(--color-border);
      color: var(--color-text-muted);
    }
    .prose hr {
      border: 0;
      border-top: 1px solid var(--color-border);
      margin: 2rem 0;
    }

    @media (max-width: 639px) {
      .v3-head {
        padding: 1rem 0 1.25rem;
      }
      .v3-tools {
        gap: 0.25rem 0.9rem;
        font-size: 0.875rem;
      }
      .v3-topics {
        gap: 0.3rem;
        font-size: 0.8125rem;
      }
      .v3-topics a {
        padding: 0.25rem 0.6rem;
      }
    }
  }
</style>
