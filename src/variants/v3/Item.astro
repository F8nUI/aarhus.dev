---
// One agenda row: the date line, the title, and who hosts it where.
import type { ADEvent } from '@lib/event'
import { eventAttrs, relativeAtBuild, topicColor, topicName } from '../shared'
import { dateLine, datetimeOf, eventDays, hostLine } from './cal'

interface Props {
  event: ADEvent
  /** Hide the topic tag on a page that is already about one topic. */
  showTopic?: boolean
}

const { event, showTopic = true } = Astro.props
---

<li class="v3-item" {...eventAttrs(event)} data-days={eventDays(event).join(' ')} style={`--c: ${topicColor(event.topic)}`}>
  <a class="v3-item-link" href={event.url}>
    <span class="v3-item-when">
      <time datetime={datetimeOf(event)}>{dateLine(event)}</time>
      <span class="v3-rel" data-rel>{relativeAtBuild(event)}</span>
    </span>
    <span class="v3-item-title">{event.data.title}</span>
    <span class="v3-item-host">
      {
        showTopic && (
          <span class="v3-tag">
            <span class="v3-tdot" aria-hidden="true" />
            {topicName(event.topic)}
          </span>
        )
      }
      <span>{hostLine(event)}</span>
    </span>
  </a>
</li>
