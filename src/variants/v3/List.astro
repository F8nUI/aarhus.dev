---
// Board + Ticket: the Departure Board, with the highlighted event as a big amber ticket above it.
import type { ADEvent } from '@lib/event'
import Board from '../v1/List.astro'
import Ticket from './Ticket.astro'

interface Props {
  events: ADEvent[]
  topic?: string
  past: boolean
}
---

<Board {...Astro.props} Head={Ticket} />
