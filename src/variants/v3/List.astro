---
// Calendar Wall: the month grid (with Danish week numbers and red Sundays) and,
// beside it, the agenda of what's coming up. The archive gets a year wall and
// the list, newest first.
import type { ADEvent } from '@lib/event'
import { calendarFeed, eventAttrs, formatMonth, groupBy, topicColor, topicName } from '../shared'
import { addMonths, dayKey, dayLabel, eventDays, monthLabel, monthWeeks, shortTitle } from './cal'
import Item from './Item.astro'
import YearWall from './YearWall.astro'

interface Props {
  events: ADEvent[]
  topic?: string
  past: boolean
}

const { events, topic, past } = Astro.props

const now = Date.now()
const thisMonth = dayKey(now).slice(0, 7)
const name = topic ? topicName(topic) : undefined
const pastHref = topic ? `/past/${topic}` : '/past'
const upcomingHref = topic ? `/${topic}` : '/'
const pastAtBuild = events.filter((e) => e.end.valueOf() < now).length

// The wall runs from the month before the first upcoming event (or before this
// month, if that's earlier) through the month of the last event.
const firstUpcoming = events.find((e) => e.end.valueOf() >= now)
const startFrom = [firstUpcoming ? dayKey(firstUpcoming.start).slice(0, 7) : thisMonth, thisMonth].sort()[0]
const firstMonth = addMonths(startFrom, -1)
const lastMonth = [thisMonth, ...events.map((e) => dayKey(e.end).slice(0, 7))].sort().at(-1)!
const months: string[] = []
for (let m = firstMonth; m <= lastMonth; m = addMonths(m, 1)) months.push(m)

const byDay = new Map<string, ADEvent[]>()
for (const event of events) for (const key of eventDays(event)) byDay.set(key, [...(byDay.get(key) ?? []), event])

const legend = [
  ...new Set(
    events
      .filter((e) => eventDays(e).some((k) => k.slice(0, 7) >= firstMonth && k.slice(0, 7) <= lastMonth))
      .map((e) => e.topic),
  ),
].sort()

const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun']
// A cell lists up to four events; a fifth folds the last ones into "+2 more".
const MAX_CHIPS = 4
const chipsFor = (day: ADEvent[]) => (day.length > MAX_CHIPS ? day.slice(0, MAX_CHIPS - 1) : day)

const buckets = [
  ['now', 'Happening now'],
  ['today', 'Later today'],
  ['week', 'This week'],
  ['nextweek', 'Next week'],
]
const byMonth = groupBy(events, (e) => formatMonth(e.start))
const archive = groupBy([...events].reverse(), (e) => formatMonth(e.start))
const since = events.length ? formatMonth(events[0].start) : ''
const chevron = (d: string) =>
  `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`
---

{
  !past ? (
    <div class="v3-list">
      <h1 class="v3-title">{name ? `${name} events in Aarhus` : 'Tech events in Aarhus'}</h1>
      <div class="v3-board">
        <div class="v3-wallside">
          <div class="v3-wall" data-wall>
            {months.map((m, i) => (
              <section class="v3-month" data-month={m} aria-label={monthLabel(m)}>
                <header class="v3-month-head">
                  <h2 tabindex="-1">{monthLabel(m)}</h2>
                  <div class="v3-steps">
                    <button type="button" class="v3-step v3-step-today" data-step="today">
                      Today
                    </button>
                    <button
                      type="button"
                      class="v3-step"
                      data-step="-1"
                      disabled={i === 0}
                      aria-label={i > 0 ? `Show ${monthLabel(months[i - 1])}` : 'No earlier month'}
                      set:html={chevron('M15 18l-6-6 6-6')}
                    />
                    <button
                      type="button"
                      class="v3-step"
                      data-step="1"
                      disabled={i === months.length - 1}
                      aria-label={i < months.length - 1 ? `Show ${monthLabel(months[i + 1])}` : 'No later month'}
                      set:html={chevron('M9 18l6-6-6-6')}
                    />
                  </div>
                </header>
                <div class="v3-grid">
                  <span class="v3-wd v3-wk" aria-hidden="true">
                    wk
                  </span>
                  {weekdays.map((d, j) => (
                    <span class="v3-wd" data-sun={j === 6 ? '' : undefined} aria-hidden="true">
                      {d}
                    </span>
                  ))}
                  {monthWeeks(m).map((week, wi, all) => (
                    <>
                      <span class="v3-wk" aria-hidden="true">
                        {week.week}
                      </span>
                      {week.days.map((d, j) => {
                        const day = d.inMonth ? (byDay.get(d.key) ?? []) : []
                        return (
                          <div
                            class="v3-day"
                            data-date={d.inMonth ? d.key : undefined}
                            data-out={d.inMonth ? undefined : ''}
                            data-sun={j === 6 ? '' : undefined}
                            data-last={wi === all.length - 1 ? '' : undefined}
                            data-has={day.length ? '' : undefined}
                          >
                            {d.inMonth &&
                              (day.length ? (
                                <button
                                  type="button"
                                  class="v3-num"
                                  aria-pressed="false"
                                  aria-label={`${dayLabel(d.key)}, ${day.length} ${day.length === 1 ? 'event' : 'events'}`}
                                >
                                  {d.day}
                                </button>
                              ) : (
                                <span class="v3-num" aria-hidden="true">
                                  {d.day}
                                </span>
                              ))}
                            {day.length > 0 && (
                              <ul class="v3-chips">
                                {chipsFor(day).map((e) => (
                                  <li>
                                    <a
                                      class="v3-chip"
                                      href={e.url}
                                      title={`${e.data.startTime ?? 'Time TBA'} ${e.data.title}`}
                                      style={`--c: ${topicColor(e.topic)}`}
                                      {...eventAttrs(e)}
                                    >
                                      <span class="v3-cdot" aria-hidden="true" />
                                      <span class="v3-ctime">{e.data.startTime ?? 'TBA'}</span>
                                      <span class="v3-ctitle">{shortTitle(e.data.title)}</span>
                                    </a>
                                  </li>
                                ))}
                                {day.length > MAX_CHIPS && (
                                  <li class="v3-more" aria-hidden="true">
                                    +{day.length - MAX_CHIPS + 1} more
                                  </li>
                                )}
                              </ul>
                            )}
                            {day.length > 0 && (
                              <span class="v3-dots" aria-hidden="true">
                                {day.slice(0, 4).map((e) => (
                                  <span class="v3-tdot" style={`--c: ${topicColor(e.topic)}`} />
                                ))}
                              </span>
                            )}
                          </div>
                        )
                      })}
                    </>
                  ))}
                </div>
              </section>
            ))}
            <p class="v3-status" aria-live="polite" data-status />
          </div>
          {legend.length > 1 && (
            <ul class="v3-legend" aria-label="Topic colors">
              {legend.map((t) => (
                <li style={`--c: ${topicColor(t)}`}>
                  <span class="v3-tdot" aria-hidden="true" />
                  {topicName(t)}
                </li>
              ))}
            </ul>
          )}
        </div>

        <div class="v3-agenda" data-agenda>
          <h2 class="v3-agenda-title">Coming up</h2>
          {buckets.map(([tag, label]) => (
            <section class="v3-bucket" data-bucket={tag}>
              <h3 class="v3-bucket-title">{label}</h3>
              <ol class="v3-items">
                {events.map((event) => (
                  <Item {event} showTopic={!topic} />
                ))}
              </ol>
            </section>
          ))}
          <section class="v3-bucket" data-bucket="later">
            <h3 class="v3-bucket-title">Later</h3>
            {byMonth.map((group) => (
              <div class="v3-later" data-group>
                <h4 class="v3-later-title">{group.key}</h4>
                <ol class="v3-items">
                  {group.items.map((event) => (
                    <Item {event} showTopic={!topic} />
                  ))}
                </ol>
              </div>
            ))}
          </section>
          <div class="v3-empty" data-empty="upcoming">
            <p class="v3-empty-title">No upcoming {name} events yet.</p>
            <p>
              Know of one in Aarhus? <a href="/add-event">Add event</a>
            </p>
          </div>
          <div class="v3-agenda-foot">
            <a class="v3-pastlink" href={pastHref}>
              Past {name} events <span class="v3-count" data-count="past">{pastAtBuild}</span>
            </a>
            <p>
              Every event in your calendar app: <a href={calendarFeed.webcal}>Subscribe</a> or copy the{' '}
              <a href={calendarFeed.https}>feed link</a>.
            </p>
            <p>
              Missing something? <a href="/add-event">Add event</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  ) : (
    <div class="v3-list v3-archive">
      <h1 class="v3-title">{name ? `Past ${name} events` : 'Past events'}</h1>
      <p class="v3-lede">
        <span data-count="past">{pastAtBuild}</span> events since {since}. <a href={upcomingHref}>See what’s coming up</a>
      </p>
      <YearWall {events} />
      <div class="v3-archive-list" data-bucket="past">
        {archive.map((group) => (
          <section class="v3-month-list" data-group>
            <h2 class="v3-month-list-title">{group.key}</h2>
            <ol class="v3-items">
              {group.items.map((event) => (
                <Item {event} showTopic={!topic} />
              ))}
            </ol>
          </section>
        ))}
      </div>
      <p class="v3-empty" data-empty="past">
        No past {name} events yet.
      </p>
    </div>
  )
}
<script is:inline>
  // Calendar Wall: marks past days and today by the visitor's clock (Aarhus
  // calendar days), shows one month at a time, and lets a day be picked to
  // find its events in the agenda. Touches only this variant's list.
  ;(function () {
    var root = document.currentScript.previousElementSibling
    if (!root || !root.classList.contains('v3-list')) return
    var now = window.aarhusNow ? window.aarhusNow() : Date.now()
    var today = new Date(now).toLocaleDateString('en-CA', { timeZone: 'Europe/Copenhagen' })
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    root.querySelectorAll('[data-date]').forEach(function (cell) {
      var d = cell.getAttribute('data-date')
      cell.removeAttribute('aria-current')
      if (d < today) cell.setAttribute('data-past', '')
      else if (d === today) {
        cell.setAttribute('data-today', '')
        cell.setAttribute('aria-current', 'date')
      } else cell.setAttribute('data-future', '')
    })

    // The year wall on the archive: start scrolled to the most recent weeks.
    var years = root.querySelector('.v3-years')
    if (years) years.scrollLeft = years.scrollWidth

    var wall = root.querySelector('[data-wall]')
    if (!wall) return
    var months = Array.prototype.slice.call(wall.querySelectorAll('[data-month]'))
    var agenda = root.querySelector('[data-agenda]')
    var status = wall.querySelector('[data-status]')
    var month = today.slice(0, 7)
    var home = 0
    months.forEach(function (m, i) {
      if (m.getAttribute('data-month') <= month) home = i
    })
    var shown = home

    function show(i) {
      shown = Math.max(0, Math.min(months.length - 1, i))
      months.forEach(function (m, j) {
        m.hidden = j !== shown
      })
      wall.querySelectorAll('[data-step="today"]').forEach(function (b) {
        b.hidden = shown === home
      })
    }
    wall.setAttribute('data-js', '')
    show(home)

    function pick(cell) {
      var again = cell.hasAttribute('data-picked')
      root.querySelectorAll('[data-picked]').forEach(function (el) {
        el.removeAttribute('data-picked')
      })
      wall.querySelectorAll('.v3-num[aria-pressed="true"]').forEach(function (b) {
        b.setAttribute('aria-pressed', 'false')
      })
      status.textContent = ''
      if (again) return
      var button = cell.querySelector('.v3-num')
      var label = button.getAttribute('aria-label').split(',')[0]
      cell.setAttribute('data-picked', '')
      button.setAttribute('aria-pressed', 'true')
      var key = cell.getAttribute('data-date')
      var items = Array.prototype.filter.call(agenda.querySelectorAll('[data-days~="' + key + '"]'), function (el) {
        return el.getClientRects().length > 0
      })
      if (!items.length) {
        status.textContent = label + ' is over. Its events are with the '
        var link = document.createElement('a')
        link.href = root.querySelector('.v3-pastlink').getAttribute('href')
        link.textContent = 'past events'
        status.append(link, '.')
        return
      }
      items.forEach(function (el) {
        el.setAttribute('data-picked', '')
      })
      status.textContent = label + ': ' + items.length + (items.length === 1 ? ' event' : ' events') + ', marked in the list.'
      var beside = agenda.getBoundingClientRect().left >= wall.getBoundingClientRect().right
      items[0].scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: beside ? 'nearest' : 'start' })
    }

    wall.addEventListener('click', function (e) {
      var step = e.target.closest('[data-step]')
      if (step) {
        var s = step.getAttribute('data-step')
        show(s === 'today' ? home : shown + Number(s))
        // Keep focus on the same control in the month now showing.
        var next = months[shown].querySelector('[data-step="' + s + '"]')
        if (next && !next.disabled && !next.hidden) next.focus()
        else months[shown].querySelector('h2').focus()
        return
      }
      var num = e.target.closest('button.v3-num')
      if (num) pick(num.closest('[data-date]'))
    })
  })()
</script>

<style is:global>
  [data-variant-block='v3'] {
    .v3-title {
      font-size: 1.125rem;
      font-weight: 500;
      color: var(--color-text-muted);
      margin: 0.25rem 0 1.5rem;
    }

    /* ---------- Board: wall left, agenda right ---------- */
    .v3-board {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }
    @media (min-width: 1100px) {
      .v3-board {
        grid-template-columns: minmax(0, 1fr) clamp(19rem, 27vw, 25rem);
        align-items: start;
        gap: 3.5rem;
      }
    }
    @media (min-width: 1100px) and (min-height: 760px) {
      .v3-wallside {
        position: sticky;
        top: 1.5rem;
      }
    }

    /* ---------- The wall ---------- */
    .v3-wall:not([data-js]) .v3-month + .v3-month {
      margin-top: 3.5rem;
    }
    .v3-month[hidden] {
      display: none;
    }
    .v3-month-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .v3-month-head h2 {
      font-size: clamp(1.75rem, 4vw, 3rem);
      font-weight: 300;
      line-height: 1;
      letter-spacing: -0.035em;
      font-variant-numeric: tabular-nums;
    }
    .v3-month-head h2:focus {
      outline: none;
    }
    .v3-month-head h2:focus-visible {
      outline: 2px solid var(--v3-focus);
    }
    .v3-steps {
      display: flex;
      gap: 0.375rem;
      flex: none;
    }
    .v3-wall:not([data-js]) .v3-steps {
      display: none;
    }
    .v3-step {
      display: inline-grid;
      place-items: center;
      height: 2.5rem;
      min-width: 2.5rem;
      padding: 0;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background: transparent;
      color: inherit;
      font: inherit;
      font-size: 0.9375rem;
      font-weight: 500;
      cursor: pointer;
    }
    .v3-step-today {
      padding: 0 1rem;
    }
    .v3-step[hidden] {
      display: none;
    }
    .v3-step:hover:not(:disabled) {
      background: var(--color-bg-subtle);
    }
    .v3-step:disabled {
      opacity: 0.35;
      cursor: default;
    }

    .v3-grid {
      display: grid;
      grid-template-columns: 1.9rem repeat(7, minmax(0, 1fr));
      gap: var(--v3-gap);
    }
    .v3-wd {
      padding: 0 0 0.5rem 0.55rem;
      font-size: 0.8125rem;
      font-weight: 500;
      color: var(--color-text-muted);
    }
    .v3-wd[data-sun] {
      color: var(--v3-red);
    }
    .v3-wk {
      padding: 0.6rem 0.5rem 0 0;
      font-size: 0.75rem;
      text-align: right;
      color: var(--color-text-muted);
      font-variant-numeric: tabular-nums;
    }
    .v3-wd.v3-wk {
      padding: 0 0.5rem 0.5rem 0;
      font-weight: 400;
    }

    .v3-day {
      position: relative;
      min-width: 0;
      min-height: 5.6rem;
      padding: 0.5rem 0.55rem 0.55rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      background: var(--v3-cell);
      border-top: var(--v3-line) solid var(--color-border);
      border-left: var(--v3-line) solid var(--color-border);
      border-radius: var(--v3-radius);
    }
    .v3-day[data-sun] {
      border-right: var(--v3-line) solid var(--color-border);
    }
    .v3-day[data-last] {
      border-bottom: var(--v3-line) solid var(--color-border);
    }
    .v3-day[data-out] {
      background: var(--v3-cell-out);
    }

    .v3-num {
      display: inline-grid;
      place-items: center;
      align-self: flex-start;
      min-width: 2.5rem;
      height: 2.5rem;
      margin: -0.3rem 0 0 -0.4rem;
      padding: 0 0.3rem;
      border: 0;
      border-radius: 999px;
      background: none;
      color: inherit;
      font: inherit;
      font-size: 1.625rem;
      font-weight: 250;
      line-height: 1;
      letter-spacing: -0.02em;
      font-variant-numeric: tabular-nums;
    }
    .v3-day[data-has] .v3-num {
      font-weight: 600;
    }
    .v3-day[data-sun] .v3-num {
      color: var(--v3-red);
    }
    button.v3-num {
      cursor: pointer;
    }
    /* The whole cell picks the day; the event links sit above this layer. */
    button.v3-num::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: var(--v3-radius);
    }
    button.v3-num:focus-visible {
      outline: none;
    }
    .v3-day:has(button.v3-num:focus-visible) {
      outline: 2px solid var(--v3-focus);
      outline-offset: -1px;
      z-index: 2;
    }
    .v3-day:has(button.v3-num):hover {
      background: color-mix(in oklab, var(--v3-cell), var(--color-text) 4%);
    }

    .v3-day[data-today] .v3-num {
      background: var(--v3-today);
      color: var(--v3-today-ink);
    }
    .v3-day[data-today] {
      box-shadow: inset 0 0 0 1.5px var(--v3-today);
    }

    /* Days that are over: dimmed, and on paper crossed off like a wall calendar. */
    .v3-day[data-past] {
      background: var(--v3-cell-past);
    }
    .v3-day[data-past] .v3-num,
    .v3-day[data-past] .v3-chips,
    .v3-day[data-past] .v3-dots {
      opacity: 0.45;
    }
    .v3-day[data-past]::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        to top right,
        transparent calc(50% - 0.75px),
        var(--v3-slash) 50%,
        transparent calc(50% + 0.75px)
      );
    }

    .v3-day[data-picked] {
      box-shadow: inset 0 0 0 2px var(--color-text);
      z-index: 1;
    }

    .v3-chips {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-width: 0;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .v3-chip {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      min-width: 0;
      margin: 0 -0.3rem;
      padding: 0.1rem 0.3rem;
      border-radius: 4px;
      font-size: 0.75rem;
      line-height: 1.3;
      white-space: nowrap;
      text-decoration: none;
    }
    .v3-chip:hover {
      background: color-mix(in oklab, var(--cc), transparent 78%);
    }
    .v3-chip:hover .v3-ctitle {
      text-decoration: underline;
    }
    .v3-cdot {
      width: 0.45rem;
      height: 0.45rem;
      flex: none;
      border-radius: 50%;
      background: var(--cc);
      box-shadow: 0 0 0 1px var(--v3-dot-ring);
    }
    .v3-ctime {
      display: none;
      flex: none;
      color: var(--color-text-muted);
      font-variant-numeric: tabular-nums;
    }
    .v3-ctitle {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      font-weight: 500;
    }
    .v3-day {
      container-type: inline-size;
    }
    @container (min-width: 8.5rem) {
      .v3-ctime {
        display: inline;
      }
    }
    .v3-more {
      font-size: 0.75rem;
      color: var(--color-text-muted);
      padding-left: 0.75rem;
    }
    .v3-dots {
      display: none;
    }

    .v3-status {
      margin-top: 0.875rem;
      font-size: 0.9375rem;
      color: var(--color-text-muted);
    }
    .v3-status:empty {
      display: none;
    }

    .v3-legend {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1.1rem;
      margin: 1rem 0 0;
      padding: 0;
      list-style: none;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
    }
    .v3-legend li {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }

    /* "Happening now": a beat in the dot. */
    .v3-chip[data-when~='now'] .v3-cdot,
    .v3-bucket[data-bucket='now'] .v3-bucket-title::before {
      animation: v3-pulse 1.8s ease-out infinite;
    }
    .v3-chip[data-when~='now'] .v3-cdot {
      --pulse: var(--cc);
    }
    .v3-bucket[data-bucket='now'] .v3-bucket-title::before {
      --pulse: var(--v3-red);
    }
    @media (prefers-reduced-motion: reduce) {
      .v3-chip[data-when~='now'] .v3-cdot,
      .v3-bucket[data-bucket='now'] .v3-bucket-title::before {
        animation: none;
      }
    }

    /* ---------- Agenda ---------- */
    /* Sits on the month name's line, a size down: the wall leads. */
    .v3-agenda-title {
      display: flex;
      align-items: flex-end;
      min-height: clamp(1.75rem, 4vw, 3rem);
