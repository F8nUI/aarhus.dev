---
// Calendar Wall: an event page. The facts (When, Where, Organizer) and the
// sign-up button first; beside them a small month page with the day marked and
// whatever else is on the wall that month, so a clash shows at a glance.
import { getEvents, type ADEvent } from '@lib/event'
import {
  editUrl,
  eventAttrs,
  formatLong,
  googleCalendarUrl,
  icsFileName,
  icsHref,
  linkHost,
  mapUrl,
  relativeAtBuild,
  topicColor,
  topicName,
} from '../shared'
import { dayLabel, datetimeOf, eventDays, monthLabel, monthWeeks } from './cal'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, venue, learnMoreURL } = event.data
const when = formatLong(event)
const days = eventDays(event)
const month = days[0].slice(0, 7)

// The rest of the wall that month, for the dots, and the events sharing this day.
const others = (await getEvents()).filter((e) => e.id !== event.id)
const othersByDay = new Map<string, ADEvent[]>()
for (const e of others)
  for (const key of eventDays(e)) if (key.slice(0, 7) === month) othersByDay.set(key, [...(othersByDay.get(key) ?? []), e])
const sameDay = others.filter((e) => eventDays(e).some((key) => days.includes(key)))
const weekdays = ['M', 'T', 'W', 'T', 'F', 'S', 'S']
---

<article class="v3-event" {...eventAttrs(event)} style={`--c: ${topicColor(event.topic)}`}>
  <p class="v3-ended">
    <span>This event has ended.</span>
    <a href={`/${event.topic}`}>Upcoming {topicName(event.topic)} events</a>
  </p>

  <header class="v3-ev-head">
    <a class="v3-ev-topic" href={`/${event.topic}`}>
      <span class="v3-tdot" aria-hidden="true"></span>{topicName(event.topic)}
    </a>
    <h1>{title}</h1>
    {subtitle && <p class="v3-ev-sub">{subtitle}</p>}
  </header>

  <div class="v3-ev-body">
    <dl class="v3-facts">
      <div class="v3-fact">
        <dt>When</dt>
        <dd>
          <time class="v3-fact-main" datetime={datetimeOf(event)}>{when.date}</time>
          <span class="v3-fact-sub">
            {when.time}
            <span class="v3-rel" data-rel>{relativeAtBuild(event)}</span>
          </span>
        </dd>
      </div>
      <div class="v3-fact">
        <dt>Where</dt>
        <dd>
          {
            venue ? (
              <>
                <span class="v3-fact-main">{venue.title}</span>
                <a class="v3-fact-sub" href={mapUrl(event)}>
                  {venue.address}
                </a>
              </>
            ) : (
              <span class="v3-fact-main">Venue TBA</span>
            )
          }
        </dd>
      </div>
      <div class="v3-fact">
        <dt>Organizer</dt>
        <dd>
          <a class="v3-fact-main" href={`/organizer/${event.organizer.id}`}>{event.organizer.data.name}</a>
        </dd>
      </div>
    </dl>

    <div class="v3-ev-actions">
      <a class="v3-primary" href={learnMoreURL}>Sign up on {linkHost(learnMoreURL)} →</a>
      <div class="v3-secondary">
        <a href={icsHref(event)} download={icsFileName(event)}>Add to calendar (.ics)</a>
        <a href={googleCalendarUrl(event)}>Google Calendar</a>
      </div>
    </div>

    <figure class="v3-mini">
      <div aria-hidden="true">
        <p class="v3-mini-title">{monthLabel(month)}</p>
        <div class="v3-mini-grid">
          <span class="v3-mini-wd v3-mini-wk">wk</span>
          {weekdays.map((d, i) => <span class="v3-mini-wd" data-sun={i === 6 ? '' : undefined}>{d}</span>)}
          {
            monthWeeks(month).map((week) => (
              <>
                <span class="v3-mini-wk">{week.week}</span>
                {week.days.map((d, i) => (
                  <span
                    class="v3-mini-day"
                    data-sun={i === 6 ? '' : undefined}
                    data-mark={d.inMonth && days.includes(d.key) ? '' : undefined}
                  >
                    {d.inMonth ? d.day : ''}
                    {d.inMonth && othersByDay.has(d.key) && (
                      <span class="v3-mini-dots">
                        {othersByDay
                          .get(d.key)!
                          .slice(0, 3)
                          .map((e) => (
                            <span style={`--c: ${topicColor(e.topic)}`} />
                          ))}
                      </span>
                    )}
                  </span>
                ))}
              </>
            ))
          }
        </div>
      </div>
      <figcaption>
        {
          sameDay.length ? (
            <>
              Also on {dayLabel(days[0])}:{' '}
              {sameDay.map((e, i) => (
                <>
                  <a href={e.url}>{e.data.title}</a>
                  {i < sameDay.length - 1 ? ', ' : '.'}
                </>
              ))}
            </>
          ) : (
            <>Nothing else on the calendar that day.</>
          )
        }
      </figcaption>
    </figure>
  </div>

  <div class="v3-ev-desc prose">
    <slot />
  </div>

  <footer class="v3-ev-foot">
    <a href={editUrl(event)}>Edit on GitHub</a>
    <span>Something wrong or out of date? Anyone can propose a fix.</span>
  </footer>
</article>

<style is:global>
  [data-variant-block='v3'] {
    .v3-event {
      max-width: 66rem;
      padding-top: 0.5rem;
    }
    .v3-ended {
      display: none;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      align-items: baseline;
      margin-bottom: 1.75rem;
      padding: 0.8rem 1rem;
      border-radius: 10px;
      background: var(--color-bg-subtle);
      font-weight: 600;
    }
    .v3-ended a {
      font-weight: 400;
    }
    .v3-event[data-when~='past'] .v3-ended {
      display: flex;
    }

    .v3-ev-topic {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      font-size: 0.9375rem;
      font-weight: 500;
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .v3-ev-topic:hover {
      color: var(--color-text);
      text-decoration: underline;
    }
    .v3-ev-head h1 {
      max-width: 24ch;
      margin-top: 0.6rem;
      font-size: clamp(2.125rem, 5.5vw, 3.75rem);
      font-weight: 600;
      line-height: 1.04;
      letter-spacing: -0.035em;
      text-wrap: balance;
    }
    .v3-ev-sub {
      margin-top: 0.6rem;
      font-size: 1.25rem;
      color: var(--color-text-muted);
    }

    .v3-ev-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      margin-top: 2.25rem;
    }
    @media (min-width: 800px) {
      .v3-ev-body {
        grid-template-columns: minmax(0, 1fr) 17.5rem;
        grid-template-areas:
          'facts mini'
          'actions mini';
        column-gap: 4rem;
        align-items: start;
      }
      .v3-facts {
        grid-area: facts;
      }
      .v3-ev-actions {
        grid-area: actions;
      }
      .v3-mini {
        grid-area: mini;
      }
    }

    .v3-facts {
      display: grid;
      gap: 1.25rem;
      margin: 0;
    }
    .v3-fact {
      display: grid;
      grid-template-columns: 6rem minmax(0, 1fr);
      gap: 1rem;
      align-items: baseline;
      padding-top: 1.25rem;
      border-top: 1px solid var(--color-border);
    }
    .v3-fact:first-child {
      border-top: 0;
      padding-top: 0;
    }
    .v3-fact dt {
      font-size: 0.9375rem;
      color: var(--color-text-muted);
    }
    .v3-fact dd {
      display: grid;
      justify-items: start;
      gap: 0.2rem;
      margin: 0;
    }
    .v3-fact-main {
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.3;
    }
    .v3-fact-sub {
      font-size: 1.0625rem;
      font-variant-numeric: tabular-nums;
    }
    .v3-fact .v3-rel {
      display: inline-block;
      margin-left: 0.5rem;
      padding: 0.05rem 0.6rem;
      border-radius: 999px;
      background: var(--color-bg-subtle);
      font-size: 0.875rem;
    }
    .v3-event[data-when~='now'] .v3-fact .v3-rel {
      background: var(--v3-red);
      color: var(--color-bg);
      font-weight: 600;
    }

    .v3-primary {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.85rem 1.4rem;
      border-radius: 10px;
      background: var(--v3-button);
      color: var(--v3-button-ink);
      font-size: 1.0625rem;
      font-weight: 600;
      text-decoration: none;
      text-wrap: balance;
    }
    .v3-primary:hover {
      color: var(--v3-button-ink);
      background: color-mix(in oklab, var(--v3-button), var(--color-bg) 18%);
    }
    /* Over: the sign-up page stays one click away, but no longer calls for it. */
    .v3-event[data-when~='past'] .v3-primary {
      background: transparent;
      color: var(--color-text);
      box-shadow: inset 0 0 0 1px var(--color-border);
    }
    .v3-event[data-when~='past'] .v3-primary:hover {
      background: var(--color-bg-subtle);
    }
    .v3-secondary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      margin-top: 1rem;
      font-size: 0.9375rem;
    }

    .v3-mini {
      max-width: 20rem;
      padding: 1.1rem 1.1rem 1rem;
      border: 1px solid var(--color-border);
      border-radius: 14px;
    }
    .v3-mini-title {
      margin-bottom: 0.75rem;
      font-size: 1.375rem;
      font-weight: 300;
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .v3-mini-grid {
      display: grid;
      grid-template-columns: 1.5rem repeat(7, minmax(0, 1fr));
      gap: 2px;
      font-size: 0.875rem;
      font-variant-numeric: tabular-nums;
      text-align: center;
    }
    .v3-mini-wd {
      padding-bottom: 0.25rem;
      font-size: 0.75rem;
      color: var(--color-text-muted);
    }
    .v3-mini-wd[data-sun],
    .v3-mini-day[data-sun] {
      color: var(--v3-red);
    }
    .v3-mini-wk {
      align-self: center;
      font-size: 0.6875rem;
      color: var(--color-text-muted);
      text-align: left;
    }
    .v3-mini-day {
      position: relative;
      display: grid;
      place-items: center;
      aspect-ratio: 1;
      border-radius: 50%;
    }
    .v3-mini-day[data-mark] {
      background: var(--color-text);
      color: var(--color-bg);
      font-weight: 700;
      box-shadow:
        0 0 0 2px var(--color-bg),
        0 0 0 4px var(--cc);
    }
    .v3-mini-dots {
      position: absolute;
      bottom: 1px;
      left: 0;
      right: 0;
      display: flex;
      justify-content: center;
      gap: 2px;
    }
    .v3-mini-dots span {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--cc);
    }
    .v3-mini-day[data-mark] .v3-mini-dots {
      bottom: -9px;
    }
    .v3-mini figcaption {
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
      line-height: 1.45;
      color: var(--color-text-muted);
    }

    .v3-ev-desc {
      margin-top: 3rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-border);
    }
    .v3-ev-foot {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin-top: 2.5rem;
      font-size: 0.9375rem;
      color: var(--color-text-muted);
    }
    .v3-ev-foot a {
      font-weight: 600;
      color: var(--color-text);
    }
  }
</style>
