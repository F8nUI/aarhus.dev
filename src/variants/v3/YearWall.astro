---
// The past page's year wall: every day since the first event, one column per
// week (Monday on top), days with events filled in their topic's color.
// A picture of the list below it, so it stays out of the accessibility tree.
import type { ADEvent } from '@lib/event'
import { topicColor } from '../shared'
import { addDays, addMonths, dayKey, dayLabelShort, eventDays, weekday } from './cal'

interface Props {
  events: ADEvent[]
}

const { events } = Astro.props

const byDay = new Map<string, ADEvent[]>()
for (const event of events) for (const key of eventDays(event)) byDay.set(key, [...(byDay.get(key) ?? []), event])

// From the week of the first event's month to the end of this month.
const firstOfMonth = events.length ? dayKey(events[0].start).slice(0, 7) + '-01' : dayKey(Date.now()).slice(0, 7) + '-01'
const start = addDays(firstOfMonth, -weekday(firstOfMonth))
const lastDay = addDays(addMonths(dayKey(Date.now()).slice(0, 7), 1) + '-01', -1)
const end = addDays(lastDay, 6 - weekday(lastDay))

const weeks: string[] = []
for (let monday = start; monday <= end; monday = addDays(monday, 7)) weeks.push(monday)

const monthOf = (key: string) =>
  new Date(key + 'T12:00:00Z').toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).replace('Sept', 'Sep')

// A label over the column whose week holds the 1st of a month; January also names the year.
const labels = weeks.flatMap((monday, i) => {
  const first = Array.from({ length: 7 }, (_, d) => addDays(monday, d)).find((k) => k.endsWith('-01'))
  if (!first) return []
  const year = first.slice(5, 7) === '01' || i === 0
  return [{ column: i + 1, text: year ? `${monthOf(first)} ${first.slice(0, 4)}` : monthOf(first), year }]
})

// One color fills the square; several topics on one day share it in stripes.
function fill(day: ADEvent[]): string {
  const colors = [...new Set(day.map((e) => topicColor(e.topic)))]
  if (colors.length === 1) return colors[0]
  const step = 100 / colors.length
  return `linear-gradient(135deg, ${colors.map((c, i) => `${c} ${i * step}% ${(i + 1) * step}%`).join(', ')})`
}

const columns = `grid-template-columns: repeat(${weeks.length}, minmax(0, 1fr))`
---

<figure class="v3-years" aria-hidden="true">
  <div class="v3-yl" style={columns}>
    {
      labels.map((label) => (
        <span style={`grid-column: ${label.column} / span 8`} data-year={label.year ? '' : undefined}>
          {label.text}
        </span>
      ))
    }
  </div>
  <div class="v3-yg" style={columns}>
    {
      weeks.flatMap((monday) =>
        Array.from({ length: 7 }, (_, d) => {
          const key = addDays(monday, d)
          const day = byDay.get(key)
          return day ? (
            <a
              class="v3-yd"
              href={day[0].url}
              tabindex="-1"
              title={`${dayLabelShort(key)}: ${day.map((e) => e.data.title).join(', ')}`}
              data-date={key}
              data-has
              style={`--y: ${fill(day)}`}
            />
          ) : (
            <span class="v3-yd" data-date={key} />
          )
        }),
      )
    }
  </div>
  <figcaption>One square per day, Monday at the top of each week. Colored days had an event.</figcaption>
</figure>
