---
// Runs before anything is painted: picks the variant and theme, sets up the
// clock (real or overridden from the overlay), and holds the CSS that shows
// only the active variant and filters event items into their buckets.
import { defaultVariant, variants } from './registry'

const ids = variants.map((v) => v.id)

// Buckets: `<section data-bucket="today">` shows only the items tagged "today"
// (see when.ts), hides any `[data-group]` inside it with no such item, and hides
// itself when empty. `[data-empty="upcoming"]` shows only while the variant has
// no item tagged "upcoming".
const TAGS = ['past', 'upcoming', 'now', 'today', 'soon', 'tomorrow', 'week', 'nextweek', 'later']
const bucketCss = TAGS.map(
  (t) => `
[data-bucket="${t}"] [data-start]:not([data-when~="${t}"]),
[data-bucket="${t}"] [data-group]:not(:has([data-when~="${t}"])),
[data-bucket="${t}"]:not(:has([data-when~="${t}"])),
[data-variant-block]:has([data-when~="${t}"]) [data-empty="${t}"] { display: none !important; }`,
).join('')

const variantCss =
  `[data-variant-block] { display: none; }\n` +
  ids.map((id) => `:root[data-variant="${id}"] [data-variant-block="${id}"] { display: block; }`).join('\n')

const fonts = [...new Set(variants.map((v) => v.fonts).filter(Boolean))] as string[]
---

<script is:inline define:vars={{ ids, defaultVariant }}>
  ;(function () {
    var read = function (k) {
      try {
        return localStorage.getItem(k)
      } catch (e) {
        return null
      }
    }
    var write = function (k, v) {
      try {
        if (v === null) localStorage.removeItem(k)
        else localStorage.setItem(k, v)
      } catch (e) {}
    }
    var params = new URLSearchParams(location.search)
    var root = document.documentElement

    // ?v=3 picks variant 3 and remembers it.
    var v = params.get('v')
    if (v) write('aarhus-variant', 'v' + v.replace(/^v/, ''))
    v = read('aarhus-variant')
    root.dataset.variant = ids.indexOf(v) >= 0 ? v : defaultVariant

    var theme = read('theme')
    if (theme === 'dark' || theme === 'light') root.dataset.theme = theme

    // ?now=2026-11-19T17:30 pretends it's that moment, in Aarhus time whatever the
    // viewer's timezone; ?now= resets.
    if (params.has('now')) write('aarhus-now', params.get('now') || null)
    var aarhusTime = function (s) {
      var asUtc = Date.parse(s + 'Z')
      if (isNaN(asUtc)) return NaN
      var name = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Copenhagen', timeZoneName: 'longOffset' })
        .formatToParts(new Date(asUtc))
        .find(function (p) {
          return p.type === 'timeZoneName'
        }).value
      var m = /([+-])(\d\d):(\d\d)/.exec(name)
      var offsetMinutes = m ? (m[1] === '-' ? -1 : 1) * (Number(m[2]) * 60 + Number(m[3])) : 0
      return asUtc - offsetMinutes * 60000
    }
    var fixed = aarhusTime(read('aarhus-now') || '')
    window.aarhusNow = function () {
      return isNaN(fixed) ? Date.now() : fixed
    }
  })()
</script>
<style is:inline set:html={variantCss + bucketCss}></style>
{fonts.map((href) => <link rel="stylesheet" href={href} />)}
