---
// Renders one page in every variant. A page passes exactly one of:
//   list    — an event list (home, topic, past)
//   event   — an event page, with Content = its rendered Markdown
//   page    — a text page (about, add-event, organizer), with Content
import Layout from '@layouts/Layout.astro'
import type { ADEvent } from '@lib/event'
import { getTopics } from '@lib/event'
import { variants } from './registry'

interface Props {
  metadata?: { title?: string; description?: string }
  topic?: string
  list?: { events: ADEvent[]; past: boolean }
  event?: ADEvent
  page?: { title: string; description?: string; website?: string }
  Content?: any
}

const { metadata, topic, list, event, page, Content } = Astro.props
const topics = await getTopics()
---

<Layout {metadata}>
  {
    variants.map(({ id, Shell, List, Event }) => (
      <div data-variant-block={id}>
        <Shell {topic} {topics}>
          {list && <List events={list.events} {topic} past={list.past} />}
          {event && (
            <Event {event}>
              <Content />
            </Event>
          )}
          {page && (
            <article class="v-page">
              <header class="v-page-header">
                <h1>{page.title}</h1>
                {page.description && <p class="v-page-description">{page.description}</p>}
                {page.website && (
                  <a class="v-page-website" href={page.website}>
                    {page.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}
                  </a>
                )}
              </header>
              <div class="prose">
                <Content />
              </div>
            </article>
          )}
        </Shell>
      </div>
    ))
  }
</Layout>
