---
// One event in the issue: the dateline, then the title and who/where.
import type { ADEvent } from '@lib/event'
import { eventAttrs } from '../shared'
import { dayLabel, startLabel, venueLine } from './format'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, endTime } = event.data
---

<li class="v2-item" {...eventAttrs(event)}>
  <time class="v2-dl" datetime={event.start.toISOString()}
    >{dayLabel(event)}, <span class="v2-dl-time">{startLabel(event)}</span></time
  >
  <p class="v2-item-text">
    <a class="v2-item-title" href={event.url}
      ><span class="v2-ink">{title}{subtitle && <span class="v2-item-sub">: {subtitle}</span>}</span></a
    >
    <span class="v2-item-meta">
      {event.organizer.data.name} · {venueLine(event)}{endTime && <span class="v2-until"> · on until {endTime}</span>}
    </span>
  </p>
</li>
