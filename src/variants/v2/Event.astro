---
// Weekly Issue: an event page set as an article. Kicker and dateline, headline,
// a ruled facts box (When / Where / Organizer / Sign up), then the description
// as the body, and a corrections line.
import type { ADEvent } from '@lib/event'
import {
  editUrl,
  eventAttrs,
  formatLong,
  googleCalendarUrl,
  icsFileName,
  icsHref,
  linkHost,
  mapUrl,
  relativeAtBuild,
  topicName,
} from '../shared'
import { townOf } from './format'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, venue, learnMoreURL } = event.data
const when = formatLong(event)
const map = mapUrl(event)
const town = venue ? townOf(venue.address) : 'Aarhus'
const topic = topicName(event.topic)
---

<article class="v2-article" {...eventAttrs(event)}>
  <header class="v2-art-head">
    <p class="v2-art-dateline">
      <a class="v2-art-kicker" href={`/${event.topic}`}>{topic}</a>
      <span class="v2-art-place">{town}, <time datetime={event.start.toISOString()}>{when.date}</time></span>
    </p>
    <h1 class="v2-art-title">{title}</h1>
    {subtitle && <p class="v2-art-deck">{subtitle}</p>}
  </header>

  <p class="v2-ended">
    This event has ended. <a href={`/${event.topic}`}>See what’s next in {topic}</a>.
  </p>

  <dl class="v2-facts">
    <div class="v2-fact">
      <dt>When</dt>
      <dd>
        <time datetime={event.start.toISOString()}>{when.date}</time>
        <span class="v2-fact-sub">
          {when.time} · <span class="v2-rel" data-rel>{relativeAtBuild(event)}</span>
        </span>
      </dd>
    </div>
    <div class="v2-fact">
      <dt>Where</dt>
      <dd>
        {
          venue ? (
            <>
              {venue.title}
              <a class="v2-fact-sub v2-map" href={map}>
                {venue.address}
              </a>
            </>
          ) : (
            <>Venue TBA</>
          )
        }
      </dd>
    </div>
    <div class="v2-fact">
      <dt>Organizer</dt>
      <dd><a href={`/organizer/${event.organizer.id}`}>{event.organizer.data.name}</a></dd>
    </div>
    <div class="v2-fact">
      <dt>Sign up</dt>
      <dd>
        <a class="v2-button" href={learnMoreURL}>Sign up on {linkHost(learnMoreURL)} →</a>
        <span class="v2-cal">
          <a href={icsHref(event)} download={icsFileName(event)}>Add to calendar (.ics)</a>
          <a href={googleCalendarUrl(event)}>Google Calendar</a>
        </span>
      </dd>
    </div>
  </dl>

  <div class="prose v2-art-body">
    <slot />
  </div>

  <footer class="v2-art-foot">
    <p>
      Something wrong or missing? <a href={editUrl(event)}>Edit on GitHub</a>.
    </p>
    <p>
      <a href={`/${event.topic}`}>More {topic} events</a>
      <a href="/">This week’s issue</a>
    </p>
  </footer>
</article>

<style is:global>
  [data-variant-block='v2'] .v2-article {
    padding-top: 2rem;
  }

  /* ---- Kicker, dateline, headline, deck ---- */
  [data-variant-block='v2'] .v2-art-dateline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin: 0 0 0.9rem;
    font: 500 0.875rem/1.4 var(--v2-sans);
    color: var(--color-text-muted);
  }
  [data-variant-block='v2'] .v2-art-kicker {
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    padding-right: 1rem;
    border-right: 1px solid var(--color-border);
  }
  [data-variant-block='v2'] .v2-art-kicker:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  @media (min-width: 52rem) {
    [data-variant-block='v2'] .v2-art-dateline {
      display: grid;
      grid-template-columns: var(--v2-rail) minmax(0, 1fr);
      column-gap: var(--v2-gap);
    }
    [data-variant-block='v2'] .v2-art-kicker {
      border-right: 0;
      padding-right: 0;
    }
  }
  [data-variant-block='v2'] .v2-art-title {
    margin: 0;
    max-width: 20ch;
    font: 500 clamp(2.375rem, 1.5rem + 3.6vw, 4.25rem)/1.02 var(--v2-serif);
    letter-spacing: -0.028em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  [data-variant-block='v2'] .v2-art-deck {
    margin: 0.6rem 0 0;
    font: italic 400 clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem)/1.3 var(--v2-serif);
    color: var(--color-text-muted);
  }

  /* ---- The ended notice, shown once the event is over ---- */
  [data-variant-block='v2'] .v2-ended {
    display: none;
    margin: 1.5rem 0 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--v2-rule);
    font: 500 0.9375rem/1.4 var(--v2-sans);
  }
  [data-variant-block='v2'] .v2-article[data-when~='past'] .v2-ended {
    display: block;
  }
  [data-variant-block='v2'] .v2-ended a {
    color: var(--v2-link);
    text-underline-offset: 0.2em;
  }

  /* ---- Facts box: label in the rail, value in the column ---- */
  [data-variant-block='v2'] .v2-facts {
    margin: 1.75rem 0 2.5rem;
    border-top: 3px solid var(--v2-rule);
    border-bottom: 1px solid var(--v2-rule);
  }
  [data-variant-block='v2'] .v2-fact {
    display: grid;
    gap: 0.15rem;
    padding: 0.75rem 0;
  }
  [data-variant-block='v2'] .v2-fact + .v2-fact {
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 30rem) {
    [data-variant-block='v2'] .v2-fact {
      grid-template-columns: 6.5rem minmax(0, 1fr);
      column-gap: 1rem;
      align-items: baseline;
    }
  }
  @media (min-width: 52rem) {
    [data-variant-block='v2'] .v2-fact {
      grid-template-columns: var(--v2-rail) minmax(0, 1fr);
      column-gap: var(--v2-gap);
    }
  }
  [data-variant-block='v2'] .v2-fact dt {
    font: 600 0.8125rem/1.4 var(--v2-sans);
    color: var(--color-text-muted);
  }
  [data-variant-block='v2'] .v2-fact dd {
    margin: 0;
    font: 500 1.1875rem/1.4 var(--v2-serif);
  }
  [data-variant-block='v2'] .v2-fact dd > a:not(.v2-button) {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  [data-variant-block='v2'] .v2-fact-sub {
    display: block;
    margin-top: 0.15rem;
    font: 400 1rem/1.45 var(--v2-serif);
    color: var(--color-text-muted);
  }
  [data-variant-block='v2'] a.v2-map {
    width: fit-content;
    color: var(--v2-link);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  [data-variant-block='v2'] .v2-rel {
    font-style: italic;
  }
  [data-variant-block='v2'] .v2-article[data-when~='now'] .v2-rel {
    font-style: normal;
    font-weight: 600;
    color: var(--color-text);
    padding: 0 0.15em;
    background: linear-gradient(var(--v2-mark), var(--v2-mark)) 0 88% / 100% 0.5em no-repeat;
  }

  [data-variant-block='v2'] .v2-button {
    display: inline-block;
    max-width: 100%;
    margin: 0.1rem 0 0.2rem;
    padding: 0.7rem 1.1rem 0.75rem;
    border-radius: 2px;
    background: var(--v2-button);
    color: var(--v2-button-text);
    font: 600 1rem/1.3 var(--v2-sans);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  [data-variant-block='v2'] .v2-button:hover {
    color: var(--v2-button-text);
    background: var(--color-text);
  }
  [data-variant-block='v2'] .v2-article[data-when~='past'] .v2-button {
    background: transparent;
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }
  [data-variant-block='v2'] .v2-cal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.25rem;
    margin-top: 0.5rem;
    font: 500 0.875rem/1.5 var(--v2-sans);
  }
  [data-variant-block='v2'] .v2-cal a {
    color: var(--v2-link);
    text-underline-offset: 0.22em;
  }

  /* ---- Body: an opening initial, then the article ---- */
  @supports (initial-letter: 2) or (-webkit-initial-letter: 2) {
    [data-variant-block='v2'] .v2-art-body > p:first-child::first-letter {
      -webkit-initial-letter: 2;
      initial-letter: 2;
      font-weight: 600;
      margin-right: 0.12em;
      color: var(--color-text);
    }
  }
  [data-variant-block='v2'] .v2-art-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: 2.5rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
    font: 500 0.875rem/1.5 var(--v2-sans);
    color: var(--color-text-muted);
  }
  @media (min-width: 52rem) {
    [data-variant-block='v2'] .v2-art-foot {
      margin-left: calc(var(--v2-rail) + var(--v2-gap));
    }
  }
  [data-variant-block='v2'] .v2-art-foot p {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
  [data-variant-block='v2'] .v2-art-foot a {
    color: var(--v2-link);
    text-underline-offset: 0.22em;
  }
</style>
