---
// The head event as a gig flyer (Poster's, set on the board's page): a status strip,
// the title as big as it fits, a date band across the sheet, then where, who and
// the sign-up button. Light: black ink on paper with the topic color as the one
// spot color. Dark: the flyer is a field of topic color.
import type { ADEvent } from '@lib/event'
import { eventAttrs, linkHost, mapUrl, relativeAtBuild, topicName } from '../shared'
import { dateLabel, needsYear, startStamp, timeLabel, titleFit, topicStyle } from '../v5/poster'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, venue, learnMoreURL, endTime } = event.data
---

<article class:list={['flyer', `fit-${titleFit(title)}`]} style={topicStyle(event.topic)} {...eventAttrs(event)}>
  <p class="fl-strip">
    <span>
      <span class="fl-now"><span class="fl-pulse" aria-hidden="true"></span>Happening now{endTime && ` · until ${endTime}`}</span>
      <span class="fl-up">Featured · <span data-rel>{relativeAtBuild(event)}</span></span>
    </span>
    <a class="fl-topic" href={`/${event.topic}`}>{topicName(event.topic)}</a>
  </p>

  <div class="fl-sheet">
    <hgroup>
      <h2 class="fl-title"><a href={event.url}>{title}</a></h2>
      {subtitle && <p class="fl-sub">{subtitle}</p>}
    </hgroup>

    <p class="fl-slab">
      <time datetime={startStamp(event)}>
        <span>{dateLabel(event, needsYear(event))}</span>
        <span class="fl-dash" aria-hidden="true"></span>
        <span>{timeLabel(event)}</span>
      </time>
    </p>

    <div class="fl-foot">
      <dl class="fl-facts">
        <div>
          <dt>Where</dt>
          <dd>
            {
              venue ? (
                <>
                  <span class="fl-venue">{venue.title}</span>
                  <a href={mapUrl(event)}>{venue.address}</a>
                </>
              ) : (
                <span class="fl-venue">Venue TBA</span>
              )
            }
          </dd>
        </div>
        <div>
          <dt>Organizer</dt>
          <dd><a href={`/organizer/${event.organizer.id}`}>{event.organizer.data.name}</a></dd>
        </div>
      </dl>

      <div class="fl-actions">
        <a class="fl-signup" href={learnMoreURL}><span>Sign up on</span> <span>{linkHost(learnMoreURL)}&nbsp;→</span></a>
        <a class="fl-more" href={event.url}>Event details</a>
      </div>
    </div>
  </div>
</article>

<style is:global>
  [data-variant-block='v2'] {
    --v2-display: 'Archivo', 'Arial Narrow', ui-sans-serif, system-ui, sans-serif;

    .flyer {
      --pad: clamp(1.25rem, 4cqi, 2.75rem);
      container-type: inline-size;
      margin-inline: calc(-1 * var(--hang));
      color: light-dark(var(--v1-ink), var(--p-on));
      background: light-dark(var(--v1-ticket-bg), var(--p));
      border: 3px solid light-dark(var(--v1-ink), var(--p));
    }
    .flyer a:hover {
      color: inherit;
    }
    .flyer :focus-visible {
      outline-color: light-dark(var(--v1-ink), var(--p-on));
    }

    /* ---------- status strip: featured · in 6 days, or happening now ---------- */
    .fl-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.5rem var(--pad);
      background: light-dark(var(--v1-ink), var(--p-on));
      color: light-dark(var(--color-bg), var(--p));
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.07em;
      line-height: 1.3;
      text-transform: uppercase;
    }
    .fl-strip :focus-visible {
      outline-color: currentColor;
    }
    .fl-topic {
      text-decoration: none;
      white-space: nowrap;
    }
    .fl-topic:hover {
      text-decoration: underline;
    }
    .fl-now {
      display: none;
      align-items: center;
    }
    [data-when~='now'] .fl-now {
      display: inline-flex;
    }
    [data-when~='now'] .fl-up {
      display: none;
    }
    .flyer[data-when~='now'] .fl-strip {
      background: light-dark(var(--p), var(--p-on));
      color: light-dark(var(--p-on), var(--p));
    }
    .fl-pulse {
      width: 0.6em;
      height: 0.6em;
      margin-right: 0.6em;
      border-radius: 50%;
      background: currentColor;
    }
    @media (prefers-reduced-motion: no-preference) {
      .fl-pulse {
        animation: v1-lamp 1.6s steps(1, end) infinite;
      }
    }

    /* ---------- the sheet ---------- */
    .fl-sheet {
      display: grid;
      gap: clamp(1.25rem, 3cqi, 2.25rem);
      padding: var(--pad);
    }
    .fl-title {
      font-family: var(--v2-display);
      font-weight: 850;
      line-height: 0.88;
      letter-spacing: -0.02em;
      text-wrap: balance;
      overflow-wrap: break-word;
    }
    .fl-title a {
      text-decoration: none;
    }
    .fl-title a:hover {
      text-decoration: underline;
      text-decoration-thickness: 0.06em;
      text-underline-offset: 0.08em;
    }
    /* Short titles go big and wide, long ones condensed: the headline block stays about the same size. */
    .fit-xs .fl-title {
      font-size: clamp(3.5rem, 14cqi, 11rem);
      font-stretch: 112%;
      letter-spacing: -0.035em;
    }
    .fit-s .fl-title {
      font-size: clamp(3rem, 11cqi, 9rem);
      font-stretch: 88%;
    }
    .fit-m .fl-title {
      font-size: clamp(2.6rem, 8.6cqi, 7rem);
      font-stretch: 75%;
    }
    .fit-l .fl-title {
      font-size: clamp(2.2rem, 8cqi, 6.5rem);
      font-stretch: 66%;
    }
    .fl-sub {
      margin-top: 0.6em;
      font-family: var(--v2-display);
      font-size: clamp(1.125rem, 2.6cqi, 1.75rem);
      font-weight: 500;
      line-height: 1.2;
    }

    /* the date band, right across the sheet: WED 25 NOV ——— 08:30–16:30 */
    .fl-slab {
      margin-inline: calc(-1 * var(--pad));
    }
    .fl-slab time {
      display: flex;
      align-items: center;
      gap: 0.3em;
      padding: 0.16em var(--pad) 0.12em;
      background: light-dark(var(--p), var(--p-on));
      color: light-dark(var(--p-on), var(--p));
      font-family: var(--v2-display);
      font-size: clamp(1.75rem, 5.2cqi, 4rem);
      font-weight: 900;
      font-stretch: 80%;
      line-height: 1;
      text-transform: uppercase;
      font-variant-numeric: tabular-nums;
    }
    .fl-dash {
      flex: 1;
      min-width: 1em;
      height: 0.12em;
      background: currentColor;
    }

    /* ---------- where, who, sign up ---------- */
    .fl-foot {
      display: grid;
      gap: 1.5rem;
    }
    .fl-facts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 12.5rem), 1fr));
      gap: 1rem 2rem;
      font-size: 0.875rem;
      line-height: 1.45;
    }
    .fl-facts dt {
      margin-bottom: 0.3rem;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: light-dark(var(--color-text-muted), var(--p-on));
    }
    .fl-venue {
      display: block;
      font-family: var(--v2-display);
      font-size: 1.375rem;
      font-weight: 800;
      font-stretch: 85%;
      line-height: 1.15;
    }
    .fl-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 2rem;
    }
    .fl-signup {
      display: inline-block;
      padding: 0.75em 1.15em;
      border: 3px solid light-dark(var(--v1-ink), var(--p-on));
      background: light-dark(var(--v1-ink), var(--p-on));
      color: light-dark(var(--color-bg), var(--p));
      font-family: var(--v2-display);
      font-size: clamp(1.125rem, 2.4cqi, 1.5rem);
      font-weight: 800;
      font-stretch: 90%;
      line-height: 1.1;
      text-decoration: none;
      text-wrap: balance;
    }
    .flyer .fl-signup:hover {
      background: light-dark(var(--p), transparent);
      color: var(--p-on);
    }
    .fl-signup > span {
      white-space: nowrap;
    }
    .fl-more {
      font-size: 0.875rem;
    }

    /* wide: facts on the left, the button in the bottom-right corner */
    @container (min-width: 48rem) {
      .fl-foot {
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        column-gap: 3rem;
      }
      .fl-actions {
        flex-direction: column;
        align-items: flex-end;
        gap: 0.85rem;
      }
    }
    /* narrow: date over time, a full-width button */
    @container (max-width: 34rem) {
      .fl-dash {
        display: none;
      }
      .fl-slab time {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.05em;
      }
      .fl-signup {
        display: block;
        width: 100%;
        text-align: center;
      }
    }

    /* phones: edge to edge, like the today board */
    @media (max-width: 40rem) {
      .flyer {
        --pad: 1rem;
        margin-inline: -1rem;
        border-inline-width: 0;
      }
    }
  }
</style>
