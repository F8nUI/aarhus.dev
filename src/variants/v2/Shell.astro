---
// Weekly Issue: the site as a weekly newsletter. A nameplate, the topics as
// sections, and a colophon footer. List pages get the full-size nameplate;
// articles and text pages a compact one.
import { calendarFeed, topicName } from '../shared'

interface Props {
  topic?: string
  topics: string[]
}

const { topic, topics } = Astro.props

const path = Astro.url.pathname.replace(/\/$/, '')
const first = path.split('/')[1] ?? ''
const inArchive = first === 'past'
const isList = path === '' || inArchive || (path.split('/').length === 2 && topics.includes(first))

// Topics as the issue's sections, alphabetical by folder. In the archive they
// lead to each topic's back issues.
const base = inArchive ? '/past' : ''
const sections = [...topics].sort()
const current = (t: string) => (t === topic ? (isList ? 'page' : 'location') : undefined)
---

<div class="v2" data-size={isList ? 'full' : 'compact'}>
  <header class="v2-head">
    <div class="v2-head-row">
      {isList && <p class="v2-ear">Tech events in Aarhus, Denmark</p>}
      <button class="theme-toggle v2-toggle" type="button" aria-label="Switch between light and dark">
        <svg class="v2-toggle-night" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <path d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7Z" fill="currentColor"></path>
        </svg>
        <svg class="v2-toggle-day" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
          <circle cx="8" cy="8" r="3.4" fill="currentColor"></circle>
          <path
            d="M8 .8v2M8 13.2v2M.8 8h2M13.2 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M2.9 13.1l1.4-1.4M11.7 4.3l1.4-1.4"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"></path>
        </svg>
        <span class="v2-toggle-night">Night edition</span>
        <span class="v2-toggle-day">Day edition</span>
      </button>
    </div>
    {
      isList ? (
        <h1 class="v2-nameplate">
          <a href="/">aarhus.dev</a>
        </h1>
      ) : (
        <p class="v2-nameplate">
          <a href="/">aarhus.dev</a>
        </p>
      )
    }
    <nav class="v2-sections" aria-label="Topics">
      <ul>
        <li>
          <a href={base || '/'} aria-current={isList && !topic ? 'page' : undefined}>All topics</a>
        </li>
        {
          sections.map((t) => (
            <li>
              <a href={`${base}/${t}`} aria-current={current(t)}>
                {topicName(t)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </header>

  <main class="v2-main">
    <slot />
  </main>

  <footer class="v2-foot">
    <p class="v2-foot-name"><a href="/">aarhus.dev</a></p>
    <p class="v2-foot-about">
      A community timetable of tech events in Aarhus, Denmark. Anyone can add one; the site is open source.
    </p>
    <ul class="v2-foot-links">
      <li><a href="/about">About</a></li>
      <li><a href="/add-event">Add event</a></li>
      <li><a href={calendarFeed.webcal}>Subscribe</a></li>
      <li><a href="https://github.com/f8nui/aarhus.dev">GitHub</a></li>
    </ul>
  </footer>
</div>

<style is:global>
  /* ---- Tokens: warm paper and iron-gall ink by day, deep ink and paper-white by night ---- */
  :root[data-variant='v2'] {
    color-scheme: light;
    --color-bg: #f3eee3;
    --color-bg-subtle: #e9e2d2;
    --color-text: #1f1c17;
    --color-text-muted: #645b4d;
    --color-border: #d3c9b5;
    --v2-rule: #1f1c17;
    --v2-link: #1d3a92;
    --v2-mark: #f1cf55;
    --v2-button: #1d3a92;
    --v2-button-text: #f6f2e8;
  }
  :root[data-variant='v2'][data-theme='dark'] {
    color-scheme: dark;
    --color-bg: #11151f;
    --color-bg-subtle: #1a2030;
    --color-text: #ede5d4;
    --color-text-muted: #a49b8a;
    --color-border: #2d3446;
    --v2-rule: #cfc6b4;
    --v2-link: #aebffa;
    --v2-mark: #6a5418;
    --v2-button: #aebffa;
    --v2-button-text: #11151f;
  }
  @media (prefers-color-scheme: dark) {
    :root[data-variant='v2']:not([data-theme='light']) {
      color-scheme: dark;
      --color-bg: #11151f;
      --color-bg-subtle: #1a2030;
      --color-text: #ede5d4;
      --color-text-muted: #a49b8a;
      --color-border: #2d3446;
      --v2-rule: #cfc6b4;
      --v2-link: #aebffa;
      --v2-mark: #6a5418;
      --v2-button: #aebffa;
      --v2-button-text: #11151f;
    }
  }

  /* ---- Frame ---- */
  [data-variant-block='v2'] {
    --v2-serif: 'Newsreader', 'Iowan Old Style', Georgia, serif;
    --v2-sans: 'Schibsted Grotesk', ui-sans-serif, system-ui, sans-serif;
    --v2-rail: 10.5rem;
    --v2-gap: 2.5rem;
    font-family: var(--v2-serif);
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
  }
  [data-variant-block='v2'] .v2 {
    max-width: 54rem;
    margin: 0 auto;
    padding: 1rem 1rem 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }
  @media (min-width: 40rem) {
    [data-variant-block='v2'] .v2 {
      padding: 1.5rem 2rem 0;
    }
  }
  [data-variant-block='v2'] .v2-main {
    flex: 1;
  }
  [data-variant-block='v2'] a {
    color: inherit;
  }
  [data-variant-block='v2'] a:hover {
    color: inherit;
  }
  [data-variant-block='v2'] :focus-visible {
    outline: 2px solid var(--v2-link);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ---- Masthead ---- */
  [data-variant-block='v2'] .v2-head-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
  }
  [data-variant-block='v2'] .v2-ear {
    margin-right: auto;
    font: 500 0.8125rem/1.3 var(--v2-sans);
    color: var(--color-text-muted);
  }
  [data-variant-block='v2'] .v2-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0;
    font: 500 0.8125rem/1 var(--v2-sans);
    color: var(--color-text-muted);
    cursor: pointer;
  }
  [data-variant-block='v2'] .v2-toggle:hover {
    color: var(--color-text);
  }
  [data-variant-block='v2'] .v2-toggle-day {
    display: none;
  }
  :root[data-theme='dark'] [data-variant-block='v2'] .v2-toggle-day {
    display: inline;
  }
  :root[data-theme='dark'] [data-variant-block='v2'] .v2-toggle-night {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) [data-variant-block='v2'] .v2-toggle-day {
      display: inline;
    }
    :root:not([data-theme='light']) [data-variant-block='v2'] .v2-toggle-night {
      display: none;
    }
  }

  [data-variant-block='v2'] .v2-nameplate {
    margin: 0;
    font-family: var(--v2-serif);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.9;
  }
  [data-variant-block='v2'] .v2-nameplate a {
    text-decoration: none;
  }
  [data-variant-block='v2'] [data-size='full'] .v2-nameplate {
    font-size: clamp(3.75rem, 1.5rem + 9vw, 8rem);
    margin: 0.35rem 0 0.75rem -0.05em;
  }
  [data-variant-block='v2'] [data-size='compact'] .v2-head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--v2-rule);
  }
  [data-variant-block='v2'] [data-size='compact'] .v2-head-row {
    grid-column: 2;
    grid-row: 1;
  }
  [data-variant-block='v2'] [data-size='compact'] .v2-nameplate {
    grid-column: 1;
    grid-row: 1;
    font-size: 2rem;
    letter-spacing: -0.03em;
  }
  [data-variant-block='v2'] [data-size='compact'] .v2-sections {
    grid-column: 1 / -1;
  }

  [data-variant-block='v2'] .v2-sections ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1.1rem;
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
    font: 500 0.875rem/1.6 var(--v2-sans);
  }
  [data-variant-block='v2'] .v2-sections a {
    color: var(--color-text-muted);
    text-decoration: none;
    padding: 0.15rem 0;
  }
  [data-variant-block='v2'] .v2-sections a:hover {
    color: var(--color-text);
  }
  [data-variant-block='v2'] .v2-sections a[aria-current] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }

  /* ---- Footer: the colophon ---- */
  [data-variant-block='v2'] .v2-foot {
    margin-top: 4rem;
    padding: 1.25rem 0 2.5rem;
    border-top: 3px solid var(--v2-rule);
    display: grid;
    gap: 0.5rem 2.5rem;
    color: var(--color-text-muted);
  }
  @media (min-width: 52rem) {
    [data-variant-block='v2'] .v2-foot {
      grid-template-columns: var(--v2-rail) minmax(0, 1fr);
    }
    [data-variant-block='v2'] .v2-foot-links {
      grid-column: 2;
    }
  }
  [data-variant-block='v2'] .v2-foot-name {
    font: 600 1.375rem/1.2 var(--v2-serif);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  [data-variant-block='v2'] .v2-foot-name a {
    text-decoration: none;
  }
  [data-variant-block='v2'] .v2-foot-about {
    font: italic 400 1.0625rem/1.5 var(--v2-serif);
    max-width: 34rem;
    padding-top: 0.2rem;
  }
  [data-variant-block='v2'] .v2-foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font: 500 0.875rem/1.8 var(--v2-sans);
  }
  [data-variant-block='v2'] .v2-foot-links a {
    color: var(--color-text);
    text-underline-offset: 0.25em;
    text-decoration-color: var(--color-border);
  }
  [data-variant-block='v2'] .v2-foot-links a:hover {
    text-decoration-color: currentColor;
  }

  /* ---- Text pages: About, Add event, organizers ---- */
  [data-variant-block='v2'] .v-page {
    padding-top: 2rem;
  }
  [data-variant-block='v2'] .v-page-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  [data-variant-block='v2'] .v-page-header h1 {
    font: 500 clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem)/1.05 var(--v2-serif);
    letter-spacing: -0.025em;
    text-wrap: balance;
    max-width: 20ch;
  }
  [data-variant-block='v2'] .v-page-description {
    margin-top: 0.75rem;
    font: italic 400 1.3125rem/1.4 var(--v2-serif);
    color: var(--color-text-muted);
    max-width: 36rem;
  }
  [data-variant-block='v2'] .v-page-website {
    display: inline-block;
    margin-top: 0.75rem;
    font: 500 0.875rem/1.4 var(--v2-sans);
    color: var(--v2-link);
    text-underline-offset: 0.25em;
  }

  /* ---- Prose: event descriptions and text pages. On wide screens the
     section headings hang in the left rail, beside the text they open. ---- */
  [data-variant-block='v2'] .prose {
    font: 400 1.1875rem/1.6 var(--v2-serif);
    color: var(--color-text);
    hanging-punctuation: first;
  }
  [data-variant-block='v2'] .prose > * {
    min-width: 0;
    max-width: 65ch;
  }
  [data-variant-block='v2'] .prose p {
    margin: 0 0 0.9em;
  }
  [data-variant-block='v2'] .prose h1,
  [data-variant-block='v2'] .prose h2 {
    font: italic 500 1.375rem/1.25 var(--v2-serif);
    letter-spacing: -0.01em;
    margin: 1.75rem 0 0.5rem;
    text-wrap: balance;
  }
  [data-variant-block='v2'] .prose h3,
  [data-variant-block='v2'] .prose h4 {
    font: 600 1.1875rem/1.35 var(--v2-serif);
    margin: 1.4rem 0 0.35rem;
  }
  @media (min-width: 52rem) {
    [data-variant-block='v2'] .prose {
      display: grid;
      grid-template-columns: var(--v2-rail) minmax(0, 1fr);
      column-gap: var(--v2-gap);
      align-items: baseline;
    }
    [data-variant-block='v2'] .prose > * {
      grid-column: 2;
    }
    [data-variant-block='v2'] .prose > h2 {
      grid-column: 1;
      margin-top: 0;
      padding-top: 1.1rem;
      font-size: 1.1875rem;
      line-height: 1.3;
    }
    [data-variant-block='v2'] .prose > h2 + * {
      margin-top: 0;
      padding-top: 1.1rem;
    }
    [data-variant-block='v2'] .prose > h2:first-child,
    [data-variant-block='v2'] .prose > h2:first-child + * {
      padding-top: 0;
    }
  }
  [data-variant-block='v2'] .prose a {
    color: var(--v2-link);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  [data-variant-block='v2'] .prose a:hover {
    text-decoration-thickness: 2px;
  }
  [data-variant-block='v2'] .prose strong {
    font-weight: 600;
  }
  [data-variant-block='v2'] .prose ul,
  [data-variant-block='v2'] .prose ol {
    margin: 0 0 1em;
    padding-left: 1.35em;
  }
  [data-variant-block='v2'] .prose ul {
    list-style: disc;
  }
  [data-variant-block='v2'] .prose ol {
    list-style: decimal;
  }
  [data-variant-block='v2'] .prose li {
    margin-bottom: 0.3em;
    padding-left: 0.2em;
  }
  [data-variant-block='v2'] .prose li::marker {
    color: var(--color-text-muted);
    font: 500 0.85em var(--v2-sans);
  }
  [data-variant-block='v2'] .prose blockquote {
    margin: 0 0 1em;
    padding-left: 1em;
    border-left: 2px solid var(--v2-rule);
    font-style: italic;
  }
  [data-variant-block='v2'] .prose hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }
  [data-variant-block='v2'] .prose code {
    font-family: var(--font-mono);
    font-size: 0.8em;
    padding: 0.1em 0.35em;
    border-radius: 3px;
    background: var(--color-bg-subtle);
  }
  [data-variant-block='v2'] .prose pre {
    margin: 0.4rem 0 1.25rem;
    padding: 1rem 1.15rem;
    border-radius: 0;
    border-left: 3px solid var(--v2-rule);
    background: var(--color-bg-subtle);
    overflow-x: auto;
    font-size: 1rem;
    line-height: 1.55;
  }
  [data-variant-block='v2'] .prose pre code {
    padding: 0;
    background: transparent;
    font-size: 0.8125rem;
  }
  /* Code is printed in one ink: override the highlighter's dark-theme inline colors. */
  [data-variant-block='v2'] .prose pre.astro-code {
    background-color: var(--color-bg-subtle) !important;
    color: var(--color-text) !important;
  }
  [data-variant-block='v2'] .prose pre.astro-code span {
    color: inherit !important;
  }
</style>
