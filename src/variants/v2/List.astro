---
// Board + Flyer: the Departure Board, with the highlighted event as a gig flyer above it.
import type { ADEvent } from '@lib/event'
import Board from '../v1/List.astro'
import Flyer from './Flyer.astro'

interface Props {
  events: ADEvent[]
  topic?: string
  past: boolean
}
---

<Board {...Astro.props} Head={Flyer} />
