---
// Weekly Issue: the home page reads as this week's issue. A folio line and a
// one-sentence lede that are worked out in the browser (they depend on today),
// then short sections — happening now, later today, this week, next week,
// coming up by month. The archive is the back issues, by month.
import type { ADEvent } from '@lib/event'
import { calendarFeed, formatMonth, groupBy, topicName } from '../shared'
import Item from './Item.astro'

interface Props {
  events: ADEvent[]
  topic?: string
  past: boolean
}

const { events, topic, past } = Astro.props
const name = topic ? topicName(topic) : undefined
const home = topic ? `/${topic}` : '/'
const archive = topic ? `/past/${topic}` : '/past'
const noun = name ? `${name} event` : 'event'

// Build-time numbers to start with; the runtime keeps data-count current.
const pastAtBuild = events.filter((e) => e.end.valueOf() < Date.now()).length

const byMonth = (list: ADEvent[]) => groupBy(list, (e) => formatMonth(e.start))
const sections = [
  { bucket: 'now', title: 'Happening now' },
  { bucket: 'today', title: 'Later today' },
  { bucket: 'week', title: 'This week', range: 'week' },
  { bucket: 'nextweek', title: 'Next week', range: 'nextweek' },
]
---

{
  past ? (
    <div class="v2-issue" data-kind="archive">
      <div class="v2-folio">
        <h2 class="v2-folio-line">
          Back issues{name && <span> · {name}</span>} · <span data-count="past">{pastAtBuild}</span> so far
        </h2>
        <a class="v2-folio-link" href={home}>
          This week’s issue
        </a>
      </div>
      <p class="v2-lede">Every past {noun}, newest first.</p>

      <div data-bucket="past">
        {byMonth([...events].reverse()).map((month) => (
          <section class="v2-sect" data-group>
            <h3 class="v2-sect-head">{month.key}</h3>
            <ol class="v2-items">
              {month.items.map((event) => (
                <Item {event} />
              ))}
            </ol>
          </section>
        ))}
      </div>
      <p class="v2-empty" data-empty="past">
        No past {noun}s yet. <a href={home}>See what’s coming up</a>.
      </p>
    </div>
  ) : (
    <div class="v2-issue" data-kind="issue">
      <div class="v2-folio">
        <p class="v2-folio-line">
          <span data-v2-folio>This week in Aarhus tech</span>
          {name && <span> · {name} edition</span>}
        </p>
        <a class="v2-folio-link" href={calendarFeed.webcal}>
          Subscribe
        </a>
      </div>
      <p class="v2-lede" data-v2-lede data-noun={noun}>
        Every tech meetup in Aarhus, week by week.
      </p>

      {sections.map((s) => (
        <section class="v2-sect" data-bucket={s.bucket}>
          <h2 class="v2-sect-head">
            {s.title}
            {s.range && <span class="v2-sect-note" data-v2-range={s.range} />}
          </h2>
          <ol class="v2-items">
            {events.map((event) => (
              <Item {event} />
            ))}
          </ol>
        </section>
      ))}

      <section class="v2-sect" data-bucket="later">
        <h2 class="v2-sect-head">Coming up</h2>
        <div class="v2-months">
          {byMonth(events).map((month) => (
            <div class="v2-month" data-group>
              <h3 class="v2-month-head">{month.key}</h3>
              <ol class="v2-items">
                {month.items.map((event) => (
                  <Item {event} />
                ))}
              </ol>
            </div>
          ))}
        </div>
      </section>

      <div class="v2-sect v2-empty" data-empty="upcoming">
        <h2 class="v2-sect-head">Nothing listed</h2>
        <p>
          No {noun}s are coming up yet. Running one? <a href="/add-event">Add it to the next issue</a>.
        </p>
      </div>

      <div class="v2-sect v2-end">
        <h2 class="v2-sect-head">Also</h2>
        <ul class="v2-end-list">
          <li>
            <strong>Back issues.</strong>{' '}
            <a href={archive}>Every past {noun}</a>, newest first: <span data-count="past">{pastAtBuild}</span> so far.
          </li>
          <li>
            <strong>Subscribe.</strong> Every event in your calendar app, updated as events are added:{' '}
            <a href={calendarFeed.webcal}>subscribe to the calendar</a>, or add{' '}
            <a class="v2-url" href={calendarFeed.https}>
              {calendarFeed.https.replace('https://', '')}
            </a>{' '}
            by URL.
          </li>
          <li>
            <strong>Add event.</strong> Running a meetup in or around Aarhus?{' '}
            <a href="/add-event">Add it to the next issue</a>.
          </li>
        </ul>
      </div>
    </div>
  )
}

{
  !past && (
    <script is:inline>
      // The issue line and the lede depend on today, so they're written here, in the
      // browser, from the same clock the overlay controls. Touches only this variant.
      ;(function () {
        var block = document.currentScript.closest('[data-variant-block="v2"]')
        if (!block) return
        var now = window.aarhusNow ? window.aarhusNow() : Date.now()
        var DAY = 864e5
        // The Aarhus calendar day of a moment, as noon UTC on that date.
        var dayOf = function (t) {
          return new Date(new Date(t).toLocaleDateString('en-CA', { timeZone: 'Europe/Copenhagen' }) + 'T12:00:00Z')
        }
        var mondayOf = function (t) {
          var d = dayOf(t)
          d.setUTCDate(d.getUTCDate() - ((d.getUTCDay() + 6) % 7))
          return d
        }
        var fmt = function (d, o) {
          return d.toLocaleDateString('en-GB', Object.assign({ timeZone: 'UTC' }, o)).replace('Sept', 'Sep')
        }
        var span = function (a, b, month) {
          var y = a.getUTCFullYear() !== b.getUTCFullYear()
          if (y) return fmt(a, { day: 'numeric', month: month, year: 'numeric' }) + ' – ' + fmt(b, { day: 'numeric', month: month, year: 'numeric' })
          if (a.getUTCMonth() !== b.getUTCMonth()) return fmt(a, { day: 'numeric', month: month }) + ' – ' + fmt(b, { day: 'numeric', month: month })
          return a.getUTCDate() + '–' + fmt(b, { day: 'numeric', month: month })
        }

        var monday = mondayOf(now)
        var sunday = new Date(monday.valueOf() + 6 * DAY)
        var nextMonday = new Date(monday.valueOf() + 7 * DAY)
        var nextSunday = new Date(monday.valueOf() + 13 * DAY)
        var thursday = new Date(monday.valueOf() + 3 * DAY)
        var week = 1 + Math.floor((thursday - Date.UTC(thursday.getUTCFullYear(), 0, 1)) / DAY / 7)

        // Count each event once (it is rendered in several sections).
        var seen = {}
        var c = { total: 0, left: 0, now: 0, today: 0, week: 0, next: 0 }
        var today = dayOf(now).valueOf()
        block.querySelectorAll('.v2-issue [data-id][data-start]').forEach(function (el) {
          if (seen[el.dataset.id]) return
          seen[el.dataset.id] = true
          var start = Date.parse(el.dataset.start)
          var end = Date.parse(el.dataset.end)
          var m = mondayOf(start).valueOf()
          if (m === nextMonday.valueOf()) c.next++
          if (m !== monday.valueOf()) return
          c.total++
          if (end < now) return
          c.left++
          if (start <= now) c.now++
          else if (dayOf(start).valueOf() === today) c.today++
          else c.week++
        })

        var words = ['no', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten', 'eleven', 'twelve']
        var num = function (n) {
          return n < words.length ? words[n] : String(n)
        }
        var Num = function (n) {
          var w = num(n)
          return w.charAt(0).toUpperCase() + w.slice(1)
        }
        var lede = block.querySelector('[data-v2-lede]')
        var noun = function (n) {
          return lede.dataset.noun + (n === 1 ? '' : 's')
        }
        var join = function (parts) {
          return parts.length < 2 ? parts.join('') : parts.slice(0, -1).join(', ') + ' and ' + parts[parts.length - 1]
        }

        var text
        if (c.total === 0) {
          text = 'Nothing on this week.' + (c.next ? ' ' + Num(c.next) + ' ' + noun(c.next) + ' next week.' : '')
        } else if (c.left === 0) {
          text = Num(c.total) + ' ' + noun(c.total) + ' this week, all over now.' + (c.next ? ' ' + Num(c.next) + ' next week.' : '')
        } else if (c.left === c.total && c.now + c.today === 0) {
          text = Num(c.total) + ' ' + noun(c.total) + ' this week.'
        } else if (c.left === c.total && (c.now === c.total || c.today === c.total)) {
          // All of them at once: "One Rust event this week, later today."
          var all = c.total === 1 ? '' : c.total === 2 ? 'both ' : 'all '
          text = Num(c.total) + ' ' + noun(c.total) + ' this week, ' + all + (c.now ? 'on right now.' : 'later today.')
        } else {
          var parts = []
          if (c.now) parts.push(num(c.now) + ' on right now')
          if (c.today) parts.push(num(c.today) + (c.now ? ' more' : '') + ' later today')
          if (c.week) parts.push(num(c.week) + ' more by Sunday')
          text = Num(c.total) + ' ' + noun(c.total) + ' this week: ' + join(parts) + '.'
        }
        lede.textContent = text

        var sameYear = monday.getUTCFullYear() === sunday.getUTCFullYear()
        block.querySelector('[data-v2-folio]').textContent =
          'Week ' + week + ' · ' + span(monday, sunday, 'long') + (sameYear ? ' ' + sunday.getUTCFullYear() : '')
        var range = block.querySelector('[data-v2-range="week"]')
        if (range) range.textContent = 'to ' + fmt(sunday, { weekday: 'short', day: 'numeric', month: 'short' }).replace(',', '')
        range = block.querySelector('[data-v2-range="nextweek"]')
        if (range) range.textContent = span(nextMonday, nextSunday, 'short')
      })()
    </script>
  )
}

<style is:global>
  /* ---- Folio line between a thick and a thin rule, then the lede ---- */
  [data-variant-block='v2'] .v2-folio {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding: calc(6px + 0.5rem) 0 0.55rem;
    border-bottom: 1px solid var(--v2-rule);
    background:
      linear-gradient(var(--v2-rule), var(--v2-rule)) 0 0 / 100% 3px no-repeat,
      linear-gradient(var(--v2-rule), var(--v2-rule)) 0 5px / 100% 1px no-repeat;
    font: 600 0.875rem/1.4 var(--v2-sans);
  }
  [data-variant-block='v2'] .v2-folio-line {
    margin: 0;
    font: inherit;
  }
  [data-variant-block='v2'] .v2-folio-link {
    font-weight: 500;
    color: var(--v2-link);
    text-underline-offset: 0.25em;
  }
  [data-variant-block='v2'] .v2-lede {
    margin: 1.5rem 0 2.25rem;
    max-width: 22ch;
    font: 400 clamp(1.875rem, 1.25rem + 2.4vw, 3rem)/1.12 var(--v2-serif);
    letter-spacing: -0.018em;
    text-wrap: balance;
  }
  [data-variant-block='v2'] [data-kind='archive'] .v2-lede {
    font-style: italic;
  }

  /* ---- Sections: a side head in the rail, items in the column ---- */
  [data-variant-block='v2'] .v2-sect {
    padding: 1.1rem 0 1.4rem;
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 52rem) {
    [data-variant-block='v2'] .v2-sect {
      display: grid;
      grid-template-columns: var(--v2-rail) minmax(0, 1fr);
      column-gap: var(--v2-gap);
      align-items: start;
    }
  }
  [data-variant-block='v2'] .v2-sect-head {
    margin: 0 0 0.6rem;
    font: italic 500 1.375rem/1.2 var(--v2-serif);
    letter-spacing: -0.01em;
  }
  @media (min-width: 52rem) {
    [data-variant-block='v2'] .v2-sect-head {
      margin: 0;
      padding-top: 0.45rem;
    }
  }
  [data-variant-block='v2'] .v2-sect-note {
    display: block;
    margin-top: 0.3rem;
    font: 500 0.8125rem/1.3 var(--v2-sans);
    font-style: normal;
    letter-spacing: 0;
    color: var(--color-text-muted);
  }
  [data-variant-block='v2'] .v2-sect-note:empty {
    display: none;
  }
  [data-variant-block='v2'] .v2-month + .v2-month {
    margin-top: 1rem;
  }
  [data-variant-block='v2'] .v2-month-head {
    margin: 0.5rem 0 0.25rem;
    font: 600 0.8125rem/1.3 var(--v2-sans);
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  [data-variant-block='v2'] .v2-month-head::after {
    content: '';
    flex: 1;
    border-top: 1px dotted var(--color-border);
  }

  /* ---- An item: dateline | title, then organizer and venue ---- */
  [data-variant-block='v2'] .v2-items {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  [data-variant-block='v2'] .v2-item {
    display: grid;
    gap: 0.1rem;
    padding: 0.5rem 0;
  }
  @media (min-width: 40rem) {
    [data-variant-block='v2'] .v2-item {
      grid-template-columns: 8.5rem minmax(0, 1fr);
      column-gap: 1rem;
      align-items: baseline;
    }
  }
  [data-variant-block='v2'] .v2-dl {
    font: 600 0.8125rem/1.5 var(--v2-sans);
    color: var(--color-text-muted);
    white-space: nowrap;
  }
  [data-variant-block='v2'] .v2-item-text {
    margin: 0;
  }
  [data-variant-block='v2'] .v2-item-title {
    font: 500 1.25rem/1.3 var(--v2-serif);
    text-decoration: none;
  }
  [data-variant-block='v2'] .v2-item-title:hover .v2-ink {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  [data-variant-block='v2'] .v2-item-sub {
    font-style: italic;
    font-weight: 400;
  }
  [data-variant-block='v2'] .v2-item-meta {
    display: block;
    margin-top: 0.1rem;
    font: italic 400 1rem/1.4 var(--v2-serif);
    color: var(--color-text-muted);
  }
  [data-variant-block='v2'] .v2-until {
    display: none;
  }

  /* Happening now: the title is marked up with a highlighter, once, on arrival. */
  [data-variant-block='v2'] [data-when~='now'] .v2-until {
    display: inline;
  }
  [data-variant-block='v2'] [data-when~='now'] .v2-ink {
    background-image: linear-gradient(var(--v2-mark), var(--v2-mark));
    background-repeat: no-repeat;
    background-position: 0 88%;
    background-size: 100% 0.45em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    animation: v2-mark 0.8s cubic-bezier(0.25, 0.7, 0.3, 1) 0.3s both;
  }
  @keyframes v2-mark {
    from {
      background-size: 0% 0.45em;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-variant-block='v2'] [data-when~='now'] .v2-ink {
      animation: none;
    }
  }

  /* ---- Empty state and end matter ---- */
  [data-variant-block='v2'] .v2-empty p,
  [data-variant-block='v2'] p.v2-empty {
    font: italic 400 1.1875rem/1.5 var(--v2-serif);
    color: var(--color-text-muted);
    margin: 0;
    padding-top: 0.35rem;
  }
  [data-variant-block='v2'] .v2-empty a,
  [data-variant-block='v2'] .v2-end-list a {
    color: var(--v2-link);
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
  [data-variant-block='v2'] .v2-end {
    border-top: 3px solid var(--v2-rule);
    margin-top: 1.5rem;
  }
  [data-variant-block='v2'] .v2-end-list {
    margin: 0;
    padding: 0.3rem 0 0;
    list-style: none;
    font: 400 1.0625rem/1.5 var(--v2-serif);
    max-width: 36rem;
  }
  [data-variant-block='v2'] .v2-end-list li + li {
    margin-top: 0.6rem;
  }
  [data-variant-block='v2'] .v2-end-list strong {
    font: 600 0.875rem/1 var(--v2-sans);
    margin-right: 0.15rem;
  }
  [data-variant-block='v2'] .v2-url {
    overflow-wrap: anywhere;
  }
</style>
