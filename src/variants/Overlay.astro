---
// Debug panel for comparing the variants. Keys: 0–5 switch variant, [ and ] step
// through them, ` collapses the panel. ?v=3 and ?now=2026-11-19T17:30 work in the URL.
import { variants } from './registry'

const list = variants.map(({ id, name, summary }) => ({ id, name, summary }))
---

<aside class="dbg" data-overlay data-variants={JSON.stringify(list)} aria-label="Design variant switcher">
  <div class="dbg-row">
    <button class="dbg-collapse" data-collapse title="Collapse (`)" aria-label="Collapse">▾</button>
    <span class="dbg-label">design</span>
    <div class="dbg-variants">
      {
        list.map((v, i) => (
          <button class="dbg-v" data-pick={v.id} title={`${v.name} — ${v.summary} (key ${i})`}>
            {i}
          </button>
        ))
      }
    </div>
    <button class="dbg-btn theme-toggle" title="Toggle light / dark">◐</button>
  </div>
  <div class="dbg-body">
    <div class="dbg-name"><strong data-name></strong> <span data-summary></span></div>
    <label class="dbg-row dbg-time">
      <span class="dbg-label">now</span>
      <input type="datetime-local" data-now />
      <button class="dbg-btn" data-now-reset title="Back to the real time">real</button>
    </label>
    <div class="dbg-hint">keys 0–5 · [ ] · ` hides</div>
  </div>
</aside>

<script>
  const panel = document.querySelector<HTMLElement>('[data-overlay]')!
  const variants: { id: string; name: string; summary: string }[] = JSON.parse(panel.dataset.variants!)
  const root = document.documentElement
  const store = (k: string, v: string | null) => {
    try {
      if (v === null) localStorage.removeItem(k)
      else localStorage.setItem(k, v)
    } catch {}
  }
  const read = (k: string) => {
    try {
      return localStorage.getItem(k)
    } catch {
      return null
    }
  }

  function show(id: string) {
    root.dataset.variant = id
    store('aarhus-variant', id)
    const url = new URL(location.href)
    url.searchParams.set('v', id.slice(1))
    history.replaceState(null, '', url)
    const v = variants.find((x) => x.id === id)!
    panel.querySelector('[data-name]')!.textContent = `${id.slice(1)} · ${v.name}`
    panel.querySelector('[data-summary]')!.textContent = v.summary
    panel.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.classList.toggle('on', b.dataset.pick === id))
  }
  show(root.dataset.variant!)

  panel.querySelectorAll<HTMLElement>('[data-pick]').forEach((b) => b.addEventListener('click', () => show(b.dataset.pick!)))

  const collapse = (on: boolean) => {
    panel.classList.toggle('collapsed', on)
    store('aarhus-overlay-collapsed', on ? '1' : null)
  }
  collapse(read('aarhus-overlay-collapsed') === '1')
  panel.querySelector('[data-collapse]')!.addEventListener('click', () => collapse(!panel.classList.contains('collapsed')))

  // Pretend-time: stored, then reload so every variant re-sorts from scratch.
  const input = panel.querySelector<HTMLInputElement>('[data-now]')!
  const fixed = read('aarhus-now')
  input.value = fixed ?? ''
  panel.classList.toggle('pretending', !!fixed)
  const setNow = (value: string | null) => {
    store('aarhus-now', value)
    const url = new URL(location.href)
    url.searchParams.delete('now')
    location.replace(url)
  }
  input.addEventListener('change', () => input.value && setNow(input.value))
  panel.querySelector('[data-now-reset]')!.addEventListener('click', () => setNow(null))

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.metaKey || e.ctrlKey || e.altKey) return
    const i = variants.findIndex((x) => x.id === root.dataset.variant)
    if (/^[0-9]$/.test(e.key) && variants[Number(e.key)]) show(variants[Number(e.key)].id)
    else if (e.key === ']') show(variants[(i + 1) % variants.length].id)
    else if (e.key === '[') show(variants[(i - 1 + variants.length) % variants.length].id)
    else if (e.key === '`') collapse(!panel.classList.contains('collapsed'))
  })
</script>

<style>
  .dbg {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 2147483000;
    max-width: calc(100vw - 24px);
    padding: 8px 10px;
    border-radius: 10px;
    background: rgb(17 17 17 / 0.9);
    color: #eee;
    font: 12px/1.4 system-ui, -apple-system, sans-serif;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.3);
    backdrop-filter: blur(8px);
  }
  .dbg-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .dbg-label {
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 10px;
  }
  .dbg-variants {
    display: flex;
    gap: 3px;
  }
  .dbg button {
    font: inherit;
    color: inherit;
    cursor: pointer;
    border: 0;
    background: none;
  }
  .dbg-v {
    width: 24px;
    height: 24px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.08) !important;
  }
  .dbg-v:hover {
    background: rgb(255 255 255 / 0.18) !important;
  }
  .dbg-v.on {
    background: #fff !important;
    color: #111 !important;
    font-weight: 700;
  }
  .dbg-btn {
    padding: 2px 6px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.08) !important;
  }
  .dbg-collapse {
    width: 18px;
    color: #999 !important;
  }
  .dbg-body {
    margin-top: 6px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 300px;
  }
  .dbg-name span {
    color: #aaa;
  }
  .dbg-time input {
    font: inherit;
    color: #eee;
    background: rgb(255 255 255 / 0.08);
    border: 0;
    border-radius: 6px;
    padding: 2px 6px;
    color-scheme: dark;
  }
  .pretending .dbg-time input {
    outline: 1px solid #f5a524;
  }
  .dbg-hint {
    color: #777;
    font-size: 10px;
  }
  .collapsed .dbg-body,
  .collapsed .dbg-label,
  .collapsed .theme-toggle {
    display: none;
  }
  .collapsed .dbg-collapse {
    transform: rotate(-90deg);
  }
</style>
