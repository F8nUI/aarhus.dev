---
// One event in the list: a leg of a journey — time on the left, the topic's
// line in the middle with this event as its station, the event on the right.
import type { ADEvent } from '@lib/event'
import { eventAttrs, relativeAtBuild, topicName } from '../shared'
import { dateLine, lineVars } from './lanes'

interface Props {
  event: ADEvent
  /** Show the topic badge (off on a topic's own page, where every row has the same one). */
  badge: boolean
}

const { event, badge } = Astro.props
const d = dateLine(event)
---

<li class="v4-row v4-c" style={lineVars(event.topic)} {...eventAttrs(event)}>
  <time class="v4-row-when" datetime={d.datetime}>
    <span class="v4-row-day">{d.day}</span>
    <span class:list={['v4-row-time', { 'v4-tba': d.time === 'TBA' }]}>{d.time}</span>
  </time>
  <span class="v4-row-rail" aria-hidden="true"><i></i></span>
  <div class="v4-row-body">
    <a class="v4-row-title" href={event.url}>{event.data.title}</a>
    <p class="v4-row-meta">
      {badge && <span class="v4-badge">{topicName(event.topic)}</span>}
      <span class:list={{ 'v4-tba': !event.data.venue }}>{event.data.venue?.title ?? 'Venue TBA'}</span>
      <span class="v4-rel" data-rel>{relativeAtBuild(event)}</span>
    </p>
  </div>
</li>
