---
// The head event as a portrait poster in its topic's color, pasted beside the board:
// the title stacked in the board's display face, the day as one big number, then
// time, place, organizer and the sign-up button. It stays in view while the board
// scrolls. Narrow screens get it above the board, laid out wide.
import type { ADEvent } from '@lib/event'
import {
  dayNumber,
  eventAttrs,
  linkHost,
  mapUrl,
  monthShort,
  relativeAtBuild,
  timeRange,
  topicName,
  weekdayShort,
  yearOf,
} from '../shared'
import { machineDate } from '../v1/format'
import { titleFit, topicStyle } from '../v5/poster'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, venue, learnMoreURL, endTime } = event.data
const time = timeRange(event)
const year = yearOf(event.start) === yearOf(new Date()) ? undefined : yearOf(event.start)
---

<article class:list={['sp', `fit-${titleFit(title)}`]} style={topicStyle(event.topic)} {...eventAttrs(event)}>
  <p class="sp-strip">
    <span class="sp-up">Featured</span>
    <span class="sp-now"><span class="sp-lamp" aria-hidden="true"></span>Happening now{endTime && ` · until ${endTime}`}</span>
    <span class="sp-rel" data-rel>{relativeAtBuild(event)}</span>
  </p>

  <div class="sp-body">
    <hgroup class="sp-head">
      <p class="sp-topic"><a href={`/${event.topic}`}>{topicName(event.topic)}</a></p>
      <h2 class="sp-title"><a href={event.url}>{title}</a></h2>
      {subtitle && <p class="sp-sub">{subtitle}</p>}
    </hgroup>

    <div class="sp-when">
      <time class="sp-date" datetime={machineDate(event)}>
        <span class="sp-day">{dayNumber(event.start)}</span>
        <span class="sp-dm">
          <span>{weekdayShort(event.start)}</span>
          <span>{monthShort(event.start)}{year && ` ${year}`}</span>
        </span>
      </time>
      <p class:list={['sp-time', { tba: !time }]}>{time || 'Time TBA'}</p>
    </div>

    <dl class="sp-facts">
      <div>
        <dt>Where</dt>
        <dd>
          {
            venue ? (
              <>
                <span class="sp-venue">{venue.title}</span>
                <a href={mapUrl(event)}>{venue.address}</a>
              </>
            ) : (
              <span class="sp-venue">Venue TBA</span>
            )
          }
        </dd>
      </div>
      <div>
        <dt>Organizer</dt>
        <dd><a href={`/organizer/${event.organizer.id}`}>{event.organizer.data.name}</a></dd>
      </div>
    </dl>

    <p class="sp-actions">
      <a class="sp-signup" href={learnMoreURL}>Sign up on {linkHost(learnMoreURL)}&nbsp;→</a>
      <a class="sp-more" href={event.url}>Event details</a>
    </p>
  </div>
</article>

<style is:global>
  [data-variant-block='v4'] {
    /* ---------- beside the board on wide screens ---------- */
    @media (min-width: 64rem) {
      .tt-layout.beside {
        display: grid;
        grid-template-columns: 21rem minmax(0, 1fr);
        column-gap: 3rem;
        align-items: start;
      }
      .tt-layout.beside .heads {
        margin-bottom: 0;
      }
      /* toward the board it doesn't hang: the board's own background does */
      .tt-layout.beside .sp {
        margin-right: 0;
      }
      .tt-layout.beside .sp-body {
        padding-top: 1.25rem;
      }
    }
    /* it stays in view while the board scrolls, where the screen is tall enough to show all of it */
    @media (min-width: 64rem) and (min-height: 48rem) {
      .tt-layout.beside .heads {
        position: sticky;
        top: 1.5rem;
      }
      /* the highlighted event has ended since the build: the board takes the width */
      .tt-layout.beside:not(:has(.heads > [data-when~='upcoming'])) {
        display: block;
      }
    }

    /* ---------- the poster: topic color in both themes ---------- */
    .sp {
      container-type: inline-size;
      margin-inline: calc(-1 * var(--hang));
      background: var(--p);
      color: var(--p-on);
    }
    .sp a {
      color: inherit;
    }
    .sp a:hover {
      color: inherit;
      text-decoration-thickness: 2px;
    }
    .sp :focus-visible {
      outline-color: var(--p-on);
    }

    .sp-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-inline: 1.25rem;
      padding-block: 0.85rem 0.6rem;
      border-bottom: 3px solid currentColor;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .sp-now {
      display: none;
      align-items: center;
      gap: 0.6ch;
    }
    [data-when~='now'] .sp-now {
      display: inline-flex;
    }
    [data-when~='now'] .sp-up,
    [data-when~='now'] .sp-rel {
      display: none;
    }
    .sp-lamp {
      width: 0.55em;
      height: 0.55em;
      background: currentColor;
    }
    @media (prefers-reduced-motion: no-preference) {
      .sp-lamp {
        animation: v1-lamp 2.4s steps(1, end) infinite;
      }
    }

    .sp-body {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding: 1.5rem 1.25rem 1.5rem;
    }

    .sp-topic {
      margin-bottom: 0.6rem;
      font-size: 0.8125rem;
      font-weight: 700;
    }
    .sp-topic a {
      text-decoration: none;
    }
    .sp-topic a:hover {
      text-decoration: underline;
    }
    .sp-title {
      font-family: var(--v1-display);
      font-weight: 800;
      line-height: 0.88;
      letter-spacing: 0.005em;
      text-transform: uppercase;
      text-wrap: balance;
      overflow-wrap: break-word;
    }
    .sp-title a {
      text-decoration: none;
    }
    .sp-title a:hover {
      text-decoration: underline;
      text-decoration-thickness: 0.05em;
      text-underline-offset: 0.08em;
    }
    /* the title fills about the same block, short or long */
    .fit-xs .sp-title {
      font-size: clamp(3rem, 21cqi, 6.5rem);
    }
    .fit-s .sp-title {
      font-size: clamp(2.75rem, 17cqi, 5.5rem);
    }
    .fit-m .sp-title {
      font-size: clamp(2.5rem, 14cqi, 4.75rem);
    }
    .fit-l .sp-title {
      font-size: clamp(2.25rem, 11.5cqi, 4.25rem);
    }
    .sp-sub {
      margin-top: 0.6rem;
      font-size: 0.9375rem;
      font-weight: 700;
    }

    /* the day as one big number, weekday and month beside it */
    .sp-when {
      padding-block: 0.75rem;
      border-block: 3px solid currentColor;
    }
    .sp-date {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .sp-day {
      font-family: var(--v1-display);
      font-size: clamp(5rem, 36cqi, 8.5rem);
      font-weight: 800;
      line-height: 0.8;
      letter-spacing: -0.01em;
      font-variant-numeric: lining-nums;
    }
    .sp-dm {
      display: flex;
      flex-direction: column;
      font-family: var(--v1-display);
      font-size: clamp(1.75rem, 11cqi, 2.75rem);
      font-weight: 800;
      line-height: 0.95;
      text-transform: uppercase;
    }
    .sp-time {
      margin-top: 0.6rem;
      font-size: 1.375rem;
      font-weight: 800;
      letter-spacing: -0.01em;
    }
    .sp-time.tba {
      font-size: 1rem;
    }

    .sp-facts {
      display: grid;
      gap: 0.85rem;
      font-size: 0.875rem;
      line-height: 1.45;
    }
    .sp-facts dt {
      margin-bottom: 0.15rem;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      opacity: 0.8;
    }
    .sp-facts dd {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    .sp-venue {
      font-weight: 800;
    }

    .sp-actions {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .sp .sp-signup {
      display: block;
      padding: 0.85rem 1rem;
      background: var(--p-on);
      color: var(--p);
      font-size: 0.875rem;
      font-weight: 800;
      line-height: 1.35;
      text-decoration: none;
      overflow-wrap: anywhere;
    }
    .sp .sp-signup:hover {
      color: var(--p);
      text-decoration: underline;
    }
    .sp-more {
      font-size: 0.875rem;
    }

    /* ---------- above the board, laid out wide ---------- */
    @container (min-width: 36rem) {
      .sp-body {
        grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
        column-gap: 2.5rem;
        padding: 1.75rem 1.75rem 2rem;
      }
      .sp-strip {
        margin-inline: 1.75rem;
      }
      .sp-head {
        grid-column: 1 / -1;
      }
      .sp-when {
        grid-row: span 2;
        align-self: start;
      }
      .sp-day {
        font-size: 8rem;
      }
      .sp-dm {
        font-size: 2.75rem;
      }
      .fit-xs .sp-title {
        font-size: clamp(3rem, 11cqi, 6.5rem);
      }
      .fit-s .sp-title {
        font-size: clamp(2.75rem, 9cqi, 5.5rem);
      }
      .fit-m .sp-title {
        font-size: clamp(2.5rem, 7.5cqi, 4.75rem);
      }
      .fit-l .sp-title {
        font-size: clamp(2.25rem, 6.5cqi, 4.25rem);
      }
    }

    /* phones: edge to edge, like the today board */
    @media (max-width: 40rem) {
      .sp {
        margin-inline: -1rem;
      }
      .sp-strip {
        margin-inline: 1rem;
      }
      .sp-body {
        padding-inline: 1rem;
      }
    }
  }
</style>
