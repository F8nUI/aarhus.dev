---
// Topic Lanes: an event page. A station header (the topic's line with this
// event as the station you are at, the previous and next events of the same
// topic as its neighbours), then When / Where / Organizer and the buttons.
import type { ADEvent } from '@lib/event'
import { formatLong, getEvents } from '@lib/event'
import {
  editUrl,
  eventAttrs,
  googleCalendarUrl,
  icsFileName,
  icsHref,
  linkHost,
  mapUrl,
  relativeAtBuild,
  topicName,
} from '../shared'
import { dateLine, lineVars, shortTitle } from './lanes'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, venue, learnMoreURL } = event.data
const name = topicName(event.topic)
const when = formatLong(event)
const here = dateLine(event)

const line = await getEvents(event.topic)
const at = line.findIndex((e) => e.id === event.id)
const prev = line[at - 1]
const next = line[at + 1]
// How each side of the line continues: past the neighbour, ending at it, or not built yet.
const left = !prev ? 'none' : at > 1 ? 'more' : 'end'
const right = !next ? 'none' : at < line.length - 2 ? 'more' : 'end'

const year = (e: ADEvent) => e.start.toLocaleDateString('en-GB', { year: 'numeric', timeZone: 'Europe/Copenhagen' })
const stop = (e: ADEvent) => `${dateLine(e).day} ${year(e)}`
---

<article class="v4-event v4-c" style={lineVars(event.topic)} {...eventAttrs(event)}>
  <nav class="v4-strip" aria-label={`${name} events before and after this one`}>
    <a class="v4-strip-line" href={`/${event.topic}`}>
      <span class="v4-badge">{name}</span>
      <span>All {line.length} {name} events</span>
    </a>
    <div class="v4-strip-track">
      <span class="v4-seg v4-seg-l" data-to={left}></span>
      <span class="v4-seg v4-seg-r" data-to={right}></span>
      <div class="v4-slot">
        {
          prev ? (
            <a href={prev.url} aria-label={`Previous ${name} event: ${prev.data.title}, ${stop(prev)}`}>
              <span class="v4-sdot" />
              <span class="v4-sk">Previous</span>
              <span class="v4-st">{shortTitle(prev.data.title)}</span>
              <span class="v4-sd">{stop(prev)}</span>
            </a>
          ) : (
            <p class="v4-snone">No earlier {name} events</p>
          )
        }
      </div>
      <div class="v4-slot v4-slot-here">
        <span class="v4-sdot" aria-hidden="true"></span>
        <span class="v4-sk">This event</span>
        <span class="v4-sd">{here.day} {year(event)}</span>
      </div>
      <div class="v4-slot">
        {
          next ? (
            <a href={next.url} aria-label={`Next ${name} event: ${next.data.title}, ${stop(next)}`}>
              <span class="v4-sdot" />
              <span class="v4-sk">Next</span>
              <span class="v4-st">{shortTitle(next.data.title)}</span>
              <span class="v4-sd">{stop(next)}</span>
            </a>
          ) : (
            <p class="v4-snone">
              <span class="v4-sdot v4-sdot-planned" aria-hidden="true" />
              Next {name} event not announced yet
            </p>
          )
        }
      </div>
    </div>
  </nav>

  <p class="v4-ended">
    This event has ended.
    {
      next && (
        <>
          {' '}
          Next {name} event:{' '}
          <a class="v4-link" href={next.url}>
            {next.data.title}
          </a>
          , {stop(next)}.
        </>
      )
    }
  </p>

  <header class="v4-event-head">
    <h1>{title}</h1>
    {subtitle && <p class="v4-subtitle">{subtitle}</p>}
  </header>

  <dl class="v4-facts">
    <div>
      <dt>When</dt>
      <dd>
        <time datetime={here.datetime} class="v4-fact-main">{when.date}</time>
        <span class:list={['v4-fact-sub', { 'v4-tba': !event.data.startTime }]}>{when.time}</span>
        <span class="v4-live" data-rel>{relativeAtBuild(event)}</span>
      </dd>
    </div>
    <div>
      <dt>Where</dt>
      <dd>
        {
          venue ? (
            <>
              <span class="v4-fact-main">{venue.title}</span>
              <a class="v4-link v4-fact-sub" href={mapUrl(event)}>
                {venue.address}
              </a>
            </>
          ) : (
            <span class="v4-fact-main v4-tba">Venue TBA</span>
          )
        }
      </dd>
    </div>
    <div>
      <dt>Organizer</dt>
      <dd>
        <a class="v4-link v4-fact-main" href={`/organizer/${event.organizer.id}`}>{event.organizer.data.name}</a>
      </dd>
    </div>
  </dl>

  <div class="v4-cta">
    <a class="v4-btn v4-btn-primary" href={learnMoreURL}>Sign up on {linkHost(learnMoreURL)} →</a>
    <a class="v4-btn v4-btn-quiet" href={icsHref(event)} download={icsFileName(event)}>Add to calendar (.ics)</a>
    <a class="v4-btn v4-btn-quiet" href={googleCalendarUrl(event)}>Google Calendar</a>
  </div>

  <div class="prose v4-event-body">
    <slot />
  </div>

  <p class="v4-edit">
    Something wrong or missing? <a class="v4-link" href={editUrl(event)}>Edit on GitHub</a>
  </p>
</article>

<style is:global>
  [data-variant-block='v4'] .v4-event {
    max-width: 52rem;
    padding-top: 0.5rem;
  }

  /* --- Station header ---------------------------------------------------- */

  [data-variant-block='v4'] .v4-strip {
    --dot-y: 22px;
    padding: 1rem 0 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1.5px solid var(--color-border);
  }
  [data-variant-block='v4'] .v4-strip-line {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  [data-variant-block='v4'] .v4-strip-line .v4-badge {
    font-size: 0.95rem;
    line-height: 1.6rem;
    padding: 0 0.6rem;
  }
  [data-variant-block='v4'] .v4-strip-line:hover span:last-child {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  [data-variant-block='v4'] .v4-strip-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    font-family: var(--v4-cond);
  }
  [data-variant-block='v4'] .v4-seg {
    position: absolute;
    top: calc(var(--dot-y) - 4.5px);
    height: 9px;
    background: var(--line);
  }
  [data-variant-block='v4'] .v4-seg-l {
    right: 50%;
  }
  [data-variant-block='v4'] .v4-seg-r {
    left: 50%;
  }
  [data-variant-block='v4'] .v4-seg-l[data-to='more'] {
    left: 0;
    mask-image: linear-gradient(90deg, transparent, #000 3rem);
  }
  [data-variant-block='v4'] .v4-seg-r[data-to='more'] {
    right: 0;
    mask-image: linear-gradient(270deg, transparent, #000 3rem);
  }
  [data-variant-block='v4'] .v4-seg-l[data-to='end'] {
    left: calc(100% / 6);
    border-radius: 999px 0 0 999px;
  }
  [data-variant-block='v4'] .v4-seg-r[data-to='end'] {
    right: calc(100% / 6);
    border-radius: 0 999px 999px 0;
  }
  [data-variant-block='v4'] .v4-seg[data-to='none'] {
    display: none;
  }
  /* Not built yet: the line goes on as a dashed track to a planned stop. */
  [data-variant-block='v4'] .v4-seg-r[data-to='none'] {
    display: block;
    right: calc(100% / 6);
    background: repeating-linear-gradient(90deg, var(--line-faded) 0 12px, transparent 12px 20px);
  }

  [data-variant-block='v4'] .v4-slot {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 0.4rem;
  }
  [data-variant-block='v4'] .v4-slot > a,
  [data-variant-block='v4'] .v4-snone {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 15rem;
  }
  [data-variant-block='v4'] .v4-sdot {
    width: 22px;
    height: 22px;
    margin-top: calc(var(--dot-y) - 11px);
    margin-bottom: 0.6rem;
    border-radius: 50%;
    background: var(--v4-surface);
    border: 5px solid var(--line);
    flex: none;
    transition: transform 0.12s ease-out;
  }
  [data-variant-block='v4'] .v4-slot > a:hover .v4-sdot,
  [data-variant-block='v4'] .v4-slot > a:focus-visible .v4-sdot {
    transform: scale(1.2);
  }
  [data-variant-block='v4'] .v4-slot > a:hover .v4-st {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 2px;
  }
  [data-variant-block='v4'] .v4-slot-here .v4-sdot {
    width: 40px;
    height: 40px;
    margin-top: calc(var(--dot-y) - 20px);
    margin-bottom: 0.45rem;
    border-width: 8px;
    box-shadow: 0 0 0 3px var(--color-bg), 0 0 0 5.5px var(--color-text);
  }
  [data-variant-block='v4'] .v4-event[data-when~='now'] .v4-slot-here .v4-sdot {
    background: var(--line);
    border-color: var(--v4-surface);
    box-shadow: 0 0 0 5px var(--line), 0 0 0 8px var(--color-bg), 0 0 0 10.5px var(--color-text);
  }
  [data-variant-block='v4'] .v4-sdot-planned {
    border-style: dashed;
    border-color: var(--line-faded);
    background: transparent;
  }
  [data-variant-block='v4'] .v4-sk {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }
  [data-variant-block='v4'] .v4-st {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  [data-variant-block='v4'] .v4-sd {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  [data-variant-block='v4'] .v4-slot-here .v4-sk {
    color: var(--color-text);
  }
  [data-variant-block='v4'] .v4-slot-here .v4-sd {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }
  [data-variant-block='v4'] .v4-snone {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.25;
    /* No dot of its own: line the text up with the labels under the dots. */
    padding-top: calc(var(--dot-y) + 11px + 0.6rem);
  }
  [data-variant-block='v4'] .v4-snone:has(.v4-sdot) {
    padding-top: 0;
  }

  /* --- Ended notice ------------------------------------------------------ */

  [data-variant-block='v4'] .v4-ended {
    display: none;
    margin-bottom: 1.25rem;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    background: var(--color-bg-subtle);
    border-left: 6px solid var(--color-text-muted);
    font-weight: 500;
  }
  [data-variant-block='v4'] .v4-event[data-when~='past'] .v4-ended {
    display: block;
  }

  /* --- Title, facts, buttons --------------------------------------------- */

  [data-variant-block='v4'] .v4-event-head h1 {
    font-size: clamp(2rem, 5.5vw, 3rem);
    line-height: 1.04;
    font-weight: 700;
    letter-spacing: -0.024em;
    text-wrap: balance;
  }
  [data-variant-block='v4'] .v4-subtitle {
    margin-top: 0.6rem;
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--color-text-muted);
    max-width: 38rem;
  }

  [data-variant-block='v4'] .v4-facts {
    margin: 1.75rem 0 1.5rem;
    border-top: 1.5px solid var(--color-border);
  }
  [data-variant-block='v4'] .v4-facts > div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 0.25rem 1rem;
    padding: 0.8rem 0;
    border-bottom: 1.5px solid var(--color-border);
  }
  [data-variant-block='v4'] .v4-facts dt {
    font-family: var(--v4-cond);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text-muted);
    padding-top: 0.1rem;
  }
  [data-variant-block='v4'] .v4-facts dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
  }
  [data-variant-block='v4'] .v4-fact-main {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
  }
  [data-variant-block='v4'] .v4-fact-sub {
    font-size: 1.05rem;
  }
  [data-variant-block='v4'] dd > .v4-fact-sub:first-child,
  [data-variant-block='v4'] dd > .v4-fact-main + a.v4-fact-sub {
    flex-basis: 100%;
  }
  [data-variant-block='v4'] .v4-facts time + .v4-fact-sub {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  [data-variant-block='v4'] .v4-live {
    font-family: var(--v4-cond);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1.5rem;
    padding: 0 0.6rem;
    border-radius: 999px;
    background: var(--color-bg-subtle);
  }
  [data-variant-block='v4'] .v4-event[data-when~='now'] .v4-live,
  [data-variant-block='v4'] .v4-event[data-when~='today'] .v4-live {
    background: var(--line);
    color: var(--line-ink);
  }
  [data-variant-block='v4'] .v4-event[data-when~='past'] .v4-live {
    color: var(--color-text-muted);
    font-weight: 600;
  }

  [data-variant-block='v4'] .v4-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.75rem;
  }

  [data-variant-block='v4'] .v4-event-body {
    padding-top: 0.25rem;
  }
  [data-variant-block='v4'] .v4-edit {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1.5px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  [data-variant-block='v4'] .v4-edit a {
    font-weight: 600;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    [data-variant-block='v4'] .v4-strip {
      padding-top: 0.5rem;
    }
    [data-variant-block='v4'] .v4-st {
      font-size: 0.9rem;
    }
    [data-variant-block='v4'] .v4-facts > div {
      grid-template-columns: 1fr;
    }
    [data-variant-block='v4'] .v4-cta .v4-btn {
      flex: 1 1 auto;
      justify-content: center;
    }
    [data-variant-block='v4'] .v4-cta .v4-btn-primary {
      flex-basis: 100%;
    }
  }
</style>
