---
// Topic Lanes: the page frame. Header with the line index (one swatch per topic),
// footer that ends like a line terminus. Holds the colour tokens and the styles
// every v4 page shares, text pages included.
import { calendarFeed, topicName } from '../shared'
import { lineVars } from './lanes'

interface Props {
  topic?: string
  topics: string[]
}

const { topic, topics } = Astro.props
const lines = [...topics].sort()
---

<div class="v4">
  <header class="v4-top">
    <div class="v4-top-row">
      <a class="v4-brand" href="/">
        <svg class="v4-mark" viewBox="0 0 36 28" width="36" height="28" aria-hidden="true">
          <path d="M3 21 H15 L25 7 H33" class="v4-mark-a"></path>
          <path d="M3 7 H9 L15 21 H33" class="v4-mark-b"></path>
          <circle cx="15" cy="21" r="5"></circle>
        </svg>
        <span>aarhus.dev</span>
      </a>
      <button class="theme-toggle v4-theme" type="button" aria-label="Switch between light and dark">
        <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
        </svg>
        <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path>
        </svg>
      </button>
    </div>
    <nav class="v4-index" aria-label="Topics">
      <a href="/" class="v4-index-all" aria-current={topic ? undefined : 'true'}>All topics</a>
      {
        lines.map((t) => (
          <a href={`/${t}`} class="v4-c" style={lineVars(t)} aria-current={t === topic ? 'page' : undefined}>
            <span class="v4-swatch" aria-hidden="true" />
            {topicName(t)}
          </a>
        ))
      }
    </nav>
  </header>

  <main class="v4-main">
    <slot />
  </main>

  <footer class="v4-foot">
    <div class="v4-foot-line" aria-hidden="true"><span></span></div>
    <div class="v4-foot-row">
      <p>Tech events in Aarhus, Denmark. Kept on GitHub by the people who run them.</p>
      <nav aria-label="Site">
        <a href="/about">About</a>
        <a href="/add-event">Add event</a>
        <a href="https://github.com/f8nui/aarhus.dev">GitHub</a>
        <a href={calendarFeed.webcal}>Subscribe</a>
      </nav>
    </div>
  </footer>
</div>

<script is:inline>
  ;(function () {
    // On a phone the topic index scrolls sideways: bring the current topic into view once it has a size.
    var nav = document.querySelector('[data-variant-block="v4"] .v4-index')
    var current = nav && nav.querySelector('[aria-current]')
    if (!current || !('ResizeObserver' in window)) return
    var done = false
    new ResizeObserver(function () {
      if (done || nav.clientWidth === 0) return
      done = true
      if (nav.scrollWidth > nav.clientWidth) nav.scrollLeft = current.offsetLeft - nav.offsetLeft - 24
    }).observe(nav)
  })()
</script>

<style is:global>
  /* --- Tokens ------------------------------------------------------------ */

  :root[data-variant='v4'] {
    color-scheme: light;
    --color-bg: #f3f5f6;
    --color-bg-subtle: #e7ebee;
    --color-text: #14181d;
    --color-text-muted: #56606a;
    --color-border: #d2d8dd;
    --v4-surface: #ffffff;
    --v4-grid: #e9edf0;
    --v4-shadow: 0 1px 2px rgb(20 24 29 / 0.06), 0 8px 24px -12px rgb(20 24 29 / 0.18);
    --v4-sans: 'Barlow', ui-sans-serif, system-ui, sans-serif;
    --v4-cond: 'Barlow Semi Condensed', 'Barlow', ui-sans-serif, system-ui, sans-serif;
  }
  :root[data-variant='v4'][data-theme='dark'] {
    color-scheme: dark;
    --color-bg: #1a1d21;
    --color-bg-subtle: #272b31;
    --color-text: #eef0f2;
    --color-text-muted: #a4adb6;
    --color-border: #3a4148;
    --v4-surface: #22262b;
    --v4-grid: #2c3137;
    --v4-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 10px 28px -14px rgb(0 0 0 / 0.7);
  }
  @media (prefers-color-scheme: dark) {
    :root[data-variant='v4']:not([data-theme='light']) {
      color-scheme: dark;
      --color-bg: #1a1d21;
      --color-bg-subtle: #272b31;
      --color-text: #eef0f2;
      --color-text-muted: #a4adb6;
      --color-border: #3a4148;
      --v4-surface: #22262b;
      --v4-grid: #2c3137;
      --v4-shadow: 0 1px 2px rgb(0 0 0 / 0.3), 0 10px 28px -14px rgb(0 0 0 / 0.7);
    }
  }

  /* A topic's line colour: --c / --cd come inline from lineVars(). */
  [data-variant-block='v4'] .v4-c {
    --line: var(--c);
    --line-ink: var(--ik);
    --line-faded: color-mix(in oklab, var(--line) 30%, var(--v4-surface));
  }
  :root[data-variant='v4'][data-theme='dark'] [data-variant-block='v4'] .v4-c {
    --line: var(--cd);
    --line-ink: var(--ikd);
    --line-faded: color-mix(in oklab, var(--line) 34%, var(--v4-surface));
  }
  @media (prefers-color-scheme: dark) {
    :root[data-variant='v4']:not([data-theme='light']) [data-variant-block='v4'] .v4-c {
      --line: var(--cd);
      --line-ink: var(--ikd);
      --line-faded: color-mix(in oklab, var(--line) 34%, var(--v4-surface));
    }
  }

  /* --- Frame ------------------------------------------------------------- */

  [data-variant-block='v4'] .v4 {
    font-family: var(--v4-sans);
    font-size: 1rem;
    line-height: 1.5;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    max-width: 78rem;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3.5vw, 2.5rem);
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
  }
  [data-variant-block='v4'] a {
    color: inherit;
    text-decoration: none;
  }
  [data-variant-block='v4'] a:hover {
    color: inherit;
  }
  [data-variant-block='v4'] :focus-visible {
    outline: 2.5px solid var(--color-text);
    outline-offset: 3px;
    border-radius: 4px;
  }

  [data-variant-block='v4'] .v4-top {
    padding: 1.25rem 0 0.75rem;
  }
  [data-variant-block='v4'] .v4-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  [data-variant-block='v4'] .v4-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
    font-size: 1.375rem;
    letter-spacing: -0.01em;
  }
  [data-variant-block='v4'] .v4-mark path {
    fill: none;
    stroke-width: 4.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  [data-variant-block='v4'] .v4-mark-a {
    stroke: #0d9488;
  }
  [data-variant-block='v4'] .v4-mark-b {
    stroke: #f05138;
  }
  [data-variant-block='v4'] .v4-mark circle {
    fill: var(--v4-surface);
    stroke: var(--color-text);
    stroke-width: 2.5;
  }
  [data-variant-block='v4'] .v4-theme {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-border);
    background: var(--v4-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  [data-variant-block='v4'] .v4-theme:hover {
    border-color: var(--color-text-muted);
  }
  [data-variant-block='v4'] .v4-theme svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  /* The line index: every topic as a swatch of its line. */
  [data-variant-block='v4'] .v4-index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.35rem;
    margin-top: 1rem;
    font-family: var(--v4-cond);
    font-weight: 600;
    font-size: 0.95rem;
  }
  [data-variant-block='v4'] .v4-index a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.2rem 0.65rem 0.2rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
    line-height: 1.5rem;
  }
  [data-variant-block='v4'] .v4-index a:hover {
    background: var(--color-bg-subtle);
  }
  [data-variant-block='v4'] .v4-index .v4-index-all {
    padding-left: 0.65rem;
  }
  [data-variant-block='v4'] .v4-swatch {
    width: 1.1rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--line);
    flex: none;
  }
  [data-variant-block='v4'] .v4-index a[aria-current] {
    background: var(--line, var(--color-text));
    color: var(--line-ink, var(--color-bg));
  }
  [data-variant-block='v4'] .v4-index a[aria-current] .v4-swatch {
    background: var(--line-ink);
  }
  @media (max-width: 640px) {
    [data-variant-block='v4'] .v4-index {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin: 0.75rem calc(-1 * clamp(1rem, 3.5vw, 2.5rem)) 0;
      padding: 0.15rem clamp(1rem, 3.5vw, 2.5rem) 0.35rem;
      scrollbar-width: none;
      mask-image: linear-gradient(90deg, transparent 0, #000 1rem, #000 calc(100% - 2rem), transparent);
    }
  }

  [data-variant-block='v4'] .v4-main {
    flex: 1;
    padding: 0.75rem 0 4rem;
    min-width: 0;
  }

  /* Footer: the end of the line. */
  [data-variant-block='v4'] .v4-foot {
    padding: 0 0 2rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  [data-variant-block='v4'] .v4-foot-line {
    position: relative;
    height: 6px;
    border-radius: 999px;
    background: var(--color-text);
    margin: 0 0 1.25rem 0.5rem;
  }
  [data-variant-block='v4'] .v4-foot-line span {
    position: absolute;
    left: -0.5rem;
    top: 50%;
    width: 1.25rem;
    height: 1.25rem;
    transform: translateY(-50%);
    border-radius: 50%;
    background: var(--color-bg);
    border: 4px solid var(--color-text);
  }
  [data-variant-block='v4'] .v4-foot-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }
  [data-variant-block='v4'] .v4-foot nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-weight: 600;
    color: var(--color-text);
  }
  [data-variant-block='v4'] .v4-foot nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  /* --- Shared pieces ----------------------------------------------------- */

  /* A line badge: the topic's name on its colour. */
  [data-variant-block='v4'] .v4-badge {
    display: inline-block;
    font-family: var(--v4-cond);
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.3rem;
    padding: 0 0.5rem;
    border-radius: 0.35rem;
    background: var(--line);
    color: var(--line-ink);
    white-space: nowrap;
  }

  [data-variant-block='v4'] .v4-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    font-weight: 600;
    border: 2px solid var(--color-text);
    line-height: 1.2;
  }
  [data-variant-block='v4'] .v4-btn-primary {
    background: var(--color-text);
    color: var(--color-bg);
  }
  [data-variant-block='v4'] .v4-btn-primary:hover {
    color: var(--color-bg);
    background: color-mix(in oklab, var(--color-text) 85%, var(--color-bg));
  }
  [data-variant-block='v4'] .v4-btn-quiet {
    border-color: var(--color-border);
    background: var(--v4-surface);
  }
  [data-variant-block='v4'] .v4-btn-quiet:hover {
    border-color: var(--color-text-muted);
  }

  [data-variant-block='v4'] .v4-link {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-text-muted);
  }
  [data-variant-block='v4'] .v4-link:hover {
    text-decoration-color: currentColor;
  }

  /* --- Text pages (About, Add event, organizers) ------------------------- */

  [data-variant-block='v4'] .v-page {
    max-width: 42rem;
  }
  [data-variant-block='v4'] .v-page-header {
    padding: 1.5rem 0 1.75rem;
    margin-bottom: 1.75rem;
    position: relative;
  }
  [data-variant-block='v4'] .v-page-header::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 5rem;
    height: 6px;
    border-radius: 999px;
    background: var(--color-text);
  }
  [data-variant-block='v4'] .v-page-header h1 {
    font-size: clamp(2rem, 6vw, 2.75rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  [data-variant-block='v4'] .v-page-description {
    margin-top: 0.6rem;
    font-size: 1.2rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }
  [data-variant-block='v4'] .v-page-website {
    display: inline-block;
    margin-top: 0.75rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  [data-variant-block='v4'] .prose {
    font-size: 1.0625rem;
    line-height: 1.65;
    max-width: 40rem;
  }
  [data-variant-block='v4'] .prose > * + * {
    margin-top: 0.9rem;
  }
  [data-variant-block='v4'] .prose p,
  [data-variant-block='v4'] .prose ul,
  [data-variant-block='v4'] .prose ol {
    margin-bottom: 0;
  }
  [data-variant-block='v4'] .prose h1,
  [data-variant-block='v4'] .prose h2,
  [data-variant-block='v4'] .prose h3 {
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  [data-variant-block='v4'] .prose h1 {
    font-size: 1.75rem;
  }
  [data-variant-block='v4'] .prose h2 {
    font-size: 1.375rem;
    margin-top: 2.25rem;
    margin-bottom: 0;
  }
  [data-variant-block='v4'] .prose h3 {
    font-size: 1.125rem;
    margin-top: 1.75rem;
    margin-bottom: 0;
  }
  [data-variant-block='v4'] .prose a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    text-decoration-color: var(--color-text-muted);
  }
  [data-variant-block='v4'] .prose a:hover {
    text-decoration-color: currentColor;
  }
  [data-variant-block='v4'] .prose strong {
    font-weight: 700;
  }
  [data-variant-block='v4'] .prose ul,
  [data-variant-block='v4'] .prose ol {
    list-style: none;
    padding-left: 1.75rem;
  }
  [data-variant-block='v4'] .prose li {
    position: relative;
    margin: 0.35rem 0 0;
  }
  /* Bullets are small stations on a line. */
  [data-variant-block='v4'] .prose ul > li::before {
    content: '';
    position: absolute;
    left: -1.35rem;
    top: 0.5em;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    border: 2.5px solid var(--color-text);
    background: var(--v4-surface);
  }
  [data-variant-block='v4'] .prose ol {
    counter-reset: v4-step;
    padding-left: 2.25rem;
  }
  [data-variant-block='v4'] .prose ol > li {
    counter-increment: v4-step;
  }
  [data-variant-block='v4'] .prose ol > li::before {
    content: counter(v4-step);
    position: absolute;
    left: -2.25rem;
    top: 0.15em;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    font-family: var(--v4-cond);
    font-weight: 700;
    font-size: 0.85rem;
    line-height: 1.5rem;
    text-align: center;
  }
  [data-variant-block='v4'] .prose code {
    font-size: 0.875em;
    padding: 0.1em 0.35em;
    border-radius: 4px;
    background: var(--color-bg-subtle);
  }
  /* Code blocks in ink on the map's paper, in both themes (the highlighter's own colours are for a dark page). */
  [data-variant-block='v4'] .prose pre {
    padding: 1rem 1.15rem;
    border-radius: 10px;
    background: var(--v4-surface) !important;
    color: var(--color-text) !important;
    border: 1.5px solid var(--color-border);
    border-left: 6px solid var(--color-text);
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  [data-variant-block='v4'] .prose pre code {
    padding: 0;
    background: transparent;
    font-size: inherit;
  }
  [data-variant-block='v4'] .prose pre code span {
    color: inherit !important;
  }
  [data-variant-block='v4'] .prose blockquote {
    border-left: 6px solid var(--color-border);
    border-radius: 3px;
    padding-left: 1rem;
    color: var(--color-text-muted);
  }
  [data-variant-block='v4'] .prose hr {
    border: 0;
    height: 6px;
    border-radius: 999px;
    background: var(--color-border);
    margin: 2rem 0;
  }
  [data-variant-block='v4'] .prose table {
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  [data-variant-block='v4'] .prose th,
  [data-variant-block='v4'] .prose td {
    border-bottom: 1px solid var(--color-border);
    padding: 0.4rem 0.75rem 0.4rem 0;
    text-align: left;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-variant-block='v4'] *,
    [data-variant-block='v4'] *::before,
    [data-variant-block='v4'] *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }
</style>
