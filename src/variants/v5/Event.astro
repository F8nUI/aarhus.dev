---
// An event page: the event as a poster, then its description.
import type { ADEvent } from '@lib/event'
import { editUrl, eventAttrs, topicName } from '../shared'
import Poster from './Poster.astro'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
---

<article class="event-page" {...eventAttrs(event)}>
  <Poster event={event} page />

  <div class="event-body">
    <div class="prose">
      <slot />
    </div>
    <p class="event-links">
      <a href={editUrl(event)}>Edit on GitHub</a>
      <a href={`/${event.topic}`}>More {topicName(event.topic)} events</a>
    </p>
  </div>
</article>
