---
// Home, topic and archive lists. Upcoming: the next event as a poster, what else is
// on now or later today, then a one-line index by week. Archive: a wall of small posters.
import type { ADEvent } from '@lib/event'
import { calendarFeed, eventAttrs, groupBy, topicName, yearOf } from '../shared'
import Poster from './Poster.astro'
import { dateLabel, startStamp, titleFit, topicStyle } from './poster'

interface Props {
  events: ADEvent[]
  topic?: string
  past: boolean
}

const { events, topic, past } = Astro.props
const name = topic ? topicName(topic) : undefined
const now = Date.now()
// The poster shown before the script picks one: the next event at build time.
const nextAtBuild = events.find((e) => e.end.valueOf() >= now)
const newestFirst = [...events].reverse()
const home = topic ? `/${topic}` : '/'
const archive = topic ? `/past/${topic}` : '/past'

const index = [
  { tag: 'week', title: 'This week' },
  { tag: 'nextweek', title: 'Next week' },
  { tag: 'later', title: 'Later' },
]
---

{
  past ? (
    <div class="archive">
      <header class="list-head">
        <h1>{name ? `Past ${name} events` : 'Past events'}</h1>
        <p class="list-links">
          <a href={home}>{name ? `Upcoming ${name} events` : 'Upcoming events'}</a>
        </p>
      </header>

      <div data-bucket="past">
        {groupBy(newestFirst, (e) => yearOf(e.start)).map((year) => (
          <section class="wall-year" data-group>
            <h2 class="wall-label">{year.key}</h2>
            <ol class="wall">
              {year.items.map((event) => (
                <li class={`mini fit-${titleFit(event.data.title)}`} style={topicStyle(event.topic)} {...eventAttrs(event)}>
                  <a href={event.url}>
                    <time class="mini-date" datetime={startStamp(event)}>
                      {dateLabel(event)} · {event.data.startTime ?? 'TBA'}
                    </time>
                    <span class="mini-title">{event.data.title}</span>
                    <span class="mini-org">{event.organizer.data.name}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>

      <div class="empty" data-empty="past">
        <p class="empty-title">Nothing here yet</p>
        <p>{name ? `Past ${name} events show up here once they have happened.` : 'Events show up here once they have happened.'}</p>
      </div>
    </div>
  ) : (
    <div class="upcoming">
      <header class="list-head">
        <h1>{name ? `${name} events in Aarhus` : 'Tech events in Aarhus'}</h1>
        <p class="list-links">
          <a href={calendarFeed.webcal}>Subscribe</a>
          <a href={archive}>
            <span data-count="past">{events.filter((e) => e.end.valueOf() < now).length}</span> past events
          </a>
        </p>
      </header>

      <div class="posters">
        {events.map((event) => (
          <Poster event={event} shown={event === nextAtBuild} />
        ))}
      </div>

      <div class="also" data-v5-index>
        <section data-bucket="now">
          <h2>Also happening now</h2>
          <ul>
            {events.map((event) => (
              <li {...eventAttrs(event)} style={topicStyle(event.topic)}>
                <span class="also-time">{event.data.endTime ? `until ${event.data.endTime}` : 'now'}</span>
                <a href={event.url}>{event.data.title}</a>
                <span class="also-org">{event.organizer.data.name}</span>
              </li>
            ))}
          </ul>
        </section>
        <section data-bucket="today">
          <h2>Later today</h2>
          <ul>
            {events.map((event) => (
              <li {...eventAttrs(event)} style={topicStyle(event.topic)}>
                <time class="also-time" datetime={startStamp(event)}>
                  {event.data.startTime ?? 'TBA'}
                </time>
                <a href={event.url}>{event.data.title}</a>
                <span class="also-org">{event.organizer.data.name}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>

      <div class="index" data-v5-index>
        {index.map(({ tag, title }) => (
          <section class="index-group" data-bucket={tag}>
            <h2>{title}</h2>
            {groupBy(events, (e) => yearOf(e.start)).map((year) => (
              <div data-group>
                {tag === 'later' && <h3 class="index-year">{year.key}</h3>}
                <ol>
                  {year.items.map((event) => (
                    <li class="row" {...eventAttrs(event)} style={topicStyle(event.topic)}>
                      <time class="row-when" datetime={startStamp(event)}>
                        <span class="row-date">{dateLabel(event)}</span>
                        <span class="row-time">{event.data.startTime ?? 'TBA'}</span>
                      </time>
                      <a class="row-title" href={event.url}>
                        {event.data.title}
                        {event.data.subtitle && <span class="row-sub">{event.data.subtitle}</span>}
                      </a>
                      <span class="row-org">{event.organizer.data.name}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </section>
        ))}
      </div>

      <div class="empty" data-empty="upcoming">
        <p class="empty-title">{name ? `No ${name} events on the calendar` : 'No events on the calendar'}</p>
        <p>
          Know of one? <a href="/add-event">Add it</a>, or look back at <a href={archive}>past events</a>.
        </p>
      </div>

      <footer class="list-foot">
        <a href={archive}>
          {name ? `Past ${name} events` : 'Past events'} (<span data-count="past">{events.filter((e) => e.end.valueOf() < now).length}</span>)
        </a>
        <a href={calendarFeed.webcal}>Subscribe in your calendar app</a>
        <a href={calendarFeed.https}>Calendar feed (.ics)</a>
        <a href="/add-event">Add an event</a>
      </footer>

      <script is:inline>
        // Show the poster for the first event that has not ended yet — "next" depends on
        // when someone looks — and drop that event from the lines below it.
        ;(function (block) {
          if (!block) return
          var now = window.aarhusNow ? window.aarhusNow() : Date.now()
          var pick = null
          block.querySelectorAll('[data-v5-poster]').forEach(function (poster) {
            poster.classList.remove('is-shown')
            if (!pick && Date.parse(poster.dataset.end) >= now) pick = poster
          })
          if (!pick) return
          pick.classList.add('is-shown')
          block.querySelectorAll('[data-v5-index] [data-id="' + pick.dataset.id + '"]').forEach(function (item) {
            item.remove()
          })
        })(document.currentScript && document.currentScript.closest('[data-variant-block="v5"]'))
      </script>
    </div>
  )
}
