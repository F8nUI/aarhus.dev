---
// The timetable: today's board (now + later today), then this week, next week and
// later by month. The archive (/past) is the same rows, newest first, by month.
// Every event is rendered into each bucket it could fall in; the runtime tags each
// row with data-when on every visit and the bucket CSS shows it in the right place.
//
// v2–v4 pass a Head component: the first highlighted event that hasn't ended is
// drawn with it above the board, or beside it with headBeside.
import type { ADEvent } from '@lib/event'
import { calendarFeed, eventAttrs, formatMonth, groupBy, topicName } from '../shared'
import Row from './Row.astro'

interface Props {
  events: ADEvent[]
  topic?: string
  past: boolean
  /** Draws one head event. Its root element carries eventAttrs(event). */
  Head?: (props: { event: ADEvent }) => any
  /** The head event beside the board on wide screens; the variant styles `.tt-layout.beside`. */
  headBeside?: boolean
}

const { events, topic, past, Head, headBeside = false } = Astro.props

// What had ended at build time can never be upcoming again: leave it out of the
// upcoming buckets, but keep a bare entry so the past count still sees it.
const buildTime = Date.now()
const live = events.filter((e) => e.end.valueOf() >= buildTime)
const ended = events.filter((e) => e.end.valueOf() < buildTime)

// Every highlighted event still to come is drawn; CSS shows the first one not yet past.
const heads = Head && !past ? live.filter((e) => e.data.highlight) : []

const name = topic ? topicName(topic) : undefined
const pastHref = topic ? `/past/${topic}` : '/past'
const upcomingHref = topic ? `/${topic}` : '/'
const heading = past ? (name ? `Past ${name} events` : 'Past events') : name ? `${name} events in Aarhus` : 'Tech events in Aarhus'

const laterMonths = groupBy(live, (e) => formatMonth(e.start))
const archiveMonths = groupBy([...events].reverse(), (e) => formatMonth(e.start))
---

<div class="tt">
  <div class="tt-title">
    <h1>{heading}</h1>
    <p class="tt-tools">
      {
        past ? (
          <a href={upcomingHref}>Upcoming</a>
        ) : (
          <a class="tt-past" href={pastHref}>
            Past events <span class="count">(<span data-count="past">{ended.length}</span>)</span>
          </a>
        )
      }
      <span class="tt-feed">
        <a href={calendarFeed.webcal}>Subscribe</a>
        <a class="tt-https" href={calendarFeed.https} title="The calendar feed's web address, for apps that ask for a URL">
          (.ics)
        </a>
      </span>
      <a href="/add-event">Add event</a>
    </p>
  </div>

  {
    past ? (
      <div class="tt-board">
        <div class="cols" aria-hidden="true">
          <span class="when"><span>Day</span><span>Time</span></span>
          <span class="col-topic">Topic</span>
          <span class="col-event">Event</span>
          <span class="col-venue">Venue</span>
          <span class="col-status">Status</span>
        </div>
        <section class="sect" data-bucket="past" aria-label="Past events">
          {archiveMonths.map((month) => (
            <div class="month" data-group>
              <h2 class="month-head">{month.key}</h2>
              <ol class="rows">
                {month.items.map((event) => (
                  <Row event={event} />
                ))}
              </ol>
            </div>
          ))}
        </section>
        <div class="empty" data-empty="past">
          <p>Nothing in the archive yet.</p>
          <p class="empty-sub">
            Events move here the day after they end. <a href={upcomingHref}>See what's coming up</a>
          </p>
        </div>
      </div>
    ) : (
      <div class:list={['tt-layout', { beside: headBeside && heads.length > 0 }]}>
        {heads.length > 0 && Head && (
          <div class="heads">
            {heads.map((event) => (
              <Head event={event} />
            ))}
          </div>
        )}

        <div class="tt-board">
          <div class="cols" aria-hidden="true">
            <span class="when"><span>Day</span><span>Time</span></span>
            <span class="col-topic">Topic</span>
            <span class="col-event">Event</span>
            <span class="col-venue">Venue</span>
            <span class="col-status">Status</span>
          </div>

          <section class="board" aria-label="Today">
            <h2 class="board-head">Today</h2>
            <ol class="rows" data-bucket="now">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
            <ol class="rows" data-bucket="today">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>

          <section class="sect" data-bucket="week">
            <h2 class="sect-head">This week</h2>
            <ol class="rows">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>

          <section class="sect" data-bucket="nextweek">
            <h2 class="sect-head">Next week</h2>
            <ol class="rows">
              {live.map((event) => (
                <Row event={event} />
              ))}
            </ol>
          </section>

          <section class="sect" data-bucket="later">
            <h2 class="sect-head">Later</h2>
            {laterMonths.map((month) => (
              <div class="month" data-group>
                <h3 class="month-head">{month.key}</h3>
                <ol class="rows">
                  {month.items.map((event) => (
                    <Row event={event} />
                  ))}
                </ol>
              </div>
            ))}
          </section>

          <div class="empty" data-empty="upcoming">
            <p>No {name ? `${name} ` : ''}events on the board yet.</p>
            <p class="empty-sub">
              Know of one coming up? <a href="/add-event">Add an event</a>
            </p>
          </div>

          <p class="tt-end">
            <a class="tt-past" href={pastHref}>
              Past {name ? `${name} ` : ''}events (<span data-count="past">{ended.length}</span>)
            </a>
          </p>

          <div hidden>
            {ended.map((event) => (
              <i {...eventAttrs(event)} />
            ))}
          </div>
        </div>
      </div>
    )
  }
</div>

<style is:global>
  :is([data-variant-block='v1'], [data-variant-block='v2'], [data-variant-block='v3'], [data-variant-block='v4']) {
    /* --hang (in Shell.astro): how far backgrounds hang outside the text edge. */
    /* Space between the big blocks: head event, today, this week, next week, later. */
    --gap: 2.5rem;

    /* ---------- title line ---------- */
    .tt-title {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 2rem;
      margin-bottom: 2rem;
    }
    .tt-title h1 {
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.01em;
    }
    .tt-tools {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.5rem;
      font-size: 0.875rem;
    }
    .tt-tools a {
      color: var(--color-text-muted);
    }
    .tt-tools a:hover {
      color: var(--color-text);
    }
    .tt-feed {
      display: inline-flex;
      gap: 0.5ch;
    }
    .tt-https {
      text-decoration: none;
    }
    .count {
      font-variant-numeric: tabular-nums;
    }
    /* No past events: no link to them. */
    &:not(:has([data-when~='past'])) .tt-past {
      display: none;
    }

    /* ---------- head event: only the first highlighted one still to come ---------- */
    .heads {
      margin-bottom: var(--gap);
    }
    .heads > [data-when~='past'],
    .heads > [data-when~='upcoming'] ~ [data-when~='upcoming'],
    .heads:not(:has(> [data-when~='upcoming'])) {
      display: none;
    }

    /*
     * The board's blocks stack with one gap; a hidden block (an empty today board,
     * a week with nothing on) takes no space. The rows lay out by the board's own
     * width, so it reads the same full width or beside a head event.
     */
    .tt-board {
      container: board / inline-size;
      display: flex;
      flex-direction: column;
      gap: var(--gap);
    }

    /* ---------- the column grid, shared by the header and every row ---------- */
    .cols,
    .row {
      display: grid;
      grid-template-columns: 17ch 12ch minmax(0, 1fr) 20ch 13ch;
      column-gap: 2ch;
    }
    .when {
      display: grid;
      grid-template-columns: 10ch 5ch;
      column-gap: 2ch;
      align-content: start;
    }

    .cols {
      position: sticky;
      top: 0;
      z-index: 2;
      /* sits right on top of the first block, not a whole gap above it */
      margin-bottom: calc(0.75rem - var(--gap));
      padding-block: 0.5rem;
      background: var(--color-bg);
      /* the page color reaches as far as the rows' hover, so nothing shows beside it when stuck */
      box-shadow:
        calc(-1 * var(--hang)) 0 0 var(--color-bg),
        var(--hang) 0 0 var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      /* the grid is sized in the rows' ch; only the labels are small */
      font-size: 0.9375rem;
      color: var(--color-text-muted);
    }
    .cols > :not(.when),
    .cols .when > span {
      font-size: 0.75rem;
    }
    .col-status {
      text-align: right;
    }
    &:not(:has([data-when~='upcoming'])) .cols {
      display: none;
    }

    /* ---------- rows ---------- */
    .row {
      position: relative;
      isolation: isolate;
      grid-template-areas:
        'when topic title venue status'
        'when topic org venue status';
      align-items: start;
      padding-block: 0.75rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.9375rem;
      line-height: 1.45;
    }
    /* hover and focus fill, hanging past the text edge */
    .row::before {
      content: '';
      position: absolute;
      inset: 0 calc(-1 * var(--hang));
      z-index: -1;
    }
    .row:hover::before {
      background: var(--color-bg-subtle);
    }
    .row:has(.title:focus-visible)::before {
      outline: 2px solid var(--v1-focus);
      outline-offset: -2px;
    }
    .row .when {
      grid-area: when;
      white-space: pre;
    }
    .when-time.tba,
    .venue.tba {
      color: var(--color-text-muted);
    }
    .row .topic {
      grid-area: topic;
      display: flex;
      align-items: baseline;
      gap: 0.75ch;
      color: var(--color-text-muted);
      font-size: 0.8125rem;
      line-height: calc(0.9375rem * 1.45);
    }
    .main {
      display: contents;
    }
    .title {
      grid-area: title;
      color: var(--v1-title);
      font-weight: 700;
      text-decoration: none;
      text-wrap: pretty;
    }
    .title::after {
      content: '';
      position: absolute;
      inset: 0 calc(-1 * var(--hang));
    }
    .title:hover {
      color: var(--v1-title);
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
    }
    .title:focus-visible {
      outline: none;
    }
    .sub {
      margin-left: 1ch;
      font-weight: 400;
      color: var(--color-text-muted);
    }
    .org {
      grid-area: org;
      position: relative;
      z-index: 1;
      justify-self: start;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .org:hover {
      color: var(--color-text);
      text-decoration: underline;
    }
    .venue {
      grid-area: venue;
      min-width: 0;
      overflow-wrap: anywhere;
    }
    .town {
      display: block;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
    }

    /* ---------- status ---------- */
    .row .status {
      grid-area: status;
      justify-self: end;
      text-align: right;
    }
    .status {
      font-size: 0.8125rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      line-height: calc(0.9375rem * 1.45);
      color: var(--color-text-muted);
    }
    .st-now,
    .st-today,
    .st-ended {
      display: none;
    }
    [data-when~='now'] .st-now {
      display: inline-flex;
      align-items: center;
      gap: 0.6ch;
      padding: 0 0.6ch;
      background: var(--v1-accent);
      color: #17140f;
    }
    [data-when~='today'] .st-today {
      display: inline;
      color: var(--v1-accent-text);
    }
    [data-when~='now'] .st-rel,
    [data-when~='today'] .st-rel {
      display: none;
    }
    [data-when~='tomorrow'] .st-rel {
      color: var(--color-text);
    }
    .st-lamp {
      width: 0.45em;
      height: 0.45em;
      background: currentColor;
    }
    @media (prefers-reduced-motion: no-preference) {
      .st-lamp {
        animation: v1-lamp 2.4s steps(1, end) infinite;
      }
    }

    /* ---------- the board: today, lit amber on black in both themes ---------- */
    .board {
      --color-bg-subtle: var(--v1-board-hover);
      --color-border: var(--v1-board-rule);
      --color-text: var(--v1-board-lit);
      --color-text-muted: var(--v1-board-dim);
      --v1-title: var(--v1-board-bright);
      --v1-accent-text: var(--v1-board-bright);
      --v1-focus: var(--v1-board-bright);
      margin-inline: calc(-1 * var(--hang));
      padding: 1rem var(--hang) 0.5rem;
      background: var(--v1-board-bg);
      color: var(--v1-board-lit);
      box-shadow: inset 0 0 0 1px var(--v1-board-edge);
    }
    .board:not(:has([data-when~='now'], [data-when~='today'])) {
      display: none;
    }

    /* ---------- section and board headings: one size, one rhythm ---------- */
    .board-head,
    .sect-head {
      font-family: var(--v1-display);
      font-size: 2.25rem;
      font-weight: 800;
      line-height: 1;
      letter-spacing: 0.01em;
    }
    .board-head {
      padding-bottom: 0.5rem;
      color: var(--v1-board-lit);
    }
    .sect-head {
      padding: 0.75rem 0 0.5rem;
      border-top: 2px solid var(--v1-ink);
    }
    .month + .month {
      margin-top: 1rem;
    }
    .month-head {
      padding: 0.75rem 0 0.4rem;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--color-text-muted);
    }
    /* the first month sits right under its heading (or the column header, in the archive) */
    .sect-head + .month .month-head,
    .month:first-child .month-head {
      padding-top: 0.25rem;
    }

    /* ---------- empty state and end of board ---------- */
    .empty {
      padding-top: 1.5rem;
      border-top: 2px solid var(--v1-ink);
    }
    .empty p:first-child {
      font-family: var(--v1-display);
      font-size: 2rem;
      font-weight: 800;
      line-height: 1.05;
    }
    .empty-sub {
      margin-top: 0.5rem;
      color: var(--color-text-muted);
    }
    .tt-end {
      padding-top: 0.9rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
    }
    .tt-end a {
      color: var(--color-text-muted);
    }
    .tt-end a:hover {
      color: var(--color-text);
    }

    /* ---------- a narrower board: venue folds under the title ---------- */
    @container board (max-width: 60rem) {
      .cols {
        display: none;
      }
      .row {
        grid-template-columns: 17ch 0.55rem minmax(0, 1fr) auto;
        grid-template-areas: 'when topic main status';
        column-gap: 1.5ch;
      }
      .row .topic {
        align-self: start;
        align-items: center;
        height: calc(0.9375rem * 1.45);
      }
      .topic-name {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      .main {
        display: block;
        grid-area: main;
        min-width: 0;
      }
      .title {
        display: block;
      }
      .org,
      .venue {
        display: inline;
        font-size: 0.8125rem;
        color: var(--color-text-muted);
      }
      .venue::before {
        content: ' @ ';
        white-space: pre;
      }
      .town {
        display: inline;
      }
      .town::before {
        content: ', ';
      }
      .town .sr {
        display: none;
      }
    }

    /*
     * Phone-width board: the topic dot marks the row on its first line (date, time,
     * status); title and organizer line up under the date.
     */
    @container board (max-width: 38rem) {
      .row {
        grid-template-columns: 0.55rem minmax(0, 1fr) auto;
        grid-template-areas:
          'topic when status'
          '. main main';
        column-gap: 1.25ch;
        row-gap: 0.2rem;
      }
      .row .when {
        grid-template-columns: auto auto;
        justify-content: start;
        font-size: 0.875rem;
        color: var(--color-text-muted);
      }
      .row .topic {
        height: calc(0.875rem * 1.45);
      }
      .row .when-time {
        color: var(--color-text);
        font-weight: 700;
      }
      .row .when-time.tba {
        color: var(--color-text-muted);
        font-weight: 400;
      }
    }

    /* ---------- phones: the page's own gutter ---------- */
    @media (max-width: 40rem) {
      --gap: 2rem;

      .tt-title {
        margin-bottom: 1.5rem;
      }
      .tt-tools {
        gap: 0.25rem 2ch;
        font-size: 0.8125rem;
      }
      /* the board runs edge to edge */
      .board {
        margin-inline: -1rem;
        padding-inline: 1rem;
      }
      .board-head,
      .sect-head {
        font-size: 2rem;
      }
    }
  }

  @keyframes v1-lamp {
    50% {
      opacity: 0.25;
    }
  }
</style>
