---
// An event as a ticket: board-style fields (When, Status, Where, Organizer) on the
// left, the sign-up and calendar links on a perforated stub to the right.
import { formatLong, type ADEvent } from '@lib/event'
import {
  editUrl,
  eventAttrs,
  googleCalendarUrl,
  icsFileName,
  icsHref,
  linkHost,
  mapUrl,
  timeRange,
  topicColor,
  topicName,
} from '../shared'
import { machineDate } from './format'
import Status from './Status.astro'

interface Props {
  event: ADEvent
}

const { event } = Astro.props
const { title, subtitle, venue, learnMoreURL } = event.data
const when = formatLong(event)
const time = timeRange(event)
const map = mapUrl(event)
const host = linkHost(learnMoreURL)
const organizer = event.organizer
---

<article class="ev" {...eventAttrs(event)}>
  <a class="ev-back" href={`/${event.topic}`}>
    <span class="dot" style={`--dot: ${topicColor(event.topic)}`} aria-hidden="true"></span>
    All {topicName(event.topic)} events
  </a>

  <header class="ev-head">
    <h1 class="ev-title">{title}</h1>
    {subtitle && <p class="ev-sub">{subtitle}</p>}
  </header>

  <p class="ev-ended">This event has ended.</p>

  <div class="ticket">
    <dl class="fields">
      <div class="field f-when">
        <dt>When</dt>
        <dd>
          <time class="f-date" datetime={machineDate(event)}>{when.date}</time>
          <span class:list={['f-time', { tba: !time }]}>{time || 'Time TBA'}</span>
        </dd>
      </div>
      <div class="field f-status">
        <dt>Status</dt>
        <dd><Status event={event} class="status-lg" /></dd>
      </div>
      <div class="field f-where">
        <dt>Where</dt>
        <dd>
          {
            venue ? (
              <>
                <span class="f-venue">{venue.title}</span>
                <a class="f-map" href={map}>
                  {venue.address}
                  <span class="f-map-hint">map</span>
                </a>
              </>
            ) : (
              <>
                <span class="f-venue tba">Venue TBA</span>
                <span class="f-note">Not announced yet</span>
              </>
            )
          }
        </dd>
      </div>
      <div class="field f-org">
        <dt>Organizer</dt>
        <dd>
          <a class="f-venue" href={`/organizer/${organizer.id}`}>{organizer.data.name}</a>
        </dd>
      </div>
    </dl>

    <div class="stub">
      <a class="btn" href={learnMoreURL}>
        <span class="btn-live">Sign up on {host}&nbsp;→</span>
        <span class="btn-past">Event page on {host}&nbsp;→</span>
      </a>
      <p class="stub-note">{organizer.data.name} runs this event; aarhus.dev lists it.</p>
      <ul class="stub-links">
        <li><a href={icsHref(event)} download={icsFileName(event)}>Add to calendar (.ics)</a></li>
        <li><a href={googleCalendarUrl(event)}>Google Calendar</a></li>
      </ul>
    </div>
  </div>

  <div class="prose ev-body">
    <slot />
  </div>

  <p class="ev-edit">
    Something wrong or missing? <a href={editUrl(event)}>Edit on GitHub</a>
  </p>
</article>

<style is:global>
  [data-variant-block='v1'] {
    .ev {
      max-width: 60rem;
    }
    .ev-back {
      display: inline-flex;
      align-items: center;
      gap: 1ch;
      font-size: 0.8125rem;
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .ev-back:hover {
      text-decoration: underline;
    }
    .ev-head {
      margin-top: 1rem;
    }
    .ev-title {
      max-width: 22ch;
      font-family: var(--v1-display);
      font-size: clamp(2.75rem, 7.5vw, 5rem);
      font-weight: 800;
      line-height: 0.92;
      letter-spacing: 0.005em;
      text-wrap: balance;
      color: var(--v1-title);
    }
    .ev-sub {
      margin-top: 0.75rem;
      font-size: 1.0625rem;
      color: var(--color-text-muted);
    }

    .ev-ended {
      display: none;
      margin-top: 1.5rem;
      padding: 0.6rem 0.9rem;
      border: 1px solid var(--color-border);
      background: var(--color-bg-subtle);
      font-weight: 700;
    }
    .ev[data-when~='past'] .ev-ended {
      display: block;
    }

    /* ---------- the ticket ---------- */
    .ticket {
      --notch: 0.75rem;
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) 19rem;
      margin-top: 2rem;
      background: var(--v1-ticket-bg);
      border: 1.5px solid var(--v1-ticket-edge);
    }
    .fields {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
    .field {
      padding: 1rem 1.25rem 1.15rem;
      min-width: 0;
    }
    .field:nth-child(odd) {
      border-right: 1px solid var(--color-border);
    }
    .field:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
    .field dt {
      margin-bottom: 0.4rem;
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .field dd {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.2rem;
    }
    .f-date {
      font-weight: 700;
      color: var(--v1-title);
    }
    .f-time {
      font-size: 1.75rem;
      font-weight: 800;
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: var(--v1-title);
    }
    .f-time.tba,
    .f-venue.tba {
      color: var(--color-text-muted);
    }
    .f-time.tba {
      font-size: 1.25rem;
    }
    .f-venue {
      font-weight: 700;
      color: var(--v1-title);
    }
    a.f-venue {
      text-decoration: underline;
    }
    .f-map {
      font-size: 0.875rem;
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .f-map:hover {
      color: var(--v1-accent-text);
    }
    .f-map-hint {
      margin-left: 1ch;
      padding: 0 0.5ch;
      border: 1px solid currentColor;
      font-size: 0.75rem;
      white-space: nowrap;
    }
    .f-note {
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }
    .status-lg {
      font-size: 1.25rem;
      line-height: 1.3;
      letter-spacing: 0.05em;
    }
    .f-status .status {
      color: var(--v1-title);
    }
    .ev[data-when~='past'] .st-ended {
      display: inline;
      margin-right: 1ch;
    }
    .ev[data-when~='past'] .f-status .st-rel {
      font-size: 0.8125rem;
      color: var(--color-text-muted);
    }

    /* ---------- the stub, behind a perforation ---------- */
    .stub {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
      padding: 1.25rem;
      border-left: 2px dashed var(--color-border);
    }
    .stub::before,
    .stub::after {
      content: '';
      position: absolute;
      left: calc(-1 * var(--notch) - 1px);
      width: calc(2 * var(--notch));
      height: calc(2 * var(--notch));
      border-radius: 50%;
      background: var(--color-bg);
      border: 1.5px solid var(--v1-ticket-edge);
    }
    .stub::before {
      top: calc(-1 * var(--notch) - 1.5px);
      clip-path: inset(50% 0 0 0);
    }
    .stub::after {
      bottom: calc(-1 * var(--notch) - 1.5px);
      clip-path: inset(0 0 50% 0);
    }
    .btn {
      display: block;
      padding: 0.85rem 1rem;
      background: var(--v1-accent);
      color: #17140f;
      font-weight: 800;
      text-decoration: none;
      box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.18);
    }
    .btn:hover {
      color: #17140f;
      background: #ffb53d;
    }
    .btn-past {
      display: none;
    }
    .ev[data-when~='past'] .btn {
      background: transparent;
      color: var(--color-text);
      box-shadow: inset 0 0 0 1.5px var(--color-border);
    }
    .ev[data-when~='past'] .btn-live {
      display: none;
    }
    .ev[data-when~='past'] .btn-past {
      display: inline;
    }
    .stub-note {
      font-size: 0.75rem;
      line-height: 1.5;
      color: var(--color-text-muted);
    }
    .stub-links {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      margin-top: auto;
      padding-top: 0.75rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.875rem;
    }

    .ev-body {
      margin-top: 2.75rem;
    }
    .ev-edit {
      max-width: 68ch;
      margin-top: 3rem;
      padding-top: 0.9rem;
      border-top: 1px solid var(--color-border);
      font-size: 0.8125rem;
      color: var(--color-text-muted);
    }

    /* ---------- tablets: stub below ---------- */
    @media (max-width: 48rem) {
      .ticket {
        grid-template-columns: minmax(0, 1fr);
      }
      .stub {
        border-left: 0;
        border-top: 2px dashed var(--color-border);
      }
      .stub::before,
      .stub::after {
        top: calc(-1 * var(--notch) - 1px);
        bottom: auto;
      }
      .stub::before {
        left: calc(-1 * var(--notch) - 1.5px);
        clip-path: inset(0 0 0 50%);
      }
      .stub::after {
        left: auto;
        right: calc(-1 * var(--notch) - 1.5px);
        clip-path: inset(0 50% 0 0);
      }
    }

    /* ---------- phones: one field per line ---------- */
    @media (max-width: 30rem) {
      .fields {
        grid-template-columns: minmax(0, 1fr);
      }
      .field {
        padding: 0.85rem 1rem;
      }
      .field:nth-child(odd) {
        border-right: 0;
      }
      .field:nth-child(n + 2) {
        border-top: 1px solid var(--color-border);
      }
      .stub {
        padding: 1rem;
      }
      .ev-title {
        font-size: 2.75rem;
      }
    }
  }
</style>
