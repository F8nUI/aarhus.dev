---
// Departure Board: a printed timetable in light mode, the lit board itself in dark.
// Header with a live Aarhus clock (it follows the overlay's "now"), the topic
// strip, the page, and a footer.
import { calendarFeed, topicColor, topicName } from '../shared'

interface Props {
  topic?: string
  topics: string[]
}

const { topic, topics } = Astro.props
const sorted = [...topics].sort((a, b) => topicName(a).localeCompare(topicName(b)))
// "All topics" is the current line only on the all-topic lists (home and /past), not on text pages.
const onAllList = !topic && /^\/(past\/?)?$/.test(Astro.url.pathname)
---

<div class="v1">
  <header class="head">
    <div class="bar">
      <a class="mark" href="/">aarhus.dev</a>
      <span class="tagline">tech meetups in Aarhus</span>
      <time class="clock" data-v1-clock hidden title="Time in Aarhus">
        <span class="clock-day" data-v1-day></span>
        <span class="clock-hm" data-v1-hm></span>
      </time>
      <button class="theme-toggle toggle" type="button" aria-label="Switch between light and dark">
        <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
          <circle cx="12" cy="12" r="4.5"></circle>
          <path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"></path>
        </svg>
        <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
    <nav class="lines" aria-label="Topics">
      <a href="/" aria-current={onAllList ? 'true' : undefined}>All topics</a>
      {
        sorted.map((t) => (
          <a href={`/${t}`} aria-current={t === topic ? 'true' : undefined}>
            <span class="dot" style={`--dot: ${topicColor(t)}`} aria-hidden="true" />
            {topicName(t)}
          </a>
        ))
      }
    </nav>
  </header>

  <main class="page">
    <slot />
  </main>

  <footer class="foot">
    <p class="foot-about">
      <a class="mark" href="/">aarhus.dev</a> is a community timetable of tech events in Aarhus, Denmark.
    </p>
    <nav class="foot-links" aria-label="Site">
      <a href="/about">About</a>
      <a href="/add-event">Add event</a>
      <a href="https://github.com/f8nui/aarhus.dev">GitHub</a>
      <a href={calendarFeed.webcal}>Subscribe</a>
    </nav>
  </footer>
</div>

<script is:inline>
  // The board clock: Aarhus time, from the same clock the event states use.
  ;(function () {
    var block = document.currentScript.closest('[data-variant-block="v1"]')
    var clock = block && block.querySelector('[data-v1-clock]')
    if (!clock) return
    var tick = function () {
      var now = new Date(window.aarhusNow ? window.aarhusNow() : Date.now())
      var part = function (options) {
        return now.toLocaleString('en-GB', Object.assign({ timeZone: 'Europe/Copenhagen' }, options))
      }
      clock.querySelector('[data-v1-day]').textContent = part({ weekday: 'short', day: 'numeric', month: 'short' }).replace(',', '')
      clock.querySelector('[data-v1-hm]').textContent = part({ hour: '2-digit', minute: '2-digit', hourCycle: 'h23' })
      clock.setAttribute('datetime', now.toISOString())
      clock.hidden = false
    }
    tick()
    setInterval(tick, 15000)
  })()
</script>

<style is:global>
  /* ---------- tokens ---------- */
  :root[data-variant='v1'] {
    color-scheme: light;
    /* paper timetable */
    --color-bg: #fbfbf8;
    --color-bg-subtle: #f1f0ea;
    --color-text: #17140f;
    --color-text-muted: #67625a;
    --color-border: #dcd8ce;
    --v1-ink: #17140f;
    --v1-title: #17140f;
    --v1-prose: #17140f;
    --v1-accent: #f5a524;
    --v1-accent-text: #a64f00;
    --v1-focus: #c25e00;
    --v1-ticket-bg: #ffffff;
    --v1-ticket-edge: #17140f;
    /* the board: lit amber on black, in both themes */
    --v1-board-bg: #15110a;
    --v1-board-edge: #15110a;
    --v1-board-rule: #30271a;
    --v1-board-hover: #201a10;
    --v1-board-lit: #f5a524;
    --v1-board-bright: #ffc65e;
    --v1-board-dim: #b3832f;
    --v1-display: 'Big Shoulders', 'Arial Narrow', sans-serif;
  }
  :root[data-variant='v1'][data-theme='dark'] {
    color-scheme: dark;
    --color-bg: #0d0b07;
    --color-bg-subtle: #19150d;
    --color-text: #f5a524;
    --color-text-muted: #b07f2e;
    --color-border: #2c2416;
    --v1-ink: #f5a524;
    --v1-title: #ffc65e;
    --v1-prose: #edd4a2;
    --v1-accent-text: #ffc65e;
    --v1-focus: #ffd27f;
    --v1-ticket-bg: #15110a;
    --v1-ticket-edge: #5a4520;
    --v1-board-bg: #17120a;
    --v1-board-edge: #4a391b;
  }
  @media (prefers-color-scheme: dark) {
    :root[data-variant='v1']:not([data-theme='light']) {
      color-scheme: dark;
      --color-bg: #0d0b07;
      --color-bg-subtle: #19150d;
      --color-text: #f5a524;
      --color-text-muted: #b07f2e;
      --color-border: #2c2416;
      --v1-ink: #f5a524;
      --v1-title: #ffc65e;
      --v1-prose: #edd4a2;
      --v1-accent-text: #ffc65e;
      --v1-focus: #ffd27f;
      --v1-ticket-bg: #15110a;
      --v1-ticket-edge: #5a4520;
      --v1-board-bg: #17120a;
      --v1-board-edge: #4a391b;
    }
  }

  [data-variant-block='v1'] {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.9375rem;
    line-height: 1.5;

    .v1 {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      max-width: 74rem;
      margin-inline: auto;
      padding-inline: 2rem;
      overflow-x: clip;
    }

    a {
      color: inherit;
      text-underline-offset: 3px;
      text-decoration-thickness: 1px;
    }
    a:hover {
      color: var(--v1-accent-text);
    }
    a:focus-visible,
    button:focus-visible {
      outline: 2px solid var(--v1-focus);
      outline-offset: 2px;
    }
    .sr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    /* ---------- header ---------- */
    .head {
      padding-top: 1.25rem;
      border-bottom: 2px solid var(--v1-ink);
    }
    .bar {
      display: flex;
      align-items: baseline;
      gap: 0.5rem 1.5ch;
    }
    .mark {
      font-weight: 800;
      font-size: 1.125rem;
      letter-spacing: -0.01em;
      text-decoration: none;
    }
    .tagline {
      color: var(--color-text-muted);
      font-size: 0.875rem;
    }
    .clock {
      display: inline-flex;
      align-items: baseline;
      gap: 1.5ch;
      margin-left: auto;
      font-size: 0.875rem;
      color: var(--color-text-muted);
    }
    .clock[hidden] {
      display: none;
    }
    .clock-hm {
      font-size: 1.375rem;
      font-weight: 800;
      line-height: 1;
      color: var(--color-text);
    }
    .toggle {
      align-self: center;
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      margin-right: -0.4rem;
      color: var(--color-text-muted);
      cursor: pointer;
    }
    .clock[hidden] + .toggle {
      margin-left: auto;
    }
    .toggle:hover {
      color: var(--color-text);
    }

    .lines {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.5rem;
      margin: 1rem -0.5rem 0.75rem;
      font-size: 0.8125rem;
    }
    .lines a {
      display: inline-flex;
      align-items: center;
      gap: 0.75ch;
      padding: 0.2rem 0.5rem;
      color: var(--color-text-muted);
      text-decoration: none;
    }
    .lines a:hover {
      color: var(--color-text);
      background: var(--color-bg-subtle);
    }
    .lines a[aria-current] {
      background: var(--v1-ink);
      color: var(--color-bg);
      font-weight: 700;
    }
    .lines a[aria-current] .dot {
      box-shadow: 0 0 0 2px var(--color-bg);
    }
    .dot {
      flex: none;
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 50%;
      background: var(--dot);
    }

    /* ---------- page ---------- */
    .page {
      flex: 1;
      padding-block: 1.75rem 4rem;
    }

    /* ---------- footer ---------- */
    .foot {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.75rem 2rem;
      padding-block: 1.25rem 2rem;
      border-top: 2px solid var(--v1-ink);
      font-size: 0.8125rem;
      color: var(--color-text-muted);
    }
    .foot .mark {
      font-size: inherit;
      color: var(--color-text);
    }
    .foot-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1.75ch;
    }
    .foot-links a {
      color: var(--color-text);
    }
    .foot-links a:hover {
      color: var(--v1-accent-text);
    }

    /* ---------- text pages: about, add event, organizers ---------- */
    .v-page {
      max-width: 68ch;
    }
    .v-page-header {
      margin-bottom: 2.25rem;
    }
    .v-page-header h1 {
      font-family: var(--v1-display);
      font-size: clamp(2.75rem, 7vw, 4.25rem);
      font-weight: 800;
      line-height: 0.95;
      letter-spacing: 0.005em;
      text-wrap: balance;
      color: var(--v1-title);
    }
    .v-page-description {
      margin-top: 0.75rem;
      font-size: 1rem;
      color: var(--color-text-muted);
    }
    .v-page-website {
      display: inline-block;
      margin-top: 0.75rem;
      color: var(--v1-accent-text);
    }

    /* ---------- prose: page bodies and event descriptions ---------- */
    .prose {
      max-width: 68ch;
      font-size: 0.9375rem;
      line-height: 1.7;
      color: var(--v1-prose);

      > * + * {
        margin-top: 0.9rem;
      }
      p {
        margin-bottom: 0;
      }
      h1,
      h2 {
        margin: 2.5rem 0 0.75rem;
        padding-top: 0.5rem;
        border-top: 2px solid var(--v1-ink);
        font-family: var(--v1-display);
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
        color: var(--v1-title);
      }
      h3 {
        margin: 1.75rem 0 0.5rem;
        font-size: 0.9375rem;
        font-weight: 800;
        color: var(--v1-title);
      }
      > :first-child {
        margin-top: 0;
      }
      strong {
        font-weight: 700;
        color: var(--v1-title);
      }
      a {
        color: var(--v1-accent-text);
        text-decoration-line: underline;
      }
      a:hover {
        color: var(--color-text);
      }
      ul,
      ol {
        padding-left: 3ch;
        margin-bottom: 0;
      }
      ol {
        padding-left: 4.5ch;
      }
      ul {
        list-style: none;
      }
      ul > li {
        position: relative;
      }
      ul > li::before {
        content: '';
        position: absolute;
        left: -2.25ch;
        top: 0.7em;
        width: 1.25ch;
        height: 2px;
        background: var(--v1-accent);
      }
      ol {
        list-style: decimal-leading-zero;
      }
      ol > li::marker {
        color: var(--color-text-muted);
        font-weight: 700;
      }
      li + li {
        margin-top: 0.35rem;
      }
      code {
        padding: 0.1em 0.4ch;
        font-size: 0.875em;
        border-radius: 0;
        background: var(--color-bg-subtle);
        color: var(--color-text);
      }
      /* Code sits on the board's black in both themes; the highlighter's colors are made for a dark ground. */
      pre {
        padding: 1rem 1.25rem;
        margin-bottom: 0;
        overflow-x: auto;
        border-radius: 0;
        border-left: 3px solid var(--v1-accent);
        background-color: var(--v1-board-bg) !important;
        color: #f3e3c3;
        font-size: 0.8125rem;
        line-height: 1.6;
      }
      pre code {
        padding: 0;
        background: transparent;
      }
      blockquote {
        padding-left: 2ch;
        border-left: 2px solid var(--color-border);
        color: var(--color-text-muted);
      }
      hr {
        border: 0;
        border-top: 1px solid var(--color-border);
      }
    }

    /* ---------- phones ---------- */
    @media (max-width: 40rem) {
      .v1 {
        padding-inline: 1rem;
      }
      .tagline {
        display: none;
      }
      .clock-day {
        display: none;
      }
      .lines {
        margin-top: 0.75rem;
      }
      .page {
        padding-top: 1.25rem;
      }
    }
  }
</style>
